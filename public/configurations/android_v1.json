{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "^/(en|fr)/booster$",
        "^/(en|fr)/trades/new$",
        "^/(en|fr)/trades/[^/]+/counter$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
