{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true,
        "query_string_presentation": "replace"
      }
    },
    {
      "patterns": [
        "^/(en|fr)/booster/?$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/(en|fr)/me/sheets/",
        "^/(en|fr)/feed/types",
        "^/(en|fr)/cards/[^/]+/seasons/\\d+/holders"
      ],
      "properties": {
        "context": "modal",
        "modal_style": "large",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
