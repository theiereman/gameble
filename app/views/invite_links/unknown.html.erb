<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<%# An invite link that names nobody, or a banned player. %>
<section class="friends invite-link" aria-labelledby="invite-link-heading">
  <h1 id="invite-link-heading" class="friends__title"><%= t(".title") %></h1>
  <%= render PanelComponent.new(tag: :p, class: "friends__empty") do %><%= t(".text") %><% end %>
</section>
