<% name = friend_name(@owner) %>
<% content_for :title, t(".title", name:) %>
<% content_for :screen_title, t(".heading") %>
<section class="friends invite-link" aria-labelledby="invite-link-heading">
  <h1 id="invite-link-heading" class="friends__title"><%= t(".heading") %></h1>
  <%= render PanelComponent.new(brackets: true, class: "friends__panel") do %>
    <p class="invite-link__line"><%= t(".invites_you", name:) %></p>
    <% if current_player.nil? %>
      <p class="friends__label"><%= t(".sign_in_text") %></p>
      <%= sign_in_button t(".sign_in"), origin: request.path, class: "button button--primary" %>
    <% elsif current_player.id == @owner.id %>
      <p class="friends__label"><%= t(".send_text", name:) %></p>
      <p class="friends__message friends__message--error"><%= t(".own_link") %></p>
      <%= render ButtonComponent.new(variant: :secondary, href: friends_path, size: :small) do %><%= t(".to_friends") %><% end %>
    <% elsif @relation == :friends %>
      <p class="friends__message"><%= t(".already_friends", name:) %></p>
      <%= render ButtonComponent.new(variant: :secondary, href: friends_path, size: :small) do %><%= t(".to_friends") %><% end %>
    <% elsif @relation == :invited %>
      <p class="friends__message"><%= t(".already_invited", name:) %></p>
      <%= render ButtonComponent.new(variant: :secondary, href: friends_path, size: :small) do %><%= t(".to_friends") %><% end %>
    <% else %>
      <p class="friends__label"><%= t(".send_text", name:) %></p>
      <%= tag.div data: { controller: "auto-submit" } do %>
        <%= render ButtonComponent.new(href: request.path, method: :post) do %><%= t(".send") %><% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
