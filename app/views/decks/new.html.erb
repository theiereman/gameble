<% content_for :title, t("decks.editor.title") %>
<% content_for :screen_title, t("decks.editor.title") %>
<% content_for :back_button, true %>
<% content_for :phone_back do %>
  <%= phone_back_link t("shell.tabs.duels"), duels_path %>
<% end %>
<% if @editor %>
  <%= render "decks/editor", editor: @editor %>
<% else %>
  <section class="deck-editor" aria-labelledby="deck-editor-heading">
    <h1 id="deck-editor-heading" class="visually-hidden"><%= t("decks.editor.title") %></h1>
    <p class="deck-editor__notice"><%= Game::CreateDeck.failure_message(:too_many_decks) %></p>
  </section>
<% end %>
