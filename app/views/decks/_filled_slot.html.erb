<%# locals: (entry:) %>
<span class="deck-slot__filled">
  <%= tag.button type: "button", class: "deck-slot", data: { action: "deck-slots#remove" },
        aria: { label: (deck_slot_label(entry) if entry) } do %>
    <%= tag.img class: "deck-slot__art", src: entry&.image_url, alt: "", loading: "lazy", width: 92, height: 43 %>
    <span class="deck-slot__name"><%= entry&.title %></span>
  <% end %>
  <span class="deck-slot__moves" aria-hidden="true"><%= deck_moves_text(entry) %></span>
</span>
