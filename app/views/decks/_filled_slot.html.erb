<%# locals: (entry:) %>
<span class="deck-slot__filled">
  <%= tag.button type: "button", class: "deck-slot", aria: { expanded: "false" },
        data: { action: "pointerdown->deck-slots#press click->deck-slots#toggle" } do %>
    <span class="deck-slot__card"><%= render("decks/card", entry:) if entry %></span>
  <% end %>
  <span class="deck-slot__actions" hidden>
    <% opener = bottom_sheet_opener("deck-card-info") %>
    <%= tag.a t("decks.editor.info.open"), **opener.merge(data: opener[:data].merge(action: "deck-slots#fillInfo")), class: "deck-slot__info" %>
    <%= tag.button t("decks.editor.strings.remove"), type: "button", class: "deck-slot__remove",
          aria: { label: (deck_slot_label(entry) if entry) }, data: { action: "deck-slots#remove" } %>
  </span>
  <span class="deck-slot__moves" aria-hidden="true"><%= deck_moves_text(entry) %></span>
</span>
