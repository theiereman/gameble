<%# locals: (bars:, called: [], direction: nil, spent: []) %>
<ul class="stat-bars" aria-hidden="true">
  <% bars.each do |bar| %>
    <%= tag.li class: class_names("stat-bars__row", "stat-bars__row--trump": bar.trump), data: { tier: bar.tier, stat: bar.stat, called: (true if called.include?(bar.stat)), direction: (direction if called.include?(bar.stat)), spent: (true if spent.include?(bar.stat)) } do %>
      <span class="stat-bars__name"><%= t("duel_stats.short.#{bar.stat}") %></span>
      <%= tag.progress class: "stat-bars__bar", max: 100, value: bar.value %>
      <span class="stat-bars__value"><%= bar.value %></span>
    <% end %>
  <% end %>
</ul>
