<%# locals: (entry:) %>
<% bars = deck_entry_bars(entry) %>
<span class="deck-card" data-url="<%= card_season_path(slug: entry.card.id, number: entry.card.season_number) %>" data-title="<%= entry.title %>">
  <%= render CardComponent.new(card: entry.card, size: :grid, tilt: false) %>
  <span class="deck-card__overlay">
    <% if bars.any? %>
      <%= render "decks/stat_bars", bars: %>
    <% else %>
      <span class="deck-card__detail"><%= deck_entry_detail(entry) %></span>
    <% end %>
  </span>
</span>
