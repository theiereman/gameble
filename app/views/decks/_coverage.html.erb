<%# locals: (coverage:) %>
<section class="deck-coverage" aria-labelledby="deck-coverage-heading" data-controller="deck-coverage">
  <h2 id="deck-coverage-heading" class="deck-coverage__heading">
    <%= t("decks.editor.coverage.heading") %> · <span data-deck-coverage-target="count"><%= coverage.calls.count(&:gap?) %></span>
  </h2>
  <ul class="deck-coverage__cells">
    <% coverage.calls.each do |call| %>
      <% label = deck_call_label(call) %>
      <%= tag.li class: "deck-coverage__cell", hidden: !call.gap?, data: { deck_coverage_target: "cell", call: call.key } do %>
        <%= tag.button type: "button", class: "deck-coverage__gap", aria: { label: t("decks.editor.coverage.gap_label", call: label) },
              data: { action: "deck-coverage#choose" } do %>
          <span class="deck-coverage__name"><%= deck_call_short(call) %></span>
          <span class="deck-coverage__best" aria-hidden="true" data-deck-coverage-target="best"><%= call.shown %></span>
        <% end %>
      <% end %>
    <% end %>
  </ul>
  <%= tag.p t("decks.editor.coverage.none"), class: "deck-coverage__none", hidden: coverage.calls.any?(&:gap?), data: { deck_coverage_target: "none" } %>
</section>
