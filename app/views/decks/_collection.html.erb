<%# locals: (editor:) %>
<section class="deck-collection" aria-labelledby="deck-collection-heading" data-controller="deck-collection">
  <div class="deck-recommendations" hidden data-deck-collection-target="recommendations">
    <h2 class="deck-collection__heading"><%= t("decks.editor.recommendations") %></h2>
    <ul class="deck-collection__list" data-deck-collection-target="recommended"></ul>
  </div>
  <h2 id="deck-collection-heading" class="deck-collection__heading"><%= t("decks.editor.collection") %> · <%= editor.entries.size %></h2>
  <% if editor.entries.empty? %>
    <p class="deck-collection__empty"><%= t("decks.editor.empty_collection") %></p>
  <% else %>
    <div class="deck-collection__tools">
      <%= search_field_tag :q, nil, id: "deck-search", class: "deck-collection__search", autocomplete: "off", spellcheck: false,
            placeholder: t("decks.editor.search.placeholder"), aria: { label: t("decks.editor.search.label") },
            data: { action: "input->deck-collection#search" } %>
      <fieldset class="deck-collection__trumps">
        <legend class="visually-hidden"><%= t("decks.editor.trump_filter.label") %></legend>
        <% deck_trump_options.each do |label, value| %>
          <label class="filter-chip">
            <%= radio_button_tag "trump", value, value == "all", id: nil, class: "filter-chip__box",
                  data: { deck_collection_target: "trump", action: "change->deck-collection#filter" } %>
            <span class="filter-chip__text"><%= label %></span>
          </label>
        <% end %>
      </fieldset>
      <%= render SortComponent.new(prefix: t("decks.editor.sort.prefix"), label: t("decks.editor.sort.label"), options: deck_sort_links,
            link_data: { deck_collection_target: "sortOption", action: "deck-collection#sort" }) %>
    </div>
    <ul class="deck-collection__list" data-deck-collection-target="list" data-action="keydown->deck-collection#keydown">
      <%= render partial: "decks/entry", collection: editor.entries, as: :entry, locals: { editor: editor } %>
    </ul>
    <p class="deck-collection__empty" hidden data-deck-collection-target="empty"><%= t("decks.editor.no_match") %></p>
    <div class="deck-collection__more" data-deck-collection-target="more" data-action="click->deck-collection#more">
      <%= render ButtonComponent.new(variant: :link) do %><%= t("decks.editor.more") %><% end %>
    </div>
  <% end %>
</section>
