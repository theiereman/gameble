<%# locals: (row:) %>
<%= tag.li class: class_names("register-row", "register-row--privileged": row.privileged, "register-row--own": row.player == current_player) do %>
  <span class="register-row__rank"><%= number_with_delimiter(row.rank) %></span>
  <%= pixel_icon("avatar-default", class: "register-row__avatar") %>
  <span class="register-row__who">
    <% if fortune_row_named?(row) %>
      <%= link_to public_profile_title(row.player), brother_path(token: row.player.token), class: "register-row__name" %>
    <% else %>
      <span class="register-row__name register-row__name--hidden"><%= t("fortune_registers.show.hidden_player") %></span>
    <% end %>
    <span class="register-row__label"><%= fortune_label_title(row.index) %></span>
  </span>
  <% if row.privileged %><span class="fortune__privileged"><%= t("fortunes.privileged") %></span><% end %>
  <span class="<%= class_names("register-row__index", "fortune-index", fortune_index_tone(row.index)) %>"><%= fortune_index_text(row.index) %></span>
<% end %>
