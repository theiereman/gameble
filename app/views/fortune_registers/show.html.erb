<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% if current_player %>
  <% content_for :phone_back do %>
    <%= link_to more_path, class: "button button--secondary button--small top-bar__phone-back" do %>
      <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= t(".more") %></span>
    <% end %>
  <% end %>
<% end %>
<% period_param = (FortunePeriod::ALL_TIME if @period == :all_time) %>
<% sort_param = ("capsules" if @sort == :capsules) %>
<section class="register" aria-labelledby="register-heading">
  <h1 id="register-heading" class="register__title"><%= t(".title") %></h1>
  <p class="register__intro"><%= t(".intro") %></p>
  <%= render PanelComponent.new(tag: :dl, class: "register__summary") do %>
    <%= render "public_profiles/figure", label: t(".summary.members.#{@period}"), value: @summary.ranked_count %>
    <%= render "public_profiles/figure", label: t(".summary.capsules.#{@period}"), value: @summary.packs_opened %>
    <%= render "public_profiles/figure", label: t(".summary.privileged"), value: @summary.privileged_count, total: @summary.active_count %>
    <% if @mine&.opened? %>
      <div class="profile-figure register__mine">
        <dt class="profile-figure__label"><%= t(".summary.you") %></dt>
        <dd class="<%= class_names("profile-figure__value", "fortune-index", fortune_index_tone(@mine.index)) %>">
          <%= fortune_index_text(@mine.index) %><span class="profile-figure__total"><%= t(".summary.rank", rank: number_with_delimiter(@mine.rank)) %></span>
        </dd>
      </div>
    <% end %>
  <% end %>
  <div class="register__controls">
    <nav class="register__tabs" aria-label="<%= t("fortunes.periods_label") %>">
      <% Game::FortuneStanding::PERIODS.each do |period| %>
        <%= link_to fortune_register_path(period: (FortunePeriod::ALL_TIME if period == :all_time), sort: sort_param), class: "filter-chip",
              aria: { current: ("true" if period == @period) } do %>
          <span class="filter-chip__text"><%= t("fortunes.periods.#{period}") %></span>
        <% end %>
      <% end %>
    </nav>
    <nav class="register__tabs register__sorts" aria-label="<%= t(".sorts_label") %>">
      <% Game::FortuneBoard::SORTS.each do |sort| %>
        <%= link_to fortune_register_path(period: period_param, sort: ("capsules" if sort == :capsules)), class: "filter-chip",
              aria: { current: ("true" if sort == @sort) } do %>
          <span class="filter-chip__text"><%= t(".sorts.#{sort}") %></span>
        <% end %>
      <% end %>
    </nav>
  </div>
  <% if @rows.empty? %>
    <%= render PanelComponent.new(tag: :p, class: "register__empty") do %><%= t(".empty.#{@period}") %><% end %>
  <% else %>
    <ol class="register__rows">
      <%= render partial: "fortune_registers/row", collection: @rows, as: :row %>
    </ol>
    <% if @pagy.last > 1 %>
      <nav class="register__pages" aria-label="<%= t(".pages_label") %>"><%= @pagy.series_nav.html_safe %></nav>
    <% end %>
  <% end %>
</section>
