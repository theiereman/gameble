<%= turbo_stream.replace "daily-booster" do %>
  <% if @bank[:bonus_collectable] || @bank[:bonus_collected] %>
    <%= render "pages/daily_booster", bank: @bank, primary: false, arc: @collected %>
  <% end %>
<% end %>
<%= turbo_stream.replace "packs-chip", partial: "shell/packs_chip", locals: { bank: @bank, refresh: true } %>
<%= turbo_stream.replace "hub-menu-booster", partial: "pages/menu_booster", locals: { bank: @bank } %>
<%= turbo_stream.replace "hub-showcase-actions", partial: "pages/showcase_actions", locals: { bank: @bank } %>
<%= turbo_stream.append "toasts" do %><%= render ToastComponent.new(message: @message, tone: @tone) %><% end %>
