<% id = local_assigns.fetch(:id, "report-dialog") %>
<dialog id="<%= id %>" class="modal" aria-labelledby="<%= id %>-title" data-controller="dialog" data-action="click->dialog#closeOnScrim">
  <%= render PanelComponent.new(brackets: true, class: "modal__panel") do %>
    <span class="modal__handle" aria-hidden="true"></span>
    <div class="modal__head">
      <p id="<%= id %>-title" class="modal__title modal__title--alert"><%= t("reports.dialog.title") %></p>
      <button type="button" class="modal__close" aria-label="<%= t("reports.dialog.close") %>" data-action="dialog#close">
        <%= pixel_icon("close", class: "modal__close-icon") %>
      </button>
    </div>
    <%= form_with url: brother_report_path(token: owner.token), class: "report-dialog__form" do %>
      <%= hidden_field_tag :from, local_assigns[:from], id: nil if local_assigns[:from] %>
      <fieldset class="report-dialog__reasons">
        <legend class="report-dialog__legend"><%= t("reports.dialog.legend") %></legend>
        <% Accounts::Report.reasons.each_key do |reason| %>
          <label class="report-dialog__reason">
            <%= radio_button_tag "reason", reason, false, required: true, class: "report-dialog__radio", id: "#{id}-#{reason}" %>
            <span><%= t("reports.reasons.#{reason}") %></span>
          </label>
        <% end %>
      </fieldset>
      <p class="report-dialog__note"><%= t("reports.dialog.note") %></p>
      <%= render ButtonComponent.new(variant: :danger, type: :submit) do %><%= t("reports.dialog.submit") %><% end %>
    <% end %>
  <% end %>
</dialog>
