<ul class="card-detail__owners-list">
  <% owners.each do |owner| %>
    <li class="card-detail__owner">
      <%= link_to friend_name(owner.player), brother_path(token: owner.player.token), class: "card-detail__owner-name" %>
      <span class="card-detail__owner-copies"><%= t("card_details.owners.copies", count: owner.copies) %></span>
      <% if editions %>
        <span class="card-detail__owner-editions"><%= card_detail_edition_lines(owner.editions, strings).join(" · ") %></span>
      <% end %>
    </li>
  <% end %>
</ul>
