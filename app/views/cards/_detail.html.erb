<%# A card's detail, "FICHE DE LA CARTE" (CAP-7; DESIGN.md, Card detail;
    epic 10 R2, R6): a bracketed panel with the number at top right, the
    card at card-l over a ground shadow, its title, the facts the card does
    not carry and the actions ("Voir sur Steam", the
    one primary, and "Partager", "Reposter" and the showcase choice for a
    holder). ◀ ▶ beside the card step
    through what it browses (an opened pack, a grid, a set), and on a phone
    (sub_view controller) a swipe on it too, under a position line, with
    the actions pinned at the bottom. It names no one but the viewer (a
    shared card shows only the card). Locals:
    - detail: a Catalog::CardDetail::Detail;
    - copies: how many copies of its game the viewer holds, every edition
      counted, or nil;
    - editions: the editions of its game the viewer holds, as
      Game::HeldEditions answers them (default none);
    - signed_in: whether a player views it (default false): then the
      copies row reads their copies, or "None", and, when they hold one,
      the editions row reads one line per rarity, the best first, with its
      seasons ("Rare : S1, S4"), the lines past the third folded;
    - set_url: ->(set) { path } leading each set to its grid, or nil for
      the sets' names alone; the sets of a season other than the published
      one (the one the library shows) are never linked;
    - share_url: the absolute link to this card-season's page, to share,
      or nil (the default) for no share or repost button and no share sheet
      (cards/_share_sheet); the repost button shows only when this
      card-season is among the editions held, the one a repost posts;
    - browse: what it browses (a CardsController::Browse: the position,
      the total, the neighbours' paths, the way back), or nil (the
      default) for no ◀ ▶ and no position line;
    - faded: true to show the viewer's card back, faded, in place of the
      face, for a card of a game no edition of which they hold, within a
      context (default false);
    - back_key: the viewer's active card back (Game::CardBacks);
    - showcase: the viewer's profile showcase action on this card-season:
      :add, :remove, :full (the add button disabled, the showcase-full line
      beside it) or nil (the default) for none. %>
<% share_url = local_assigns.fetch(:share_url, nil) %>
<% set_url = detail.current_season ? local_assigns.fetch(:set_url, nil) : nil %>
<% browse = local_assigns.fetch(:browse, nil) %>
<% faded = local_assigns.fetch(:faded, false) %>
<% back_key = local_assigns.fetch(:back_key, Game::CardBacks::STANDARD) %>
<% signed_in = local_assigns.fetch(:signed_in, false) %>
<% editions = local_assigns.fetch(:editions, []) %>
<% showcase = local_assigns.fetch(:showcase, nil) %>
<% repostable = share_url && editions.any? { |_, season_number, _| season_number == detail.view.season_number } %>
<% view = detail.view %>
<% strings = CardStrings.new %>
<% tier = Catalog::Rarity::TIERS.invert.fetch(view.rarity.to_sym) %>
<% controllers = [ "sub-view", ("share" if share_url) ].compact.join(" ") %>
<% data = { controller: controllers, sub_view_title_value: card_preview_title(view) } %>
<% data[:sub_view_back_value] = browse.back.path if browse&.back %>
<% data.merge!(share_copied_value: t("card_details.share.copied"), share_manual_value: t("card_details.share.manual")) if share_url %>
<%= render PanelComponent.new(tag: :article, brackets: true, class: "card-detail", aria: { labelledby: "card-detail-heading" }, data:) do %>
  <header class="card-detail__header">
    <p class="card-detail__kicker"><%= t("card_details.kicker") %></p>
    <% if view.number %>
      <p class="card-detail__number"><%= view.number_label %></p>
    <% end %>
  </header>
  <div class="card-detail__layout">
    <div class="card-detail__columns">
      <%# The stage: the card between ◀ and ▶ (links replacing the frame and
          the URL; a disabled button at an end). A horizontal swipe on it
          presses them; a vertical drag scrolls the page. %>
      <div class="card-detail__stage" data-sub-view-target="stage"
        data-action="pointerdown->sub-view#press pointermove->sub-view#drag pointerup->sub-view#release pointercancel->sub-view#cancel">
        <% if browse %>
          <%= render "cards/detail_nav", path: browse.previous, side: :previous %>
        <% end %>
        <div class="card-detail__card">
          <% if faded %>
            <span class="card-detail__back">
              <%= card_back_image(back_key, class: "card-detail__back-image") %>
              <span class="card-detail__back-plate">
                <span class="card-detail__back-title" aria-hidden="true"><%= view.title %></span>
                <span class="card-detail__back-line">
                  <span class="card-detail__back-year" aria-hidden="true"><%= view.year %></span>
                  <span class="card-detail__not-owned"><%= t("card_details.not_owned") %></span>
                </span>
              </span>
            </span>
          <% else %>
            <% if card_top_rarity?(view.rarity) %>
              <div class="card-float">
                <%= card_rays(view.rarity) %>
                <%= render CardComponent.new(card: view, size: :l) %>
              </div>
            <% else %>
              <%= render CardComponent.new(card: view, size: :l) %>
            <% end %>
          <% end %>
          <span class="card-detail__shadow" aria-hidden="true"></span>
        </div>
        <% if browse %>
          <%= render "cards/detail_nav", path: browse.next, side: :next %>
        <% end %>
      </div>

      <div class="card-detail__info">
        <h1 id="card-detail-heading" class="card-detail__title" tabindex="-1" data-sub-view-target="heading"><%= view.title %></h1>
        <% if browse %>
          <%# "S1 · #4 215 · 3 / 13", or "S1 · 3 / 13" for an unnumbered card. %>
          <% position = [ view.number_label || "S#{view.season_number}", t("card_details.position", position: browse.position, total: browse.total) ] %>
          <% position << t("card_details.swipe") if browse.total > 1 %>
          <p class="card-detail__position"><%= position.join(" · ") %></p>
        <% end %>
        <% if detail.short_description %>
          <p class="card-detail__description"><%= detail.short_description %></p>
        <% end %>
        <dl class="card-detail__facts">
          <% if detail.publisher %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.publisher") %></dt>
              <dd><%= detail.publisher %></dd>
            </div>
          <% end %>
          <div class="card-detail__fact">
            <dt><%= t("card_details.facts.rarity") %></dt>
            <dd class="card-detail__rarity card-detail__rarity--<%= view.rarity %>">
              <%= pixel_icon("rarity-#{tier}", class: "card-detail__rarity-icon") %>
              <%= strings.rarity_name(view.rarity) %>
            </dd>
          </div>
          <% if view.genre %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.genre") %></dt>
              <dd><%= SetLabel.genre(view.genre) %></dd>
            </div>
          <% end %>
          <div class="card-detail__fact">
            <dt><%= t("card_details.facts.year") %></dt>
            <dd><%= view.year %></dd>
          </div>
          <div class="card-detail__fact">
            <dt><%= t("card_details.facts.season") %></dt>
            <dd><%= t("card_details.season_number", number: view.season_number) %></dd>
          </div>
          <% if detail.sets.any? %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.sets") %></dt>
              <dd>
                <ul class="card-detail__sets">
                  <% detail.sets.each do |set| %>
                    <li><%= set_url ? link_to(SetLabel.for(set), set_url.call(set)) : SetLabel.for(set) %></li>
                  <% end %>
                </ul>
              </dd>
            </div>
          <% end %>
          <% if signed_in %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.copies") %></dt>
              <dd class="card-detail__copies"><%= copies ? t("card_details.copies", count: copies) : t("card_details.no_copies") %></dd>
            </div>
            <% if editions.any? %>
              <% lines = card_detail_edition_lines(editions, strings) %>
              <% shown, folded = lines.first(3), lines.drop(3) %>
              <div class="card-detail__fact">
                <dt><%= t("card_details.facts.editions") %></dt>
                <dd>
                  <ul class="card-detail__editions">
                    <% shown.each do |line| %>
                      <li><%= line %></li>
                    <% end %>
                  </ul>
                  <% if folded.any? %>
                    <details class="card-detail__editions-fold">
                      <summary class="card-detail__editions-more"><%= t("card_details.editions_more", count: folded.size) %></summary>
                      <ul class="card-detail__editions">
                        <% folded.each do |line| %>
                          <li><%= line %></li>
                        <% end %>
                      </ul>
                    </details>
                  <% end %>
                </dd>
              </div>
            <% end %>
          <% end %>
          <% if detail.steam_reviews %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.steam_reviews") %></dt>
              <dd><%= card_detail_steam_reviews(detail.steam_reviews) %></dd>
            </div>
          <% end %>
        </dl>
        <div class="card-detail__actions">
          <%= external_link_to t("card_details.store"), card_detail_store_url(detail.store_url), button: true,
            class: "button button--primary card-detail__store" %>
          <% if share_url %>
            <%# Opens the share sheet and copies the link in the same click,
                where the browser still allows the clipboard
                (share_controller.ts). %>
            <button type="button" class="button button--secondary card-detail__share-button" aria-haspopup="dialog"
              data-controller="dialog-opener" data-dialog-opener-dialog-value="share-sheet"
              data-action="dialog-opener#open share#copy"><%= t("card_details.share.button") %></button>
            <% if repostable %>
              <%= render ButtonComponent.new(variant: :secondary, href: card_repost_path(slug: view.id, number: view.season_number), method: :post) do %><%= t("reposts.button") %><% end %>
            <% end %>
          <% end %>
          <% if showcase %>
            <div class="card-detail__showcase">
              <% case showcase %>
              <% when :add %>
                <%= render ButtonComponent.new(variant: :secondary, href: card_showcase_path(slug: view.id, number: view.season_number), method: :post) do %><%= t("showcases.add") %><% end %>
              <% when :remove %>
                <%= render ButtonComponent.new(variant: :secondary, href: card_showcase_path(slug: view.id, number: view.season_number), method: :delete) do %><%= t("showcases.remove") %><% end %>
              <% when :full %>
                <%= render ButtonComponent.new(variant: :secondary, disabled: true) do %><%= t("showcases.add") %><% end %>
                <p class="card-detail__showcase-full"><%= t("showcases.full") %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <% if share_url %>
    <%= render "cards/share_sheet", view:, share_url:, strings: %>
  <% end %>
<% end %>
