<%# The card detail beside the collection grid before a card is chosen:
    the detail's own layout (cards/_detail), empty, so the chosen card
    takes the same face, ◀ ▶ and title, and the rows a typical card shows.
    The kicker, ◀ ▶ disabled around an empty card-l face over its ground
    shadow, the waiting title, the fact rows with waiting values and
    "Voir sur Steam" disabled; only the kicker and the title are read.
    Locals:
    - signed_in: whether a player views it: then the copies and editions
      rows show too. %>
<% waiting = t("card_details.waiting.value") %>
<% facts = %w[publisher rarity genre year season sets] %>
<% facts += %w[copies editions] if signed_in %>
<%= render PanelComponent.new(tag: :article, brackets: true, class: "card-detail card-detail--waiting") do %>
  <header class="card-detail__header">
    <p class="card-detail__kicker"><%= t("card_details.kicker") %></p>
  </header>
  <div class="card-detail__layout">
    <div class="card-detail__columns">
      <div class="card-detail__stage" aria-hidden="true">
        <%= render "cards/detail_nav", path: nil, side: :previous %>
        <div class="card-detail__card">
          <span class="card-detail__empty-face" aria-hidden="true"></span>
          <span class="card-detail__shadow" aria-hidden="true"></span>
        </div>
        <%= render "cards/detail_nav", path: nil, side: :next %>
      </div>

      <div class="card-detail__info">
        <p class="card-detail__title"><%= t("card_details.waiting.title") %></p>
        <dl class="card-detail__facts" aria-hidden="true">
          <% facts.each do |fact| %>
            <div class="card-detail__fact">
              <dt><%= t("card_details.facts.#{fact}") %></dt>
              <dd><%= waiting %></dd>
            </div>
          <% end %>
        </dl>
        <div class="card-detail__actions">
          <button type="button" disabled class="button button--primary card-detail__store" aria-hidden="true">
            <span class="button__label"><%= t("card_details.store") %></span>
            <%= pixel_icon("external", class: "button__icon") %>
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
