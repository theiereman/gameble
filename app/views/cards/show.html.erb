<% view = @detail.view %>
<% title = card_preview_title(view) %>
<%# The public card page has no app chrome: the wordmark, not the way back to
    the bridge, and no tab bar (layouts/application). %>
<% content_for :back_button, true unless @public %>
<% content_for :public_page, true if @public %>
<% content_for :title, title %>
<% content_for :head do %>
  <%= render "cards/share_tags", title:, url: card_public_url(view) %>
<% end %>
<%# On a phone, the way back leads to where the cards it browses are shown
    ("◀ Grille" to a grid, "◀ Booster" to the opened booster): back through
    history when that page is an earlier entry, so it shows at its scroll
    (history_back_controller.ts), else a plain visit. ◀ ▶ replace only the
    detail's frame: the detail keeps this link's href on the page holding
    its card (sub_view_controller.ts). %>
<% if @browse&.back %>
  <% content_for :phone_back do %>
    <%= link_to @browse.back.path, class: "button button--secondary button--small top-bar__phone-back",
      data: { controller: "history-back", action: "history-back#back" } do %>
      <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= @browse.back.label %></span>
    <% end %>
  <% end %>
<% end %>
<%# A card's detail, also the page a share link opens: only the card,
    never who shared or holds it. A visitor on the card's own page gets
    the public card page (cards/_public); anyone else, the detail: for a
    player its sets lead to their albums only in the published season, the
    one the library shows (a visitor reads their names only), and anyone
    can share it. ◀ ▶ replace this frame and the URL
    (sub_view_controller.ts); every other link in it leaves the page. %>
<% if @public %>
  <%= render "cards/public", detail: @detail, live: @live_strip, pioneer: @pioneer %>
<% else %>
  <%= turbo_frame_tag "card-detail", target: "_top" do %>
    <%= render "cards/detail", detail: @detail, copies: @copies, editions: @editions, signed_in: current_player.present?, share_url: @share_url,
      set_url: (->(set) { library_set_path(kind: set.kind, key: set.key) } if current_player), browse: @browse,
      showcase: @showcase, pioneer: @pioneer %>
  <% end %>
<% end %>
