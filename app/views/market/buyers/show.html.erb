<% content_for :title, t(".heading") %>
<% tab = capture do %>
  <div class="wanted-panel">
    <% if @wanted_copies.any? %>
      <ul class="wanted-panel__list" aria-label="<%= t(".list_label") %>">
        <% @wanted_copies.each do |copy| %>
          <% card = @wanted_cards[copy.card_season_id] %>
          <% next unless card %>
          <li class="wanted-panel__item">
            <%= link_to new_market_card_sale_path(slug: card.id, ref: copy.ref), class: "wanted-panel__tile", aria: { label: wanted_tile_label(copy, card) } do %>
              <span class="wanted-panel__card" aria-hidden="true"><%= render CardComponent.new(card:, size: :s, tilt: false) %></span>
              <span class="wanted-panel__facts" aria-hidden="true">
                <span class="wanted-panel__name"><%= card.title %></span>
                <span class="wanted-panel__seekers"><%= t("markets.wanted.seekers", count: copy.seekers) %></span>
                <% if copy.order %>
                  <span class="wanted-panel__order"><%= t("markets.wanted.order") %> <%= render PicoinAmountComponent.new(amount: copy.order.price, compact: true) %></span>
                <% else %>
                  <span class="wanted-panel__no-order"><%= t("markets.wanted.no_order") %></span>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p class="wanted-panel__foot">
        <%= render ButtonComponent.new(variant: :link, href: new_market_sale_path(filter: { wanted: "1" }), aria_label: t("markets.wanted.see_all_label")) do %><%= t("markets.wanted.see_all") %><% end %>
      </p>
    <% else %>
      <%= render EmptyStateComponent.new(line: t("markets.wanted.empty")) %>
    <% end %>
  </div>
<% end %>
<%= render "exchanges/tabs", current: :market %>
<%= render "markets/tab", title: content_for(:title), current: :buyers, pulse: @pulse, desk: @desk, suspended: @suspended, content: tab %>
