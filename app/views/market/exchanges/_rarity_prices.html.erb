<%# locals: (prices:, staff_only: false) %>
<div class="exchange__rarity-prices">
  <ul class="rarity-tiles" aria-label="<%= t("charts.rarity_prices.tiles") %>">
    <% rarity_price_tiles(prices).each do |tile| %>
      <li class="rarity-tile rarity-tile--<%= tile.rarity %>">
        <p class="rarity-tile__name"><%= pixel_icon("rarity-#{tile.tier}", class: "rarity-tile__icon") %><%= tile.name %></p>
        <p class="rarity-tile__price"><%= tile.price %></p>
        <p class="rarity-tile__change"><%= tile.change %></p>
        <% if tile.sparkline %>
          <%= render ChartComponent.new(drawing: tile.sparkline, id: "rarity-sparkline-#{tile.rarity}", size: :spark) %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render ChartComponent.new(drawing: rarity_index_drawing(prices), id: "rarity-index", size: :index, staff_only:) %>
</div>
