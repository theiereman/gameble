<%= turbo_stream.update "archive-purchase" do %>
  <%= render(@withdrawal ? "market/archive_purchases/result" : "market/archive_purchases/confirmation") %>
<% end %>
<% if @offer %>
  <%= turbo_stream.replace archive_offer_dom_id(@card), partial: "market/shops/offer", locals: { row: @offer, marks: @marks, buyable: @settings.open, caps: @caps } %>
<% else %>
  <%= turbo_stream.remove_all archive_offer_selector(@card) %>
<% end %>
<% if @caps[@card.rarity.to_sym] %>
  <%= turbo_stream.update_all archive_cap_selector(@card.rarity), h(archive_rarity_cap_line(@card.rarity, @caps)) %>
<% end %>
