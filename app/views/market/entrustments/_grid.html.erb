<section class="entrust-grid" aria-label="<%= t("market.entrustments.new.grid_label") %>" data-controller="entrust-grid">
  <p class="entrust-grid__hint"><%= t("market.entrustments.new.keys_hint") %></p>
  <p class="entrust-grid__empty" data-entrust-grid-target="empty" hidden>
    <%= t("market.entrustments.new.no_match") %>
    <button type="button" class="filters__clear" data-action="entrust-grid#clear"><%= t("market.entrustments.new.clear_filters") %></button>
  </p>
  <ul class="entrust-grid__list" data-entrust-grid-target="list" data-action="keydown->entrust-grid#keydown">
    <%= render partial: "market/entrustments/cell", collection: @copies, as: :copy %>
  </ul>
</section>
