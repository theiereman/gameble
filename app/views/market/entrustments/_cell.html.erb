<% copies = @ticked[copy.ref].to_i %>
<% wanted = @wanted[copy.ref] %>
<%= tag.li class: class_names("entrust-cell", "entrust-cell--#{copy.rarity}", "entrust-cell--picked": copies.positive?),
      data: { entrust_target: "cell", entrust_grid_target: "cell", **entrust_copy_data(copy, wanted:), ticked: copies } do %>
  <span class="entrust-cell__check" aria-hidden="true" <%= "hidden" unless copies.positive? %>>✓</span>
  <% if copy.card %>
    <span class="entrust-cell__art" aria-hidden="true"><%= render CardComponent.new(card: copy.card, size: :s, tilt: false) %></span>
  <% end %>
  <span class="entrust-cell__name"><%= copy.title %></span>
  <span class="entrust-cell__edition"><%= t("catalog.rarity.#{copy.rarity}") %> · <%= t("market.entrustments.new.season", number: copy.season_number) %></span>
  <span class="entrust-cell__value">
    <%= render PicoinAmountComponent.new(amount: copy.value) %>
    <% if wanted %>
      <span class="entrust-cell__wanted" aria-hidden="true"><%= t("market.sales.new.wanted_badge", count: wanted.seekers) %></span>
    <% end %>
  </span>
  <span class="entrust-cell__free">
    <span class="entrust-cell__copies" aria-hidden="true">x<%= number_with_delimiter(copy.free) %></span>
    <span class="visually-hidden"><%= t("market.entrustments.new.free", count: copy.free) %></span>
  </span>
  <%= tag.button type: "button", class: "entrust-cell__toggle", tabindex: ((@pagy.offset + copy_counter).zero? ? 0 : -1),
        aria: { pressed: copies.positive?.to_s, disabled: ("true" if copy.free < 1), label: entrust_cell_label(copy, wanted:) },
        data: { action: "entrust-grid#toggle" } %>
  <% if copy.free > 1 %>
    <div class="entrust-cell__stepper">
      <%= render "trades/stepper", controller: "entrust-grid", stepper: entrust_cell_stepper(copy, copies.positive? ? copies : 1) %>
    </div>
  <% end %>
<% end %>
