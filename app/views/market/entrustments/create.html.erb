<% content_for :title, t(".heading") %>
<section class="market-entrust" aria-labelledby="market-entrust-result-heading">
  <header class="market-entrust__header">
    <p class="market-entrust__kicker"><%= t(".kicker") %></p>
    <h1 id="market-entrust-result-heading" class="market-entrust__title"><%= t(".heading") %></h1>
    <%= render "shell/balance_chip", placement: :header %>
  </header>
  <%= render PanelComponent.new(brackets: true, class: "market-entrust__result") do %>
    <p class="market-entrust__total"><%= t(".minted_html", amount: render(PicoinAmountComponent.new(amount: @entrusted.minted, size: :large))) %></p>
    <p class="market-entrust__count"><%= t(".copies", count: @entrusted.copies) %></p>
  <% end %>
  <% if @entrusted.stayed.any? %>
    <%= render PanelComponent.new(class: "market-entrust__stayed") do %>
      <div role="status">
        <h2 class="market-entrust__stayed-heading"><%= t(".stayed.heading", count: @entrusted.stayed.size) %></h2>
        <ul class="market-entrust__stayed-list">
          <% @entrusted.stayed.each do |stayed| %>
            <% name = @stayed_names.fetch(stayed.card_season_id) %>
            <li class="market-entrust__stayed-line"><%= t(".stayed.line_html", title: name.title, season: name.season_number, count: stayed.copies, amount: render(PicoinAmountComponent.new(amount: stayed.value))) %></li>
          <% end %>
        </ul>
        <p class="market-entrust__stayed-cap"><%= t(".stayed.cap_left_html", amount: render(PicoinAmountComponent.new(amount: @entrusted.cap_left))) %></p>
      </div>
    <% end %>
  <% end %>
  <%= render ButtonComponent.new(variant: :link, href: new_market_entrustment_path) do %><%= t(".again") %><% end %>
</section>
