<% content_for :title, t(".heading") %>
<% content_for :public_page, true unless current_player %>
<section class="market-entrust" aria-labelledby="market-entrust-heading">
  <header class="market-entrust__header">
    <p class="market-entrust__kicker"><%= t(".kicker") %></p>
    <h1 id="market-entrust-heading" class="market-entrust__title"><%= t(".heading") %></h1>
    <p class="market-entrust__intro"><%= t(".intro") %></p>
    <%= render "shell/balance_chip", placement: :header %>
  </header>

  <% if current_player.nil? %>
    <%= render PanelComponent.new(class: "market-entrust__notice") do %>
      <p><%= t(".sign_in") %></p>
      <%= render ButtonComponent.new(variant: :link, href: sign_in_path) { t(".sign_in_action") } %>
    <% end %>
  <% else %>
    <% unless @open %>
      <%= render PanelComponent.new(class: "market-entrust__notice", role: "status") do %>
        <p><%= t(".closed") %></p>
        <%= render ButtonComponent.new(variant: :link, href: market_path) { t(".closed_action") } %>
      <% end %>
    <% end %>

    <% if @copies.empty? %>
      <%= render PanelComponent.new(class: "market-entrust__notice") do %>
        <p><%= t(".empty") %></p>
        <%= render ButtonComponent.new(variant: :link, href: booster_path) { t(".empty_action") } %>
      <% end %>
    <% else %>
      <%= form_with url: market_entrustments_path, id: "entrust", class: "market-entrust__form",
            data: { turbo: false, layout: "wide", **entrust_root_data(open: @open, cap_left: @cap_left, doubles: @doubles) } do %>
        <%= hidden_field_tag :settings, @settings.token, id: nil %>
        <%= hidden_field_tag :card, @card_slug, id: nil if @card_slug %>
        <% if @card_slug %>
          <p class="market-entrust__card-only">
            <%= t(".card_only", title: @copies.first.title) %>
            <%= render ButtonComponent.new(variant: :link, href: new_market_entrustment_path) { t(".all_cards") } %>
          </p>
        <% end %>
        <% if @refusal %>
          <p class="market-entrust__refusal" role="alert" tabindex="-1"><%= @refusal %></p>
        <% end %>
        <%= render "market/entrustments/filters" %>
        <%= tag.div class: "market-entrust__layout",
              data: { controller: "entrust-recap", entrust_recap_locale_value: I18n.locale,
                      entrust_recap_accessible_value: t("market.entrustments.strings.amount") } do %>
          <%= render "market/entrustments/grid" %>
          <div class="market-entrust__slot" data-entrust-recap-target="slot">
            <%= render "market/entrustments/recap" %>
          </div>
          <%= render "market/entrustments/bar" %>
          <%= render "market/entrustments/sheet" %>
          <p class="visually-hidden" role="status" aria-live="polite" data-entrust-recap-target="barStatus"></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
