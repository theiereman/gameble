<% content_for :title, t(".heading") %>
<% content_for :screen_title, t(".heading") %>
<% content_for :public_page, true unless current_player %>
<% content_for :phone_back do %><%= phone_back_link t("market.listings.show.back"), market_path %><% end %>
<section class="market-entrust page page--regular" aria-labelledby="market-entrust-heading">
  <header class="market-entrust__header">
    <h1 id="market-entrust-heading" class="visually-hidden"><%= t(".heading") %></h1>
    <%= render "shell/balance_chip", placement: :header %>
  </header>
  <%= render "market/entrustments/region" %>
</section>
