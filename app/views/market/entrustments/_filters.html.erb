<div class="entrust-filters" role="search" data-controller="entrust-filters">
  <label class="visually-hidden" for="entrust-search"><%= t("market.entrustments.new.search_label") %></label>
  <input id="entrust-search" type="search" class="filters__search-field" autocomplete="off"
         placeholder="<%= t("market.entrustments.new.search_placeholder") %>"
         data-entrust-filters-target="search"
         data-action="input->entrust-filters#filter keydown.enter->entrust-filters#hold">
  <fieldset class="filters__group entrust-filters__chips">
    <legend class="visually-hidden"><%= t("market.entrustments.new.filters_legend") %></legend>
    <% Catalog::Rarity::TIERS.each_value do |rarity| %>
      <label class="filter-chip">
        <input type="checkbox" class="filter-chip__box" value="<%= rarity %>"
               data-entrust-filters-target="rarity" data-action="change->entrust-filters#filter">
        <span class="filter-chip__text"><%= t("catalog.rarity.#{rarity}") %></span>
      </label>
    <% end %>
    <label class="filter-chip">
      <input type="checkbox" class="filter-chip__box" checked
             data-entrust-filters-target="doubles" data-action="change->entrust-filters#filter">
      <span class="filter-chip__text"><%= t("market.entrustments.new.doubles") %></span>
    </label>
  </fieldset>
  <div class="entrust-filters__foot">
    <span class="filters__count" data-entrust-filters-target="count"><span class="visually-hidden"><%= t("market.entrustments.new.filters_active") %></span> <span data-entrust-filters-target="number">1</span></span>
    <button type="button" class="filters__clear" data-entrust-filters-target="clear" data-action="entrust-filters#clear" hidden><%= t("market.entrustments.new.clear_filters") %></button>
  </div>
</div>
