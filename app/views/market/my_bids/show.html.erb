<% content_for :title, t(".heading") %>
<% empty = @groups.in_progress.empty? && @groups.recent.empty? %>
<% tab = capture do %>
<%= render "markets/chips", current: :bids %>

<% if empty %>
  <div class="market-empty market-screen__empty-state">
    <h2 class="market-empty__title"><%= t(".empty_title") %></h2>
    <p class="market-empty__body market-screen__empty"><%= t(".empty_soon", count: @pulse.ending_soon, number: number_with_delimiter(@pulse.ending_soon)) %></p>
    <%= render ButtonComponent.new(variant: :link, href: market_path) do %><%= t(".empty_action") %><% end %>
  </div>
<% else %>
  <% if @groups.in_progress.any? %>
    <% outbid = @groups.in_progress.select { it.status == :outbid } %>
    <p class="<%= class_names("market-summary", "market-summary--alert": outbid.any?) %>">
      <span class="market-summary__lead"><%= t(".summary.outbid", count: outbid.size, number: number_with_delimiter(outbid.size)) %></span>
      <% if outbid.any? %>
        <span><%= t(".summary.soonest", time: listing_time_left(listing_seconds_left(outbid.min_by(&:ends_at).ends_at))) %></span>
      <% end %>
      <% if shell_balance %>
        <span class="market-summary__balance"><%= t(".summary.balance", committed: picoins(shell_balance.committed), available: picoins(shell_balance.available)) %></span>
      <% end %>
    </p>
  <% end %>
  <%= render "market/my_bids/group", group: "in-progress", heading: t("market.my_bids.groups.in_progress.heading"),
        empty: t("market.my_bids.groups.in_progress.empty"), rows: @groups.in_progress, suspended: @suspended %>
  <%= render "market/my_bids/group", group: "recent", heading: t("market.my_bids.groups.recent.heading"),
        empty: t("market.my_bids.groups.recent.empty"), rows: @groups.recent, suspended: @suspended %>
<% end %>
<% end %>
<%= render "markets/tab", title: content_for(:title), pulse: @pulse, desk: @desk, suspended: @suspended, commission_rate: @commission_rate, content: tab %>
