<table class="wanted-table" aria-labelledby="market-wanted-heading">
  <thead>
    <tr>
      <% %w[card seekers order average choice].each do |head| %>
        <th scope="col" class="wanted-table__head wanted-table__head--<%= head %>"><%= t("market.wanted_choices.new.heads.#{head}") %></th>
      <% end %>
    </tr>
  </thead>
  <% @lines.each_with_index do |line, index| %>
    <%= render "market/wanted_choices/line", line:, index: %>
  <% end %>
</table>
