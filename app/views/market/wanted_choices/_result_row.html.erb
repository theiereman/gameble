<%# locals: (row:, card:) %>
<li class="wanted-result__line wanted-result__line--<%= row.kind %>">
  <img class="wanted-line__thumb" src="<%= card.image_url %>" alt="" width="30" height="30" loading="lazy" decoding="async">
  <span class="wanted-result__card">
    <span class="wanted-line__name"><%= card.title %></span>
    <span class="wanted-line__edition">
      <%= t("catalog.rarity.#{card.rarity}") %> · <%= t("market.entrustments.new.season", number: card.season_number) %><%= " · #{t("market.wanted_choices.new.copies", count: row.copies)}" if row.copies > 1 %>
    </span>
  </span>
  <span class="market-row__chip market-row__chip--<%= row.kind == :listed ? "accent" : "gold" %>"><%= t("market.wanted_choices.result.chips.#{row.kind}") %></span>
  <span class="wanted-result__sentence">
    <% case row.kind %>
    <% when :sold %>
      <%= t("market.sales.sold.body_html", card: card.title, amount: render(PicoinAmountComponent.new(amount: row.amount))) %>
      <%= t("market.wanted_choices.result.commission_html", amount: render(PicoinAmountComponent.new(amount: row.commission))) %>
    <% when :listed %>
      <%= t("market.wanted_choices.result.listed_html", amount: render(PicoinAmountComponent.new(amount: row.listing.starting_price)),
            end: local_time_tag(row.listing.ends_at, :weekday_time), stamp: render(PicoinAmountComponent.new(amount: row.stamp))) %>
      <%= t("market.wanted_choices.result.listed_received_html", amount: render(PicoinAmountComponent.new(amount: row.amount))) %>
      <%= render ButtonComponent.new(variant: :link, href: market_listing_path(token: row.listing.token)) do %><%= t("market.wanted_choices.result.see_listing") %><% end %>
    <% when :entrusted %>
      <%= t("market.wanted_choices.result.entrusted_html", amount: render(PicoinAmountComponent.new(amount: row.amount))) %>
    <% end %>
  </span>
  <span class="wanted-result__amount">
    <% if row.kind == :listed %>
      <span class="wanted-result__stamp">−<%= render PicoinAmountComponent.new(amount: row.stamp) %> <%= t("market.wanted_choices.result.stamp") %></span>
    <% else %>
      <span class="wanted-result__gain"><%= render PicoinAmountComponent.new(amount: row.amount) %> <%= t("market.wanted_choices.result.gained") %></span>
    <% end %>
  </span>
</li>
