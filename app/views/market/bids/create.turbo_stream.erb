<%= turbo_stream.update "annonce-suspension" do %><%= render "market/suspended_banner" if @region[:suspended] %><% end %>
<%= turbo_stream.replace "annonce-bid" do %><%= render "market/bids/region", **@region %><% end %>
<%= turbo_stream.replace "annonce-figures" do %><%= render "market/listings/figures", listing: @region[:listing], viewer: current_player %><% end %>
<%= turbo_stream.replace "annonce-history" do %><%= render "market/listings/history", lines: @history, viewer: current_player %><% end %>
