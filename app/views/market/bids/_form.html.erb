<%# locals: (listing:, sheet:, answer:, refusal:, posted:, posted_amount:) %>
<% described = [ "annonce-minimum", (refusal ? "annonce-error" : nil), ("annonce-answer" if answer&.branch == :beaten) ].compact.join(" ") %>
<%= form_with url: market_listing_bids_path(token: listing.token), id: "annonce-form", class: "market-bid",
      data: { action: "submit->annonce#submit turbo:submit-end->annonce#submitted" } do %>
  <%= hidden_field_tag :drawn_minimum, sheet.minimum, id: nil %>
  <%= tag.div class: "market-bid__field", data: bid_field_data(sheet, answered: !answer.nil?) do %>
    <div class="market-bid__field-head">
      <label for="annonce-maximum" class="market-bid__label"><%= t("market.bids.form.label") %></label>
      <p class="<%= class_names("market-bid__available", "market-bid__available--short": sheet.available < sheet.minimum) %>">
        <span class="market-bid__available-label"><%= t("market.bids.form.available") %></span>
        <%= render PicoinAmountComponent.new(amount: sheet.available, class: "market-bid__available-amount") %>
      </p>
    </div>
    <%= text_field_tag :maximum, typed_picoins(posted), id: "annonce-maximum", inputmode: "numeric", autocomplete: "off",
          aria: { invalid: (refusal ? "true" : nil), describedby: described },
          data: { turbo_permanent: true, controller: "amount-field", annonce_field_target: "input", focus_name: "field",
                  action: "beforeinput->amount-field#remember input->amount-field#group input->annonce-field#type keydown->annonce-field#keydown" } %>
    <p id="annonce-minimum" class="market-bid__minimum"><%= bid_minimum_text(sheet) %></p>
    <% if (shortcuts = bid_shortcuts(sheet)).any? %>
      <div class="market-bid__shortcuts" role="group" aria-label="<%= t("market.bids.form.shortcuts.label") %>">
        <% shortcuts.each do |label, amount| %>
          <button type="button" class="market-bid__shortcut" data-action="annonce-field#fill" data-annonce-field-amount-param="<%= amount %>"><%= label %></button>
        <% end %>
      </div>
    <% end %>
    <p id="annonce-error" class="market-bid__error" role="alert" data-annonce-field-target="error" <%= "hidden" unless refusal %>><%= refusal %></p>
  <% end %>
  <%= render "market/bids/foot", sheet:, answer:, posted_amount: %>
<% end %>
<%= render "market/bids/unusual_dialog" %>
