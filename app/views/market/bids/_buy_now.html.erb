<%# locals: (sheet:) %>
<div class="market-bid__buy-now">
  <p class="market-bid__buy-now-price">
    <span class="market-bid__buy-now-label"><%= t("market.bids.buy_now.title") %></span>
    <%= render PicoinAmountComponent.new(amount: sheet.buy_now_price, class: "market-bid__buy-now-amount") %>
  </p>
  <%= render ButtonComponent.new(variant: :secondary, size: :small, type: :submit, name: "buy_now", value: "1", disabled: !sheet.can_buy_now) do %><%= t("market.bids.buy_now.button") %><% end %>
  <% unless sheet.can_buy_now %>
    <p class="market-bid__small"><%= t("market.bids.buy_now.available_html", amount: bid_amount(sheet.available)) %></p>
  <% end %>
</div>
