<%# locals: (listing:, sheet:) %>
<dialog id="annonce-buy-now" class="modal" aria-labelledby="annonce-buy-now-title" aria-describedby="annonce-buy-now-text"
        data-controller="dialog annonce-dialog" data-annonce-dialog-kind-value="buy_now" data-action="click->dialog#closeOnScrim">
  <%= render PanelComponent.new(brackets: true, class: "modal__panel") do %>
    <span class="modal__handle" aria-hidden="true"></span>
    <div class="modal__head">
      <h2 id="annonce-buy-now-title" class="modal__title" tabindex="-1" autofocus><%= t("market.bids.buy_now.title") %></h2>
      <button type="button" class="modal__close" aria-label="<%= t("market.bids.buy_now.close") %>" data-action="dialog#close">
        <%= pixel_icon("close", class: "modal__close-icon") %>
      </button>
    </div>
    <div id="annonce-buy-now-text" class="market-dialog__text">
      <p><%= t("market.bids.buy_now.body_html", card: bid_card_name(listing.card), price: bid_amount(sheet.buy_now_price)) %></p>
      <% if sheet.leading %>
        <p><%= t("market.bids.buy_now.held_extra_html", own: bid_amount(sheet.own_maximum), held: bid_amount(sheet.buy_now_hold)) %></p>
      <% end %>
    </div>
    <div class="market-dialog__actions">
      <button type="button" class="button button--primary" data-action="annonce-dialog#confirm"><%= t("market.bids.buy_now.confirm", amount: picoins(sheet.buy_now_hold)) %></button>
      <button type="button" class="button button--secondary" data-action="dialog#close"><%= t("market.bids.buy_now.cancel") %></button>
    </div>
  <% end %>
</dialog>
