<%# locals: (listing:, sheet:, outcome:, viewer:, answer: nil, focus: nil, refusal: nil, not_recorded: false, posted: "", posted_amount: nil, suspended: false) %>
<%= tag.div id: "annonce-bid", class: "market-listing__bid", data: { annonce_target: "region", focus: focus } do %>
  <% if outcome %>
    <%= render "market/listings/outcome", outcome:, viewer: %>
    <% if not_recorded %><p class="market-bid__note"><%= t("market.bids.not_recorded") %></p><% end %>
  <% elsif sheet && suspended %>
    <%= render "market/bids/suspended_form", sheet:, refusal: %>
  <% elsif sheet %>
    <%= render "market/bids/form", listing:, sheet:, answer:, refusal:, posted:, posted_amount: %>
  <% elsif annonce_cancellable?(listing, viewer) %>
    <div class="market-bid__cancel">
      <%= render ButtonComponent.new(variant: :secondary, opens: cancel_dialog_id(listing.token), aria_label: t("market.my_sales.cancel_name", card: listing.card.title)) { t("market.my_sales.cancel") } %>
      <%= render "market/cancellations/dialog", token: listing.token, card: listing.card, return_to: "annonce" %>
    </div>
  <% elsif refusal %>
    <p class="market-bid__refusal" role="alert"><%= refusal %></p>
  <% elsif viewer.nil? %>
    <p class="market-bid__sign-in"><%= sign_in_button t("market.bids.form.sign_in"), origin: market_listing_path(token: listing.token), class: "button button--primary" %></p>
  <% end %>
<% end %>
