<%# locals: (row:, marks: ListingMarks::NONE, buyable: false, stock: true, size: :m, tile_id: true, caps: {}) %>
<% card = row.card %>
<% mark = marks.for(card) %>
<% wanted = marks.any? && mark.wanted? %>
<% cap_line = archive_cap_line(card, caps) %>
<% cap_id = "archive-cap-#{SecureRandom.alphanumeric(8)}" if caps.any? %>
<%= tag.li id: (archive_offer_dom_id(card) if tile_id), class: "listing-tile archive-offer", data: { archive_offer: archive_offer_key(card) } do %>
  <%= link_to archive_offer_path(card, buyable:), class: "listing-tile__link archive-offer__link",
        aria: { label: archive_offer_label(row, wanted:, buyable:, stock:), describedby: cap_id },
        data: (buyable ? { turbo_frame: "archive-purchase", action: "purchase-dialog#open" } : {}) do %>
    <span class="listing-tile__card archive-offer__card" aria-hidden="true">
      <span class="archive-offer__tags">
        <span class="archive-offer__tag archive-offer__tag--archives"><%= t("market.shops.offer.archives") %></span>
        <% if wanted %><span class="archive-offer__tag archive-offer__tag--wanted"><%= t("market.shops.offer.wanted") %></span><% end %>
      </span>
      <%= render CardComponent.new(card:, size:, goals: mark.goal_numbers) %>
    </span>
    <span class="listing-tile__facts" aria-hidden="true">
      <span class="listing-tile__line">
        <%= render PicoinAmountComponent.new(amount: row.price, compact: true, class: "listing-tile__price archive-offer__price") %>
        <span class="archive-offer__fixed"><%= t("market.shops.offer.fixed") %></span>
      </span>
      <% if stock %><span class="listing-tile__line archive-offer__stock"><%= t("market.shops.offer.stock", count: row.stock) %></span><% end %>
      <% if cap_id %><span class="listing-tile__line archive-offer__cap" data-archive-cap="<%= card.rarity %>"><%= cap_line %></span><% end %>
      <% if buyable %><span class="listing-tile__line archive-offer__buy"><%= t("market.shops.offer.buy") %></span><% end %>
    </span>
    <% if cap_id %><span id="<%= cap_id %>" class="visually-hidden" data-archive-cap="<%= card.rarity %>"><%= cap_line %></span><% end %>
  <% end %>
<% end %>
