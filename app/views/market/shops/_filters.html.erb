<%# locals: (filters:, rarities:, sort:, results:, wanted_count: nil, caps: {}) %>
<%= form_with url: market_shop_path, method: :get, class: "filters market-filters market-shop__filters", html: { role: "search" }, data: {
  controller: "collection-filters", turbo_frame: "collection-results",
  action: "input->collection-filters#typed compositionend->collection-filters#typed change->collection-filters#changed " \
    "submit->collection-filters#submitted turbo:frame-load@document->collection-filters#resultsLoaded"
} do %>
  <%= hidden_field_tag :sort, sort, id: nil %>
  <% filters.seasons.each do |number| %><%= hidden_field_tag "season[]", number, id: nil %><% end %>
  <div class="filters__search">
    <label class="visually-hidden" for="shop-search"><%= t(".search_label") %></label>
    <%= search_field_tag "q", filters.query, id: "shop-search", class: "filters__search-field", autocomplete: "off",
      maxlength: Game::Market::ListingFilters::MAX_QUERY, placeholder: t(".search_label"), data: { collection_filters_target: "search" } %>
  </div>
  <ul class="filter-row" aria-label="<%= t("library.filters.title") %>">
    <% if rarities.any? %>
      <li>
        <%= tag.a(**bottom_sheet_opener(filter_sheet_id(:rarity)), class: "filter-chip filter-row__pastille") do %>
          <span class="filter-chip__text">
            <%= filter_row_label(:rarity) %>
            <span class="filter-row__count" data-collection-filters-target="pastilleCount" data-groups="rarity" <%= "hidden" if filters.rarities.empty? %>><span class="visually-hidden"><%= t("library.filters.active") %></span> <span data-pastille-number><%= filters.rarities.size %></span></span>
          </span>
        <% end %>
      </li>
    <% end %>
    <% if current_player && (wanted_count.to_i.positive? || filters.wanted_only?) %>
      <li>
        <label class="filter-chip market-filters__wanted">
          <%= check_box_tag "wanted", "1", filters.wanted_only?, id: nil, class: "filter-chip__box", aria: { label: t(".wanted_spoken", count: wanted_count.to_i) } %>
          <span class="filter-chip__text" aria-hidden="true"><%= t(".wanted", count: wanted_count.to_i) %></span>
        </label>
      </li>
    <% end %>
  </ul>
  <% if rarities.any? %>
    <%= render BottomSheetComponent.new(id: filter_sheet_id(:rarity), title: filter_sheet_title(:rarity)) do %>
      <div class="filter-sheet">
        <fieldset class="filters__group market-shop__rarities" data-collection-filters-target="group" data-group="rarity">
          <legend class="visually-hidden"><%= t("library.filters.groups.rarity") %></legend>
          <% rarities.each do |rarity| %>
            <label class="filter-chip">
              <%= check_box_tag "rarity[]", rarity, filters.rarities.include?(rarity), id: nil, class: "filter-chip__box" %>
              <span class="filter-chip__text"><%= t("catalog.rarity.#{rarity}") %></span>
              <% if caps.any? %><span class="market-shop__rarity-cap" data-archive-cap="<%= rarity %>"><%= archive_rarity_cap_line(rarity, caps) %></span><% end %>
            </label>
          <% end %>
        </fieldset>
        <p class="filter-sheet__status" role="status" data-collection-filters-target="sheetStatus"><%= results %></p>
      </div>
    <% end %>
  <% end %>
  <%= link_to t("library.filters.clear"), market_shop_path(sort:), class: "filters__clear",
        data: { turbo_frame: "_top", collection_filters_target: "clear" }, hidden: !filters.any? %>
  <noscript><%= submit_tag t("library.filters.apply"), name: nil, class: "filters__apply" %></noscript>
<% end %>
