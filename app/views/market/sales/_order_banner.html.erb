<%# locals: (order:, refusal: nil) %>
<% if order %>
  <% amounts = order_sale_amounts(order.price, @settings) %>
  <%= render PanelComponent.new(class: "sale-order") do %>
    <div class="sale-order__text">
      <p class="sale-order__title"><%= t("market.sales.order.waiting_html", amount: render(PicoinAmountComponent.new(amount: order.price))) %></p>
      <% if refusal %>
        <p class="sale-order__refusal" role="alert" tabindex="-1" data-listing-fields-target="orderRefusal"><%= refusal %></p>
      <% else %>
        <p class="sale-order__terms"><%= t("market.sales.order.terms_html", received: render(PicoinAmountComponent.new(amount: amounts[:received])),
              commission: render(PicoinAmountComponent.new(amount: amounts[:commission]))) %></p>
      <% end %>
    </div>
    <%= render ButtonComponent.new(type: :submit, name: "order", value: order.token, formaction: market_order_sale_path,
          aria_label: t("market.sales.order.submit_label", amount: picoins(amounts[:received]))) do %><%= t("market.sales.order.submit") %><% end %>
  <% end %>
<% else %>
  <p class="sale-order-none"><%= t("market.sales.order.none") %></p>
  <% if refusal %>
    <p class="sale-order__refusal" role="alert" tabindex="-1" data-listing-fields-target="orderRefusal"><%= refusal %></p>
  <% end %>
<% end %>
