<% seconds = listing_seconds_left(@listing.ends_at) %>
<% content_for :public_page, true unless current_player %>
<% content_for :back_button, true %>
<% content_for :phone_back do %><%= phone_back_link t("market.listings.show.back"), market_path, every_width: true %><% end %>
<% content_for :title, @listing.card.title %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= turbo_stream_from(*ListingStream.streamables(@listing.token)) %>
<%= tag.section id: "annonce", class: "market-listing", aria: { labelledby: "market-listing-heading" }, data: annonce_root_data do %>
  <p class="visually-hidden" role="status" aria-live="polite" data-controller="annonce-status"></p>
  <% unless @outcome %><%= tag.div hidden: true, data: annonce_status_data(@listing, current_player, @events) %><% end %>
  <template data-annonce-target="notRecorded"><p class="market-bid__note"><%= t("market.bids.not_recorded") %></p></template>
  <header class="market-listing__header">
    <p class="market-listing__kicker market-listing__kicker--<%= @listing.card.rarity %>">
      <%= CardStrings.new.rarity_name(@listing.card.rarity) %> · <%= t("markets.filters.season_chip", number: @listing.card.season_number) %>
    </p>
    <%= tag.h1 @listing.card.title, id: "market-listing-heading", class: "market-listing__title", tabindex: -1, autofocus: @focus.nil? %>
    <%= render "shell/balance_chip", placement: :header %>
  </header>

  <div id="annonce-suspension" class="market-listing__suspension"><%= render "market/suspended_banner" if @suspended %></div>

  <div class="market-listing__layout">
    <div class="market-listing__card">
      <%= render CardComponent.new(card: @listing.card, size: :l) %>
      <dl class="market-listing__facts">
        <% if @price %>
          <div class="market-listing__fact market-listing__fact--price">
            <dt><%= t(".average_price") %></dt>
            <dd>
              <%= render AveragePriceComponent.new(price: @price) %>
              <% if (basis = average_price_basis(@price)) %>
                <span class="average-price__basis"><%= basis %></span>
              <% end %>
            </dd>
          </div>
        <% end %>
        <div class="market-listing__fact">
          <dt><%= t(".seller") %></dt>
          <dd><%= render PlayerNameComponent.new(player: @listing.seller, viewer: current_player) %></dd>
        </div>
      </dl>
    </div>

    <div class="market-listing__figures">
      <div class="market-listing__figure">
        <p class="market-listing__label"><%= t(".price") %></p>
        <%= render PicoinAmountComponent.new(amount: @listing.current_price, size: :large, class: "market-listing__price") %>
        <% if @listing.leader %>
          <p class="market-listing__leader"><%= t(".leader") %> <%= render PlayerNameComponent.new(player: @listing.leader, viewer: current_player) %></p>
        <% end %>
      </div>
      <%= tag.div class: "market-listing__figure market-listing__figure--time", data: clock_data(seconds) do %>
        <p class="market-listing__label"><%= t(".time") %></p>
        <p class="market-listing__time<%= " market-listing__time--soon" if time_left_soon?(seconds) %>" data-listing-clock-target="label"><%= listing_time_left(seconds) %></p>
        <p class="market-listing__ends"><%= local_time_tag(@listing.ends_at) %></p>
      <% end %>
      <% if @listing.status == "open" %>
        <%= tag.progress class: class_names("market-listing__progress", "market-listing__progress--soon": time_left_soon?(seconds)),
              max: listing_duration_seconds(@listing), value: listing_elapsed_seconds(@listing), aria: { hidden: true } %>
      <% end %>
      <% if @listing.buy_now_price && (@sheet.nil? || @suspended) %>
        <div class="market-listing__figure market-listing__figure--buy-now">
          <p class="market-listing__label"><%= t(".buy_now") %></p>
          <%= render PicoinAmountComponent.new(amount: @listing.buy_now_price, class: "market-listing__buy-now") %>
        </div>
      <% end %>
    </div>

    <%= render "market/bids/region", listing: @listing, sheet: @sheet, outcome: @outcome, viewer: current_player, focus: @focus, suspended: @suspended, events: @events %>

    <%= render "market/listings/history", lines: @history, viewer: current_player %>
  </div>
<% end %>
