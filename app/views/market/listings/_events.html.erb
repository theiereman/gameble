<%# locals: (events:, listing:, viewer:) %>
<% if events&.outbid %>
  <div id="annonce-outbid" class="market-event market-event--outbid">
    <h2 class="market-event__title"><%= t("market.listings.events.outbid.title") %></h2>
    <p class="market-event__body"><%= t("market.listings.events.outbid.body_html", name: render(PlayerNameComponent.new(player: events.outbid.other, viewer:)),
          card: listing.card.title, amount: bid_amount(events.outbid.amount)) %></p>
    <%= render ButtonComponent.new(variant: :link, href: market_listing_path(token: listing.token, focus: "maximum")) { t("market.listings.events.outbid.action") } %>
  </div>
<% end %>
<% if events&.extended %>
  <div id="annonce-extended" class="market-event market-event--extended">
    <h2 class="market-event__title"><%= t("market.listings.events.extended.title") %></h2>
    <p class="market-event__body"><%= t("market.listings.events.extended.body_html", minutes: events.extended.minutes, time: local_time_tag(events.extended.until)) %></p>
  </div>
<% end %>
