<%# locals: (outcome:, viewer:) %>
<% if outcome.is_a?(Game::Market::ListingOutcome::Closing) %>
  <p class="market-outcome market-outcome--closing"><%= t("market.listings.outcome.closing") %></p>
<% elsif outcome %>
  <div class="market-outcome market-outcome--<%= outcome_tone(outcome) %>">
    <h2 id="listing-outcome-heading" class="market-outcome__title" tabindex="-1" data-focus-name="heading"><%= outcome_title(outcome) %></h2>
    <p class="market-outcome__body"><%= outcome_body(outcome, viewer) %></p>
    <% if %i[won bought].include?(outcome.kind) %>
      <%= render ButtonComponent.new(href: card_path(slug: outcome.card.id)) do %><%= t("market.listings.outcome.won.see_card") %><% end %>
    <% end %>
  </div>
<% end %>
