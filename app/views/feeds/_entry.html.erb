<% repost = item.entry.kind == "repost" %>
<% trade = item.entry.kind == "trade" %>
<% set_entry = item.entry.kind == "set" %>
<% verdict = item.entry.kind == "verdict" %>
<% sale = item.entry.kind == "sale" %>
<% viewer = local_assigns.key?(:viewer) ? local_assigns[:viewer] : current_player %>
<% target = local_assigns[:target]&.id == item.entry.id %>
<% post = local_assigns.fetch(:post, false) %>
<% tint = card.rarity if card && !trade %>
<%= tag.li id: "entry-#{item.entry.token}", class: class_names("feed__entry", "feed__entry--#{tint}" => tint, "feed__entry--filler": item.filler, "feed__entry--set": set_entry || verdict, "feed__entry--decor-#{feed_decor(item.entry)}": post, "feed__entry--target": target),
      aria: { current: ("true" if target) } do %>
  <% if post %>
    <div class="feed__byline">
      <%= player_avatar(item.player, class_name: "feed__avatar") %>
      <span class="feed__who"><%= feed_byline(item, viewer:) %></span>
    </div>
  <% end %>
  <% if trade %>
    <span class="feed__thumbs">
      <% [ card, partner_card ].each do |traded| %>
        <%= link_to card_path(slug: traded.id), class: "feed__thumb feed__thumb--framed feed__thumb--#{traded.rarity}",
              aria: { label: traded.title }, data: { turbo_prefetch: false } do %>
          <%= render CardComponent.new(card: traded, size: :s) %>
        <% end %>
      <% end %>
    </span>
  <% elsif !set_entry && !verdict %>
    <%= link_to card_path(slug: card.id), class: class_names("feed__thumb", "feed__thumb--framed feed__thumb--#{card.rarity}": repost),
          aria: { label: card.title }, data: { turbo_prefetch: false } do %>
      <%= render CardComponent.new(card:, size: :s) %>
    <% end %>
  <% end %>
  <div class="feed__body">
    <% if post %><%= feed_headline(item, card, partner_card, set) %><% end %>
    <div class="feed__head">
      <p class="feed__sentence"><%= feed_sentence(item, card, partner_card, set, titles: true, viewer:) %></p>
      <%= local_time_tag(item.entry.occurred_at, class: "feed__time") %>
    </div>
    <div class="feed__meta">
      <span class="feed__tags">
        <% if verdict %>
          <span class="feed__tag feed__tag--verdict"><%= t("feeds.show.verdict_tag") %></span>
        <% elsif set_entry %>
          <%= feed_tier_tag(item.entry.tier, surface_class: "feed__tag") unless post && item.entry.set_count == 1 %>
        <% elsif trade %>
          <span class="feed__tag feed__tag--trade">
            <%= pixel_icon("swap", class: "feed__tag-icon") %>
            <span><%= t("feeds.show.trade_tag") %></span>
          </span>
        <% elsif repost %>
          <span class="feed__tag feed__tag--repost"><%= t("feeds.show.repost_tag") %></span>
        <% elsif sale %>
          <span class="feed__tag feed__tag--sale"><%= t("feeds.show.sale_tag") %></span>
        <% else %>
          <span class="feed__tag feed__tag--<%= card.rarity %>">
            <%= pixel_icon("rarity-#{Catalog::Rarity::TIERS.key(card.rarity.to_sym)}", class: "feed__tag-icon") %>
            <span><%= feed_rarity_name(card) %></span>
          </span>
        <% end %>
        <% if item.entry.kind == "discovery" %><span class="feed__chip"><%= t("feeds.show.first_discovery") %></span><% end %>
      </span>
      <% if local_assigns[:reactions] && !verdict %>
        <% lazy = local_assigns.fetch(:lazy, false) %>
        <%= render "reactions/bar", token: item.entry.token, summary: reactions.fetch(item.entry.id), interactive: !lazy && current_player.present?, lazy: %>
      <% end %>
    </div>
  </div>
<% end %>
