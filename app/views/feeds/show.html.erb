<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% if current_player %>
  <% content_for :phone_back do %>
    <%= link_to more_path, class: "button button--secondary button--small top-bar__phone-back" do %>
      <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= t(".more") %></span>
    <% end %>
  <% end %>
<% end %>
<%= tag.section class: "feed", aria: { labelledby: "feed-heading" },
      data: ({ controller: "feed-announcer", feed_announcer_templates_value: t(".announcement").to_json,
               feed_announcer_limit_value: Game::FeedEntries::LIMIT } if @live) do %>
  <h1 id="feed-heading" class="feed__title"><%= t(".title") %></h1>
  <div class="feed__controls" data-controller="current-chips">
    <nav class="feed__tabs" aria-label="<%= t(".tabs_label") %>">
      <%= feed_chip_link t(".tabs.all"), feed_path(filter: @filter), current: @tab.nil?, classes: "feed__tab" %>
      <% if current_player %>
        <%= feed_chip_link t(".tabs.friends"), feed_path(tab: "friends", filter: @filter), current: @tab == "friends", classes: "feed__tab" %>
      <% else %>
        <%= tag.button type: :button, class: "feed__tab filter-chip", disabled: true do %>
          <%= tag.span t(".tabs.friends"), class: "filter-chip__text" %>
        <% end %>
      <% end %>
    </nav>
    <nav class="feed__filters" aria-label="<%= t(".filters_label") %>">
      <% [ nil, *FeedsController::FILTERS.keys ].each do |filter| %>
        <%= feed_chip_link t(".filters.#{filter || "all"}"), feed_path(tab: @tab, filter:), current: filter == @filter, classes: "feed__filter" %>
      <% end %>
    </nav>
  </div>
  <% if @no_friends %>
    <%= render PanelComponent.new(class: "feed__no-friends") do %>
      <p class="feed__no-friends-text"><%= t(".no_friends") %></p>
      <%= render ButtonComponent.new(href: friends_path) do %><%= t(".add_friends") %><% end %>
    <% end %>
  <% else %>
    <% if @live || @items.any? %>
      <%= tag.ul class: "feed__list", id: ("feed-entries" if @live), data: ({ feed_announcer_target: "list" } if @live) do %>
        <% @items.each do |item, card, partner_card, set| %>
          <%= render "feeds/entry", item:, card:, partner_card:, set: %>
        <% end %>
      <% end %>
    <% end %>
    <% if @items.empty? %>
      <%= render PanelComponent.new(tag: :p, class: "feed__empty") do %><%= @filter ? t(".empty_filter") : t(".empty") %><% end %>
    <% end %>
  <% end %>
  <% if @live %>
    <p class="visually-hidden" role="status" data-feed-announcer-target="status"></p>
    <%= turbo_stream_from(*LiveStream.feed_streamables) %>
  <% end %>
<% end %>
