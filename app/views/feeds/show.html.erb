<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% if current_player %>
  <% content_for :phone_back do %>
    <%= link_to more_path, class: "button button--secondary button--small top-bar__phone-back" do %>
      <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= t(".more") %></span>
    <% end %>
  <% end %>
<% end %>
<%# The activity feed, open to visitors: the All and Friends tabs (Friends
    greyed and disabled for a visitor, who reads All and whose phone back
    leads to the landing), then the type filters (links, the chosen one current,
    each keeping the other row's choice), then one row per entry, newest
    first: time, a sentence naming the player (a first discovery's behind
    its gold "First discovery" chip), the card's thumbnail and its
    rarity; a repost's thumbnail framed in its rarity's colour, with a
    Repost tag in place of the rarity; a trade names both players and shows
    the best card each gave, both framed, with a Trade tag; a set entry
    names the set or the count of sets, with no thumbnail, and its tier's
    tag (notches, or the COMPLET frame). Fillers of a
    quiet feed sit on the sunken panel. Names and the order are already filtered by
    Game::Visibility. A filter with nothing says so in its own line; the
    Friends tab without a friend invites to add some. No Brotherhood line here.
    All, without a filter, is live: the public stream prepends new entries
    to its list, and a polite status line counts them in batches while the
    list is not focused (feed_announcer_controller.ts). %>
<%= tag.section class: "feed", aria: { labelledby: "feed-heading" },
      data: ({ controller: "feed-announcer", feed_announcer_templates_value: t(".announcement").to_json,
               feed_announcer_limit_value: Game::FeedEntries::LIMIT } if @live) do %>
  <h1 id="feed-heading" class="feed__title"><%= t(".title") %></h1>
  <nav class="feed__tabs segmented" aria-label="<%= t(".tabs_label") %>">
    <%= link_to t(".tabs.all"), feed_path(filter: @filter), class: "feed__tab segmented__option", aria: { current: ("true" unless @tab) } %>
    <% if current_player %>
      <%= link_to t(".tabs.friends"), feed_path(tab: "friends", filter: @filter), class: "feed__tab segmented__option",
            aria: { current: ("true" if @tab == "friends") } %>
    <% else %>
      <%= tag.button t(".tabs.friends"), type: :button, class: "feed__tab segmented__option", disabled: true %>
    <% end %>
  </nav>
  <nav class="feed__filters segmented" aria-label="<%= t(".filters_label") %>">
    <% [ nil, *FeedsController::FILTERS.keys ].each do |filter| %>
      <%= link_to t(".filters.#{filter || "all"}"), feed_path(tab: @tab, filter:), class: "feed__filter segmented__option",
            aria: { current: ("true" if filter == @filter) } %>
    <% end %>
  </nav>
  <% if @no_friends %>
    <%= render PanelComponent.new(class: "feed__no-friends") do %>
      <p class="feed__no-friends-text"><%= t(".no_friends") %></p>
      <%= render ButtonComponent.new(href: friends_path) do %><%= t(".add_friends") %><% end %>
    <% end %>
  <% else %>
    <% if @live || @items.any? %>
      <%= tag.ul class: "feed__list", id: ("feed-entries" if @live), data: ({ feed_announcer_target: "list" } if @live) do %>
        <% @items.each do |item, card, partner_card, set| %>
          <%= render "feeds/entry", item:, card:, partner_card:, set: %>
        <% end %>
      <% end %>
    <% end %>
    <% if @items.empty? %>
      <%= render PanelComponent.new(tag: :p, class: "feed__empty") do %><%= @filter ? t(".empty_filter") : t(".empty") %><% end %>
    <% end %>
  <% end %>
  <% if @live %>
    <p class="visually-hidden" role="status" data-feed-announcer-target="status"></p>
    <%= turbo_stream_from(*LiveStream.feed_streamables) %>
  <% end %>
<% end %>
