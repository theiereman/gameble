<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% content_for :phone_back do %>
  <%= link_to more_path, class: "button button--secondary button--small top-bar__phone-back" do %>
    <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= t(".more") %></span>
  <% end %>
<% end %>
<%# The activity feed: the All and Friends tabs (a visitor's Friends tab
    opens the sign-in panel), then the type filters (links, the chosen one current,
    each keeping the other row's choice), then one row per entry, newest
    first: time, a sentence naming the player (a first discovery's behind
    its gold "First discovery" chip), the card's thumbnail and its
    rarity; a repost's thumbnail framed in its rarity's colour, with a
    Repost tag in place of the rarity. Fillers of a quiet feed sit on the
    sunken panel. Names and the order are already filtered by
    Game::Visibility. A filter with nothing says so in its own line; the
    Friends tab without a friend invites to add some. No Brotherhood line here. %>
<section class="feed" aria-labelledby="feed-heading">
  <h1 id="feed-heading" class="feed__title"><%= t(".title") %></h1>
  <nav class="feed__tabs segmented" aria-label="<%= t(".tabs_label") %>">
    <%= link_to t(".tabs.all"), feed_path(filter: @filter), class: "feed__tab segmented__option", aria: { current: ("true" unless @tab) } %>
    <% if current_player %>
      <%= link_to t(".tabs.friends"), feed_path(tab: "friends", filter: @filter), class: "feed__tab segmented__option",
            aria: { current: ("true" if @tab == "friends") } %>
    <% else %>
      <%= tag.button t(".tabs.friends"), type: :button, class: "feed__tab segmented__option", aria: { haspopup: "dialog" },
            data: { controller: "dialog-opener", action: "dialog-opener#open", dialog_opener_dialog_value: "sign-in-panel" } %>
    <% end %>
  </nav>
  <nav class="feed__filters segmented" aria-label="<%= t(".filters_label") %>">
    <% [ nil, *FeedsController::FILTERS.keys ].each do |filter| %>
      <%= link_to t(".filters.#{filter || "all"}"), feed_path(tab: @tab, filter:), class: "feed__filter segmented__option",
            aria: { current: ("true" if filter == @filter) } %>
    <% end %>
  </nav>
  <% if @no_friends %>
    <%= render PanelComponent.new(class: "feed__no-friends") do %>
      <p class="feed__no-friends-text"><%= t(".no_friends") %></p>
      <%= render ButtonComponent.new(href: friends_path) do %><%= t(".add_friends") %><% end %>
    <% end %>
  <% elsif @items.empty? %>
    <%= render PanelComponent.new(tag: :p, class: "feed__empty") do %><%= @filter ? t(".empty_filter") : t(".empty") %><% end %>
  <% else %>
    <ul class="feed__list">
      <% @items.each do |item, card| %>
        <% tier = Catalog::Rarity::TIERS.key(card.rarity.to_sym) %>
        <% name = item.player.persona_name.presence || t(".nameless") %>
        <li class="<%= class_names("feed__entry", "feed__entry--filler": item.filler) %>">
          <time class="feed__time" datetime="<%= item.entry.occurred_at.utc.iso8601 %>"><%= item.entry.occurred_at.utc.strftime(t(".time_format")) %></time>
          <% repost = item.entry.kind == "repost" %>
          <% if item.entry.kind == "discovery" %>
            <p class="feed__sentence"><span class="feed__chip"><%= t(".first_discovery") %></span> <%= t(".discovered_html", name: tag.strong(name), card: tag.strong(card.title)) %></p>
          <% elsif repost %>
            <p class="feed__sentence"><%= t(".reposted_html", name: tag.strong(name), card: tag.strong(card.title)) %></p>
          <% else %>
            <p class="feed__sentence"><%= t(".pulled_html", name: tag.strong(name), card: tag.strong(card.title)) %></p>
          <% end %>
          <%= link_to card_path(slug: card.id), class: class_names("feed__thumb", "feed__thumb--framed feed__thumb--#{card.rarity}": repost),
                aria: { label: card.title }, data: { turbo_prefetch: false } do %>
            <%= render CardComponent.new(card:, size: :s) %>
          <% end %>
          <% if repost %>
            <span class="feed__tag feed__tag--repost"><%= t(".repost_tag") %></span>
          <% else %>
            <span class="feed__tag feed__tag--<%= card.rarity %>">
              <%= pixel_icon("rarity-#{tier}", class: "feed__tag-icon") %>
              <span><%= t("catalog.rarity.#{Catalog::Rarity::TIERS.fetch(tier)}") %></span>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
