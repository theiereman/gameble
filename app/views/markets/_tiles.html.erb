<%# locals: (rows:, marks: ListingMarks::NONE, stands: {}, buyable: false) %>
<% rows.each do |row| %>
  <% if row.is_a?(Game::Market::ArchiveOffers::Row) %>
    <%= render "market/shops/offer", row:, marks:, buyable:, stock: false, tile_id: false %>
  <% else %>
    <%= render "markets/tile", row:, marks:, stand: stands[row.token] %>
  <% end %>
<% end %>
