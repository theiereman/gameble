<%# locals: (title:, current:, pulse:, desk:, suspended:, content:, data: {}) %>
<%= turbo_frame_tag "market-tab", target: "_top", data: { controller: "market-tab", action: "turbo:frame-load->market-tab#arrive" } do %>
  <%= tag.section class: "market-screen page page--wide", aria: { labelledby: "market-screen-heading" }, data: { market_tab_target: "screen", title: }.merge(data) do %>
    <%= render "markets/desk", pulse:, desk:, suspended: %>
    <% if suspended %><%= render "market/suspended_banner" %><% end %>
    <% if desk %>
      <%= render "markets/mine", desk: %>
    <% end %>
    <% if market_exchange_shown? %><%= render "markets/exchange_preview" %><% end %>
    <% if @shop_offers %><%= render "markets/shop_panel", count: @shop_count, offers: @shop_offers, marks: @shop_marks, buyable: @buyable, caps: @caps %><% end %>
    <% if @wanted_copies %><%= render "markets/wanted_panel", copies: @wanted_copies, tiles: @wanted_tiles, cards: @wanted_cards %><% end %>
    <%= render "markets/chips", current: %>
    <div class="tabs__panel">
      <%= content %>
    </div>
  <% end %>
<% end %>
