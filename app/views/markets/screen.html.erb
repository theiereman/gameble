<% content_for :public_page, true unless current_player %>
<% content_for :title, t(".heading") %>
<% tab = capture do %>
<%= render "markets/shop_panel", count: @shop_count, offers: @shop_offers, marks: @shop_marks, buyable: @buyable %>
<%= render "markets/filters", filters: @filters, options: @options, sort: @sort, wanted_count: @wanted_count %>

<% if @pulse.soonest.any? && !@filters.any? %>
  <section class="market-soon" aria-labelledby="market-soon-heading">
    <h2 id="market-soon-heading" class="market-screen__section">
      <%= t(".soon_heading") %> <span class="market-screen__section-note"><%= t(".soon_note") %></span>
    </h2>
    <ul class="market-soon__list" aria-label="<%= t(".soon_label") %>">
      <% @pulse.soonest.each do |row| %><%= render "markets/soon", row: %><% end %>
    </ul>
  </section>
<% end %>

<% if @listings.rows.empty? %>
  <%= render "markets/empty", filters: @filters, sort: @sort, searched: @searched, buyable: @buyable %>
<% else %>
  <h2 class="market-screen__section">
    <%= @filters.any? ? t(".found_heading") : t(".all_heading") %>
    <span class="market-screen__section-note"><%= @filters.any? ? market_found_note(@found, @found_offers) : number_with_delimiter(@pulse.open) %></span>
  </h2>
  <% if @searched %>
    <div class="market-searched">
      <p class="market-searched__line"><%= t(".no_player_listing", card: @searched.title) %></p>
      <%= render "markets/order_prompt", card: @searched, buyable: @buyable %>
    </div>
  <% end %>
  <ul id="market-tiles" class="market-screen__tiles" aria-label="<%= t(".list_label") %>">
    <%= render "markets/tiles", rows: @listings.rows, marks: @marks, stands: @stands, buyable: @buyable %>
  </ul>
<% end %>
<%= render "markets/pages", listings: @listings, sort: @sort, page: @page, filters: @filters %>
<%= render "market/shops/dialog" if @buyable %>
<% end %>
<%= render "exchanges/tabs", current: :market %>
<%= render "markets/tab", title: content_for(:title), current: :listings, pulse: @pulse, desk: @desk, suspended: @suspended,
      data: { controller: "next-page purchase-dialog", action: "focusout->next-page#focusLeft" }, content: tab %>
