<% content_for :public_page, true unless current_player %>
<% content_for :title, t(".heading") %>
<% tab = capture do %>
<div class="market-screen__bar">
  <%= render "markets/chips", current: :listings %>
  <%= render "markets/sorts", sort: @sort, filters: @filters %>
</div>

<%= render "markets/filters", filters: @filters, options: @options, sort: @sort %>

<% if @pulse.soonest.any? && !@filters.any? %>
  <section class="market-soon" aria-labelledby="market-soon-heading">
    <h2 id="market-soon-heading" class="market-screen__section">
      <%= t(".soon_heading") %> <span class="market-screen__section-note"><%= t(".soon_note") %></span>
    </h2>
    <ul class="market-soon__list" aria-label="<%= t(".soon_label") %>">
      <% @pulse.soonest.each do |row| %><%= render "markets/soon", row: %><% end %>
    </ul>
  </section>
<% end %>

<% if @listings.rows.empty? %>
  <%= render "markets/empty", filters: @filters, sort: @sort %>
<% else %>
  <h2 class="market-screen__section">
    <%= @filters.any? ? t(".found_heading") : t(".all_heading") %>
    <span class="market-screen__section-note"><%= number_with_delimiter(@filters.any? ? @found : @pulse.open) %></span>
  </h2>
  <ul id="market-tiles" class="market-screen__tiles" aria-label="<%= t(".list_label") %>">
    <%= render "markets/tiles", rows: @listings.rows %>
  </ul>
<% end %>
<%= render "markets/pages", listings: @listings, sort: @sort, page: @page, filters: @filters %>
<% end %>
<%= render "markets/tab", title: content_for(:title), pulse: @pulse, desk: @desk, suspended: @suspended, commission_rate: @commission_rate,
      data: { controller: "next-page", action: "focusout->next-page#focusLeft" }, content: tab %>
