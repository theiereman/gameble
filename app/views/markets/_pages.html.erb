<%# locals: (listings:, sort:, page:, filters:) %>
<% if listings.more %>
  <nav id="market-pages" class="market-screen__pages" aria-label="<%= t("markets.screen.pages_label") %>" data-next-page-target="pages">
    <%= render ButtonComponent.new(variant: :link, href: market_filtered_path(filters, sort:, page: page + 1), rel: :next) do %><%= t("markets.screen.more") %><% end %>
  </nav>
<% else %>
  <nav id="market-pages" class="market-screen__pages" hidden></nav>
<% end %>
