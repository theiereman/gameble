<%= turbo_stream.append "market-tiles" do %>
  <%= render "markets/tiles", rows: @listings.rows, marks: @marks, stands: @stands, buyable: @buyable %>
<% end %>
<%= turbo_stream.replace "market-pages", partial: "markets/pages", locals: { listings: @listings, sort: @sort, page: @page, filters: @filters } %>
