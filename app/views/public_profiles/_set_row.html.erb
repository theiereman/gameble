<%# A set progress row of a player's profile (DESIGN.md, Set progress row),
    read-only: the same row as the collection's, with the owner's progress,
    and "Complete" read for a set they finished. Locals:
    - href, label, owned, total;
    - current: whether it is the set shown (default: false). %>
<% complete = total.positive? && owned == total %>
<%= link_to href, class: "set-row", aria: { current: ("page" if local_assigns[:current]) }, data: { turbo_prefetch: false } do %>
  <span class="set-row__name"><%= label %></span>
  <span class="<%= class_names("set-row__count", "set-row__count--complete": complete) %>" aria-hidden="true"><%= number_with_delimiter(owned) %>/<%= number_with_delimiter(total) %></span>
  <span class="visually-hidden"><%= t("public_profiles.show.progress", count: owned, owned: number_with_delimiter(owned), total: number_with_delimiter(total)) %><% if complete %> · <%= t("public_profiles.show.complete") %><% end %></span>
  <progress class="set-row__bar" value="<%= owned %>" max="<%= [ total, 1 ].max %>" aria-hidden="true"></progress>
<% end %>
