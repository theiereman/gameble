<%# locals: (owner:, started_sets:) %>
<section class="profile-section" aria-labelledby="profile-sets-heading">
  <div class="profile-section__head">
    <h2 id="profile-sets-heading" class="profile-section__title"><%= t("public_profiles.show.sets.title") %></h2>
    <p class="profile-section__aside"><%= t("public_profiles.show.sets.started", count: started_sets.size) %></p>
  </div>
  <% if started_sets.any? %>
    <ul class="profile-sets">
      <% started_sets.each do |row| %>
        <li><%= render "library/set_progress_row", href: brother_set_path(owner.token, kind: row.set.kind, key: row.set.key), set: row.set, standing: row.standing %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="profile-section__action">
    <%= render ButtonComponent.new(variant: :secondary, href: brother_collection_path(owner.token)) do %><%= t("public_profiles.show.sets.full_collection") %><% end %>
  </div>
</section>
