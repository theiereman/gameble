<%# locals: (owner:, started_sets:, started_set_count:) %>
<section class="profile-section" aria-labelledby="profile-sets-heading">
  <div class="profile-section__head">
    <h2 id="profile-sets-heading" class="profile-section__title"><%= t("public_profiles.show.sets.title") %></h2>
    <p class="profile-section__aside"><%= t("public_profiles.show.sets.started", count: started_set_count) %></p>
  </div>
  <% if started_sets.any? %>
    <ul class="profile-sets set-tiles">
      <% started_sets.each do |tile| %>
        <li><%= render "library/set_progress_tile", href: brother_set_path(owner.token, kind: tile.set.kind, key: tile.set.key), tile:, last_gained: false %></li>
      <% end %>
    </ul>
  <% end %>
  <div class="profile-section__action">
    <%= render ButtonComponent.new(variant: :secondary, href: brother_collection_path(owner.token)) do %><%= t("public_profiles.show.sets.full_collection") %><% end %>
  </div>
</section>
