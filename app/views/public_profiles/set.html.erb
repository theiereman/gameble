<% set_name = SetLabel.for(@set) %>
<% owner_name = public_profile_title(@owner) %>
<% content_for :back_button, true %>
<% content_for :phone_back do %><%= phone_back_link t("shell.screens.collection"), brother_collection_path(token: @owner.token) %><% end %>
<% content_for :title, t("public_profiles.set.title", set: set_name, name: owner_name) %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= render "library/album", standing: @standing, heading: t("public_profiles.set.heading", set: set_name, name: owner_name),
  slots: @album_slots, pagy: @album_pagy, filters: @album_filters, context: { set_kind: @set.kind, set_key: @set.key, brother: @owner.token } %>
