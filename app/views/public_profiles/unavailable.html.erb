<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= render PanelComponent.new(tag: :section, quiet: true, class: "profile-unavailable", aria: { labelledby: "profile-unavailable-heading" }) do %>
  <%= pixel_icon("avatar-default", class: "profile-unavailable__avatar") %>
  <h1 id="profile-unavailable-heading" class="profile-unavailable__title"><%= t(".title") %></h1>
  <p class="profile-unavailable__body"><%= t(".body") %></p>
<% end %>
