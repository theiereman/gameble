<% view = @detail.view %>
<% title = shared_card_title(view) %>
<% owner_title = public_profile_title(@owner) %>
<% token = @owner.token %>
<% content_for :back_button, true %>
<% content_for :title, title %>
<% content_for :head do %>
  <%= render "public_profiles/share_tags", title:,
    url: public_url_for(brother_card_season_path(token, slug: view.id, number: view.season_number)) %>
<% end %>
<%# A card shared from a player's collection (CAP-9; EXPERIENCE Flow 1): its
    detail first, said to come from the owner's collection (or no longer
    there), never with the viewer's copies; for a visitor, an invitation to
    open packs too; then the owner's profile. Its sets lead to the owner's
    tomes, only in the published season. %>
<div class="shared-card">
  <%= render "cards/detail", detail: @detail, copies: nil, owner: owner_title, owner_holds: @owner_holds, share_url: nil,
    set_url: (->(set) { brother_set_path(token, kind: set.kind, key: set.key) } if @detail.current_season) %>
  <% unless current_player %>
    <section class="shared-card__invitation" aria-label="<%= t(".invitation") %>">
      <%= render TextPlateComponent.new(tag: :p) do %><%= t(".invitation") %><% end %>
      <%# Signing in from here lands in the attic, where the packs wait. %>
      <%= render ButtonComponent.new(href: "/auth/steam", method: :post, params: { origin: home_path }, turbo: false) do %><%= t(".sign_in") %><% end %>
    </section>
  <% end %>
  <%= render "public_profiles/profile", owner: @owner, title: owner_title, summary: @summary, kind: @kind, spines: @spines,
    pagy: @pagy, heading: :h2 %>
</div>
