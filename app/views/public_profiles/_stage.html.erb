<%# locals: (cards:, context:, owned: false) %>
<% strings = CardStrings.new %>
<% top = cards.first %>
<% tier = Catalog::Rarity::TIERS.key(top.rarity.to_sym) %>
<%= tag.section class: [ "profile-stage", "profile-stage--#{cards.size}" ], aria: { labelledby: "profile-stage-heading" } do %>
  <h2 id="profile-stage-heading" class="profile-stage__kicker"><span class="profile-stage__light" aria-hidden="true"></span><%= t("public_profiles.show.showcase.title") %></h2>
  <div class="profile-stage__floor">
    <span class="profile-stage__rays" aria-hidden="true"><%= card_rays(top.rarity) %></span>
    <ol class="profile-stage__fan">
      <% cards.each_with_index do |card, index| %>
        <%= tag.li class: [ "profile-stage__slot", "profile-stage__slot--#{index + 1}", ("profile-stage__slot--top" if index.zero?) ] do %>
          <%= link_to_card_detail(card, strings:, context:) do %>
            <%= render CardComponent.new(card:, size: :grid) %>
          <% end %>
        <% end %>
      <% end %>
    </ol>
  </div>
  <p class="profile-stage__name"><%= top.title %></p>
  <p class="profile-stage__rarity profile-stage__rarity--<%= tier %>">
    <%= pixel_icon("rarity-#{tier}", class: "profile-stage__rarity-icon") %>
    <span><%= [ t("catalog.rarity.#{top.rarity}"), top.number_label ].join(" · ") %></span>
  </p>
  <% if owned %>
    <p class="profile-stage__aside"><%= t("public_profiles.show.stage.owner_note") %></p>
  <% end %>
<% end %>
