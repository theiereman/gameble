<%# locals: (owner:, title:, season:, summary:, card_total:, achievements:, relation:, owner_title: nil, editing: false) %>
<%= render PanelComponent.new(tag: :header, brackets: true, class: "profile-band") do %>
  <div class="profile-band__who">
    <% if editing %>
      <span class="profile-band__portrait">
        <%= player_avatar(owner, class_name: "profile-band__avatar") %>
        <%= tag.a(**bottom_sheet_opener("me-avatar-sheet", page: me_sheet_path(:avatar)).deep_merge(aria: { label: t("own_profiles.show.change_avatar") }),
              class: "profile-band__avatar-edit", autofocus: flash[:chosen_avatar].present?) do %>
          <%= pixel_icon("pencil", class: "profile-band__avatar-pencil") %>
        <% end %>
      </span>
    <% else %>
      <%= player_avatar(owner, class_name: "profile-band__avatar") %>
    <% end %>
    <div class="profile-band__identity">
      <%= content_tag :h1, title, id: "profile-heading", class: "profile-band__name" %>
      <%= active_title_tag(owner_title, class_name: "profile-band__title") %>
      <%= render "public_profiles/action", owner:, title:, relation: relation unless editing %>
      <p class="profile-band__meta">
        <span class="profile-band__since"><%= t("public_profiles.show.member_since", date: l(owner.created_at.to_date, format: :month_year)) %></span>
        <% if owner.banned? %>
          <span class="profile-band__banned"><%= t("public_profiles.show.banned") %></span>
        <% end %>
        <% if current_player.nil? %>
          <%= render ButtonComponent.new(variant: :link, size: :small, disabled: true) do %><%= t("reports.open") %><% end %>
        <% elsif current_player != owner %>
          <%= render ButtonComponent.new(variant: :link, size: :small, opens: "report-dialog") do %><%= t("reports.open") %><% end %>
        <% end %>
      </p>
    </div>
  </div>
  <dl class="profile-band__keys">
    <%= render "public_profiles/figure", label: t("public_profiles.show.keys.cards"), value: summary.distinct_cards, total: (card_total if season) %>
    <%= render "public_profiles/figure", label: t("public_profiles.show.keys.complete_sets"), value: summary.complete_sets %>
    <%= render "public_profiles/figure", label: t("public_profiles.show.keys.achievements"), value: achievements.count, total: achievements.total %>
  </dl>
<% end %>
