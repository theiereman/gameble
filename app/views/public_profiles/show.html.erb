<% title = public_profile_title(@owner) %>
<% content_for :back_button, true %>
<% content_for :title, title %>
<% content_for :screen_title, title %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<% editing = { titles: @titles, card_backs: @card_backs, name_editable: @name_editable } if @titles %>
<%= render "public_profiles/profile", owner: @owner, title:, season: @season, summary: @summary, card_total: @card_total,
  achievements: @achievements, rarities: @rarities, activity: @activity, started_sets: @started_sets, started_set_count: @started_set_count,
  showcase: @showcase, relation: @relation, open_trade_token: @open_trade_token, owner_title: @owner_title, editing: %>
