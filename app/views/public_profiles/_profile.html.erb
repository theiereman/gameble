<%# locals: (owner:, title:, season:, summary:, card_total:, achievements:, rarities:, activity:, started_sets:, showcase:) %>
<section class="profile" aria-labelledby="profile-heading">
  <%= render "public_profiles/summary", owner:, title:, season:, summary:, card_total:, achievements: achievements %>
  <%= render "public_profiles/showcase", owner:, cards: showcase if showcase.any? %>
  <% if season.nil? %>
    <%= render PanelComponent.new(tag: :p, class: "profile__no-season") do %><%= t("public_profiles.show.no_season") %><% end %>
  <% else %>
    <%= render "public_profiles/stats", rarities:, activity: activity %>
    <%= render "public_profiles/achievements", achievements: achievements %>
    <%= render "public_profiles/sets", owner:, started_sets: started_sets %>
  <% end %>
</section>
<%= render "reports/dialog", owner: owner if current_player && current_player != owner %>
