<%# A player's public profile (CAP-8; DESIGN.md, Collection, in read-only
    mode): their summary, and their sets as the collection lists them, open
    on the tab given. Locals:
    - owner: the profile's player;
    - title: the profile's title (public_profile_title);
    - summary: the owner's Game::CollectionSummary;
    - kind, spines, pagy: the sets, as ShelfLoading loads them. %>
<section class="profile" aria-labelledby="profile-heading">
  <%= render "public_profiles/summary", owner:, title: title, summary: summary %>
  <div class="collection">
    <aside class="collection__aside" aria-labelledby="collection-sets-title">
      <%= render "public_profiles/set_list", kind:, set: nil, spines:, pagy:, links: profile_shelf_links(owner.token, kind) %>
    </aside>
    <section class="collection__main profile__pick" aria-label="<%= t("library.sets.title") %>">
      <% if spines.present? %>
        <p class="profile__hint"><%= t("public_profiles.show.pick") %></p>
      <% end %>
    </section>
  </div>
</section>
<%= render "reports/dialog", owner: owner if current_player && current_player != owner %>
