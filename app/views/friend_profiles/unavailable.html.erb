<% content_for :back_button, true %>
<% content_for :title, t("public_profiles.unavailable.title") %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= turbo_frame_tag friend_profile_frame_id(params[:token]), target: "_top" do %>
  <section class="friend-profile friend-profile--unavailable">
    <h2 class="friend-profile__name"><%= t("public_profiles.unavailable.title") %></h2>
    <p class="friend-profile__empty"><%= t(".body") %></p>
  </section>
<% end %>
