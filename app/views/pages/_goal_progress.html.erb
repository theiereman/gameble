<% segments = GoalHelper::SEGMENTS %>
<% lit = goal_lit_segments(goal) %>
<% figures = { total: number_with_delimiter(goal[:total]), target: number_with_delimiter(goal[:target]) } %>
<div id="community-goal-progress" class="hub-goal__progress<%= " hub-goal__progress--reached" if goal[:reached] %>">
  <div class="hub-goal__about">
    <h2 id="community-goal-title" class="hub-goal__title"><%= t("pages.home.goal.title") %></h2>
    <p class="hub-goal__line"><%= t("pages.home.goal.line", target: figures[:target]) %></p>
  </div>
  <div class="hub-goal__meter">
    <p class="hub-goal__figures" aria-hidden="true"><%= figures[:total] %> / <%= figures[:target] %></p>
    <span class="visually-hidden"><%= t("pages.home.goal.progress", **figures) %></span>
    <div class="hub-goal__gauge" aria-hidden="true">
      <% segments.times do |index| %><span class="hub-goal__segment<%= " hub-goal__segment--lit" if index < lit %>"></span><% end %>
    </div>
  </div>
  <div class="hub-goal__prize">
    <% if goal[:reached] %>
      <p class="hub-goal__reward"><span class="hub-goal__status"><%= t("pages.home.goal.reached") %></span> · <%= t("pages.home.goal.reward_text") %></p>
    <% else %>
      <p class="hub-goal__reward"><%= t("pages.home.goal.reward", reward: t("pages.home.goal.reward_text")) %></p>
    <% end %>
  </div>
  <% if (previous = goal[:previous]) %>
    <% previous_figures = { total: number_with_delimiter(previous[:total]), target: number_with_delimiter(previous[:target]) } %>
    <p class="hub-goal__previous"><%= previous[:reached] ? t("pages.home.goal.previous_reached", **previous_figures) : t("pages.home.goal.previous_missed", **previous_figures) %></p>
  <% end %>
</div>
