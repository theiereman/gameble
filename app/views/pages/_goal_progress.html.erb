<% segments = GoalHelper::SEGMENTS %>
<% lit = goal_lit_segments(goal) %>
<div id="community-goal-progress" class="hub-goal__progress">
  <h2 id="community-goal-title" class="hub-goal__title"><%= t("pages.home.goal.title") %></h2>
  <% if goal[:reached] %><p class="hub-goal__status"><%= t("pages.home.goal.reached") %></p><% end %>
  <p class="hub-goal__line"><%= t("pages.home.goal.line", target: number_with_delimiter(goal[:target])) %></p>
  <div class="hub-goal__count">
    <p class="hub-goal__label"><%= t("pages.home.goal.players") %></p>
    <p class="hub-goal__figures" aria-hidden="true"><%= number_with_delimiter(goal[:total]) %> / <%= number_with_delimiter(goal[:target]) %></p>
    <span class="visually-hidden"><%= t("pages.home.goal.progress", total: number_with_delimiter(goal[:total]), target: number_with_delimiter(goal[:target])) %></span>
  </div>
  <div class="hub-goal__gauge" aria-hidden="true">
    <% segments.times do |index| %><span class="hub-goal__segment<%= " hub-goal__segment--lit" if index < lit %>"></span><% end %>
  </div>
  <p class="hub-goal__reward-label"><%= t("pages.home.goal.reward") %></p>
  <p class="hub-goal__reward"><%= t("pages.home.goal.reward_text") %></p>
  <% if (previous = goal[:previous]) %>
    <% figures = { total: number_with_delimiter(previous[:total]), target: number_with_delimiter(previous[:target]) } %>
    <p class="hub-goal__previous"><%= previous[:reached] ? t("pages.home.goal.previous_reached", **figures) : t("pages.home.goal.previous_missed", **figures) %></p>
  <% end %>
</div>
