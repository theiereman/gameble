<%# Menu 03, "Toutes les cartes" (see pages/_menu): a link to the catalog of
    every card. %>
<li class="hub-menu__entry">
  <%= link_to library_cards_path, class: "menu-item", aria: { keyshortcuts: "3" },
        data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
    <span class="menu-item__number" aria-hidden="true">03</span>
    <span class="menu-item__label"><%= t("pages.home.menu.all_cards") %></span>
    <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
  <% end %>
</li>
