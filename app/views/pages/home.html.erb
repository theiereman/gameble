<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render TextPlateComponent.new(tag: :p) do %>
    <%= t(".intro") %>
  <% end %>

  <div>
    <%= render ButtonComponent.new(variant: :primary, href: home_path) do %>
      <%= t(".enlist") %>
    <% end %>
    <%= render ButtonComponent.new(variant: :secondary, href: home_path) do %>
      <%= t(".linger") %>
    <% end %>
  </div>

  <%= turbo_mount("SampleIsland", props: {
    data: { season: 1 },
    strings: { heading: t(".island.heading"), season: t(".island.season") }
  }) %>
</div>
