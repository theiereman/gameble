<% turbo_exempts_page_from_cache %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% content_for :ticker do %>
  <%= render "shell/ticker", items: @ticker %>
<% end %>
<div class="hub" data-controller="hub-menu" data-hub-menu-focus-first-value="<%= flash[:signed_in].present? %>">
  <header class="hub__kicker">
    <h1 id="hub-title" class="hub__title" tabindex="-1" data-hub-menu-target="heading"><%= t(".kicker.title") %></h1>
  </header>

  <%= render "pages/welcome" if @welcome %>

  <%= render "pages/menu", bank: @bank, collection: @collection, friends_online: @friends_online, achievements: @achievements %>

  <span hidden data-controller="bonus-arc" data-action="turbo:before-stream-render@document->bonus-arc#render"></span>

  <%= render "pages/showcase", card: @showcase, chosen: @showcase_chosen, bank: @bank %>
  <div class="hub__aside">
    <%= render "pages/goal", goal: @goal, reward: @goal_reward, bank: @bank %>
    <%= render "pages/daily_booster", bank: @bank, primary: @showcase.present? if @bank[:bonus_collectable] || @bank[:bonus_collected] %>
  </div>

  <%= render "pages/set_progress", sets: @sets if @sets.any? %>
</div>
<%= turbo_stream_from(*LiveStream.goal_streamables) %>
