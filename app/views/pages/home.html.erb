<%# The attic (DESIGN.md "The attic", mockups/attic.html): one wide room drawn in
    CSS, its furniture named. The lectern leads to the library; the other
    objects lead nowhere yet, so they are not links. The chest holds the
    button that opens a pack, and the countdown to the next one. The page is
    never served from Turbo's cache, and the countdown refreshes it by
    morphing, keeping the scroll. %>
<% turbo_exempts_page_from_cache %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<h1 id="attic-heading" class="visually-hidden"><%= t(".heading") %></h1>

<div class="attic" data-controller="attic" data-action="turbo:before-morph-attribute->attic#keepTabStop" role="region" aria-labelledby="attic-heading">
  <div class="attic__room">
    <div class="attic__wall" aria-hidden="true"></div>
    <div class="attic__floor" aria-hidden="true"></div>
    <div class="attic__window" aria-hidden="true"></div>

    <%# The lectern: its art and name are one link to the library. %>
    <figure class="attic__object attic__object--lectern">
      <a class="attic__link" href="<%= library_path %>" data-turbo-prefetch="false">
        <div class="attic__art" aria-hidden="true"></div>
        <span class="attic__name"><%= t(".objects.lectern") %></span>
      </a>
    </figure>

    <% [
         [ :notice_board, t(".objects.notice_board") ],
         [ :medal_display, t(".objects.medal_display") ],
         [ :mirror, t(".objects.mirror") ],
         [ :trade_table, t(".objects.trade_table") ]
       ].each do |object, name| %>
      <figure class="attic__object attic__object--<%= object.to_s.dasherize %>">
        <div class="attic__art" aria-hidden="true"></div>
        <figcaption class="attic__name"><%= name %></figcaption>
      </figure>
    <% end %>

    <figure class="attic__object attic__object--chest" data-attic-target="chest">
      <div class="attic__art" aria-hidden="true"></div>
      <figcaption class="attic__name"><%= t(".objects.chest") %></figcaption>
      <%# Opens one pack at a time. A visitor's press leads to the sign-in (CAP-18). %>
      <div class="attic__chest-action">
        <% if @bank.nil? %>
          <%# A visitor's press starts the Steam sign-in and comes back here. %>
          <%= render ButtonComponent.new(href: "/auth/steam", method: :post, params: { origin: request.path }, turbo: false) do %><%= t(".chest.open_visitor") %><% end %>
        <% elsif @bank[:available].positive? %>
          <%= render ButtonComponent.new(href: packs_path, method: :post) do %><%= t(".chest.open", count: @bank[:available]) %><% end %>
        <% else %>
          <%= tag.button t(".chest.empty"), type: :button, class: "button button--secondary", disabled: true %>
        <% end %>
        <% if @next_pack_in %>
          <%# The ticking text is hidden from screen readers, which read the
              static time instead. At zero the page refreshes. %>
          <p class="attic__countdown" data-controller="countdown" data-countdown-seconds-value="<%= @next_pack_in %>">
            <span aria-hidden="true"><%= t(".countdown.label") %>
              <span data-countdown-target="clock"><%= format("%02d:%02d", *@next_pack_in.divmod(60)) %></span></span>
            <span class="visually-hidden"><%= t(".countdown.at", time: @bank[:next_available_at].utc.strftime("%H:%M")) %></span>
          </p>
        <% end %>
      </div>
    </figure>

    <%# The daily bonus panel (CAP-16): beside the chest, once per UTC day,
        gone once collected until a page load after midnight UTC. A visitor
        sees it whenever a season is published, its button starting the
        Steam sign-in. The view decides it in this local, from the bank
        summary (a player) or @season_published (a visitor). %>
    <% bonus_panel = @bank.present? ? @bank[:bonus_collectable] : @season_published %>
    <% if bonus_panel %>
      <section class="attic__bonus" aria-labelledby="attic-bonus-heading">
        <%= render TextPlateComponent.new do %>
          <h2 id="attic-bonus-heading" class="attic__bonus-heading"><%= t(".bonus.heading") %></h2>
          <p class="attic__bonus-text"><%= t(".bonus.text") %></p>
        <% end %>
        <% if @bank %>
          <%= render ButtonComponent.new(href: daily_bonus_path, method: :post) do %><%= t(".bonus.collect") %><% end %>
        <% else %>
          <%= render ButtonComponent.new(href: "/auth/steam", method: :post, params: { origin: request.path }, turbo: false) do %><%= t(".bonus.collect_visitor") %><% end %>
        <% end %>
      </section>
    <% end %>

    <% unless current_player %>
      <div class="attic__invitation">
        <%= render TextPlateComponent.new(tag: :p) do %>
          <%= t(".invitation") %>
        <% end %>
      </div>
    <% end %>

    <div class="attic__plaque">
      <%= turbo_mount("SampleIsland", props: {
        data: { season: 1 },
        strings: { heading: t(".island.heading"), season: t(".island.season") }
      }) %>
    </div>
  </div>
</div>
