<% content_for :title, t(".title") %>
<%# The phone's PLUS tab: menu-item rows, without numbers, for the screens
    that are not tabs, under the kicker and "Le reste du vaisseau".
    Toutes les cartes, first, opens the catalog of every card; Amis and
    Succès open their screens; Fil d'activité opens the feed; Comment ça
    marche opens the rules of the game; Paramètres the settings;
    Soutenir, last, opens the donation page in a new tab; the tab bar
    only shows on the phone, and the screen reads the same on a desktop
    that opens its address. %>
<% turbo_exempts_page_from_cache %>
<section class="plus" aria-labelledby="plus-heading">
  <header class="hub__kicker">
    <h1 id="plus-heading" class="hub__title"><%= t("pages.home.kicker.title") %></h1>
    <p class="hub__subtitle"><%= t(".subtitle") %></p>
  </header>
  <ul class="plus__list">
    <li>
      <%= link_to library_cards_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.all_cards") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to friends_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.friends") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to feed_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.feed") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to achievements_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.achievements") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to how_it_works_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.how_it_works") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to settings_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t(".settings") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= donation_menu_item_to t("pages.home.menu.support"), class: "menu-item menu-item--plus" %>
    </li>
  </ul>
</section>
