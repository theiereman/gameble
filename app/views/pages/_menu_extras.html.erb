<ol id="hub-menu-extras" class="hub-menu__list" aria-label="<%= t("pages.home.menu.extras_label") %>" hidden data-hub-menu-target="extras">
  <li class="hub-menu__entry">
    <button type="button" class="menu-item menu-item--back" aria-keyshortcuts="Escape" data-hub-menu-target="back" data-action="hub-menu#closeExtras">
      <%= pixel_icon("arrow-left", class: "menu-item__back") %>
      <span class="menu-item__label"><%= t("pages.home.menu.extras_back") %></span>
    </button>
  </li>
  <li class="hub-menu__entry">
    <%= link_to how_it_works_path, class: "menu-item", aria: { keyshortcuts: "1" },
          data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
      <span class="menu-item__number" aria-hidden="true">01</span>
      <span class="menu-item__label"><%= t("pages.home.menu.how_it_works") %></span>
      <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
    <% end %>
  </li>
  <li class="hub-menu__entry">
    <%= link_to fortune_register_path, class: "menu-item", aria: { keyshortcuts: "2" },
          data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
      <span class="menu-item__number" aria-hidden="true">02</span>
      <span class="menu-item__label"><%= t("pages.home.menu.register") %></span>
      <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
    <% end %>
  </li>
  <li class="hub-menu__entry">
    <%= donation_menu_item_to t("pages.home.menu.support"), number: "03", class: "menu-item",
          aria: { keyshortcuts: "3" }, data: { hub_menu_target: "item" } %>
  </li>
  <li class="hub-menu__entry">
    <%= source_code_menu_item_to t("pages.home.menu.source_code"), number: "04", class: "menu-item",
          aria: { keyshortcuts: "4" }, data: { hub_menu_target: "item" } %>
  </li>
  <li class="hub-menu__entry">
    <%= community_menu_item_to t("pages.home.menu.community"), number: "05", class: "menu-item",
          aria: { keyshortcuts: "5" }, data: { hub_menu_target: "item" } %>
  </li>
</ol>
