<%# The hub's numbered menu (DESIGN.md, Menu item; EXPERIENCE.md, Menu
    item): keys 1 to 6 open an item while focus is inside the menu
    (hub_menu_controller.ts). 01 opens the booster screen (for a player, a
    link with the reserve as a lime badge, greyed at zero; for a visitor,
    the sign-in panel); 02 opens the collection, with the unique
    cards owned out of the season's; 03 opens the trades screen, with the
    trades waiting for the player as an orange badge, and 04 the Friends
    screen, with how many friends are online (for a visitor, each the
    sign-in panel); 05 opens the public feed; 06 has no screen yet.
    Hidden on the phone, where the tab bar navigates. %>
<nav class="hub-menu" aria-label="<%= t("pages.home.menu.label") %>" data-hub-menu-target="menu" data-action="keydown->hub-menu#press">
  <% arrow = pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
  <ol class="hub-menu__list">
    <%= render "pages/menu_booster", bank: bank %>
    <li class="hub-menu__entry">
      <%= link_to library_path, class: "menu-item", aria: { keyshortcuts: "2" },
            data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
        <span class="menu-item__number" aria-hidden="true">02</span>
        <span class="menu-item__label"><%= t("pages.home.menu.collection") %></span>
        <% if collection %>
          <span class="menu-item__meta" aria-hidden="true"><%= number_with_delimiter(collection[:owned]) %>/<%= number_with_delimiter(collection[:total]) %></span>
          <span class="visually-hidden"><%= t("pages.home.menu.collection_meta", count: collection[:owned], owned: number_with_delimiter(collection[:owned]), total: number_with_delimiter(collection[:total])) %></span>
        <% end %>
        <%= arrow %>
      <% end %>
    </li>
    <% [ [ :trades, 3 ], [ :friends, 4 ], [ :feed, 5 ], [ :achievements, 6 ] ].each do |item, position| %>
      <% if item == :trades %>
        <%= render "pages/menu_trades", waiting: (shell_trades_waiting unless bank.nil?) %>
      <% elsif item == :friends %>
        <%= render "pages/menu_friends", signed_in: !bank.nil?, online: local_assigns[:friends_online] %>
      <% elsif item == :feed %>
        <%= render "pages/menu_feed" %>
      <% else %>
        <li class="hub-menu__entry">
          <span class="menu-item" aria-disabled="true" aria-keyshortcuts="<%= position %>">
            <span class="menu-item__number" aria-hidden="true"><%= format("%02d", position) %></span>
            <span class="menu-item__label"><%= t("pages.home.menu.#{item}") %></span>
            <span class="visually-hidden"><%= t("pages.home.menu.soon") %></span>
          </span>
        </li>
      <% end %>
    <% end %>
  </ol>
</nav>
