<%# The hub's numbered menu (DESIGN.md, Menu item; EXPERIENCE.md, Menu
    item): keys 1 to 6 open an item while focus is inside the menu
    (hub_menu_controller.ts). 01 opens a booster (a player's open-pack form,
    with the reserve as a lime badge, greyed and disabled at zero; for a
    visitor, the sign-in panel); 02 opens the collection, with the unique
    cards owned out of the season's; 03 to 06 have no screen yet. Hidden on
    the phone, where the tab bar navigates. %>
<% soon = %i[trades friends feed achievements] %>
<nav class="hub-menu" aria-label="<%= t("pages.home.menu.label") %>" data-hub-menu-target="menu" data-action="keydown->hub-menu#press">
  <ol class="hub-menu__list">
    <li class="hub-menu__entry">
      <% head = capture do %><span class="menu-item__number" aria-hidden="true">01</span><span class="menu-item__label"><%= t("pages.home.menu.open_booster") %></span><% end %>
      <% arrow = pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% if bank.nil? %>
        <%= tag.button type: :button, class: "menu-item", aria: { haspopup: "dialog", keyshortcuts: "1" },
              data: { hub_menu_target: "item", controller: "dialog-opener", action: "dialog-opener#open", dialog_opener_dialog_value: "sign-in-panel" } do %>
          <%= head %><%= arrow %>
        <% end %>
      <% elsif bank[:available].positive? %>
        <%= button_to packs_path, method: :post, class: "menu-item", form_class: "menu-item__form",
              aria: { keyshortcuts: "1" }, data: { hub_menu_target: "item", action: "hub-menu#remember" } do %>
          <%= head %>
          <span class="menu-item__badge" aria-hidden="true"><%= number_with_delimiter(bank[:available]) %></span>
          <span class="visually-hidden"><%= t("pages.home.menu.reserve", count: bank[:available], number: number_with_delimiter(bank[:available])) %></span>
          <%= arrow %>
        <% end %>
      <% else %>
        <span class="menu-item" aria-disabled="true" aria-keyshortcuts="1">
          <%= head %>
          <span class="menu-item__badge" aria-hidden="true">0</span>
          <span class="visually-hidden"><%= t("pages.home.menu.reserve_empty") %></span>
        </span>
      <% end %>
    </li>
    <li class="hub-menu__entry">
      <%= link_to library_path, class: "menu-item", aria: { keyshortcuts: "2" },
            data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
        <span class="menu-item__number" aria-hidden="true">02</span>
        <span class="menu-item__label"><%= t("pages.home.menu.collection") %></span>
        <% if collection %>
          <span class="menu-item__meta" aria-hidden="true"><%= number_with_delimiter(collection[:owned]) %>/<%= number_with_delimiter(collection[:total]) %></span>
          <span class="visually-hidden"><%= t("pages.home.menu.collection_meta", count: collection[:owned], owned: number_with_delimiter(collection[:owned]), total: number_with_delimiter(collection[:total])) %></span>
        <% end %>
        <%= arrow %>
      <% end %>
    </li>
    <% soon.each.with_index(3) do |item, position| %>
      <li class="hub-menu__entry">
        <span class="menu-item" aria-disabled="true" aria-keyshortcuts="<%= position %>">
          <span class="menu-item__number" aria-hidden="true"><%= format("%02d", position) %></span>
          <span class="menu-item__label"><%= t("pages.home.menu.#{item}") %></span>
          <span class="visually-hidden"><%= t("pages.home.menu.soon") %></span>
        </span>
      </li>
    <% end %>
  </ol>
</nav>
