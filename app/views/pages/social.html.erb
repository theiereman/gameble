<% content_for :title, t(".title") %>
<% turbo_exempts_page_from_cache %>
<section class="plus" aria-labelledby="social-heading">
  <header class="hub__kicker">
    <h1 id="social-heading" class="hub__title"><%= t(".title") %></h1>
    <p class="hub__subtitle"><%= t(".subtitle") %></p>
  </header>
  <ul class="plus__list">
    <li>
      <%= link_to trades_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.trades") %></span>
        <span id="plus-trades-badge" class="stream-slot"><%= render "pages/menu_trades_badge", waiting: shell_trades_waiting %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to friends_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.friends") %></span>
        <span id="plus-friends-badge" class="stream-slot"><%= render "pages/menu_invitations_badge", invitations: shell_invitations_waiting %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
    <li>
      <%= link_to feed_path, class: "menu-item menu-item--plus", data: { turbo_prefetch: false } do %>
        <span class="menu-item__label"><%= t("pages.home.menu.feed") %></span>
        <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
      <% end %>
    </li>
  </ul>
</section>
