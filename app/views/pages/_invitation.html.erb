<%# The signed-out hub's invitation (DESIGN.md, Signed-out hub), in place of
    the showcase: the empty frame, the public page's two lines and the
    view's one primary button, which opens the sign-in panel. %>
<section class="hub-showcase hub-showcase--empty hub-invitation" aria-labelledby="hub-invitation-title">
  <div class="hub-showcase__stage">
    <span class="hub-showcase__frame" aria-hidden="true">
      <span class="hub-showcase__outline"><%= pixel_icon("logo", class: "hub-showcase__logo") %></span>
    </span>
  </div>
  <h2 id="hub-invitation-title" class="hub-invitation__title"><%= t("pages.home.invitation.title") %></h2>
  <p class="hub-showcase__line"><%= t("pages.home.invitation.text") %></p>
  <div class="hub-showcase__actions">
    <%= render ButtonComponent.new(opens: "sign-in-panel") do %><%= t("pages.home.invitation.open") %><% end %>
  </div>
</section>
