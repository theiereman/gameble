<%# locals: (inventory:) %>
<% found = inventory.found_count %>
<% total = inventory.total %>
<% latest = inventory.latest_discovery %>
<%= render PanelComponent.new(tag: :section, class: "grand-inventory-panel hub-linked", aria: { labelledby: "grand-inventory-panel-title" }) do %>
  <div class="grand-inventory-panel__head">
    <h2 id="grand-inventory-panel-title" class="hub-section-title">
      <%= link_to grand_inventory_path, class: "hub-linked__link" do %><%= t("pages.home.grand_inventory.title") %><%= chevron_icon(class: "hub-linked__arrow") %><% end %>
    </h2>
    <span class="grand-inventory-panel__count" aria-hidden="true"><%= number_with_delimiter(found) %> / <%= number_with_delimiter(total) %></span>
    <span class="visually-hidden"><%= t("pages.home.grand_inventory.spoken", count: found, found: number_with_delimiter(found), total: number_with_delimiter(total)) %></span>
  </div>
  <%= render GaugeComponent.new(lit: GaugeComponent.lit(found, total)) %>
  <% if latest&.card %>
    <p class="grand-inventory-panel__latest">
      <img class="grand-inventory-panel__thumb" src="<%= latest.card.image_url %>" alt="" width="32" height="32" loading="lazy" decoding="async">
      <span class="grand-inventory-panel__discovery">
        <span class="visually-hidden"><%= t("pages.home.grand_inventory.latest") %></span>
        <span class="grand-inventory-panel__game"><%= latest.card.title %></span>
        <span class="grand-inventory-panel__by"><%= t("pages.home.grand_inventory.by_html", player: render(PlayerNameComponent.new(player: latest.player, viewer: current_player, linked: false,
          supporters: Game::SupporterStatus.for_players([ latest.player ])))) %></span>
      </span>
      <time class="grand-inventory-panel__age" datetime="<%= latest.discovered_at.utc.iso8601 %>"><%= set_gained_ago(latest.discovered_at) %></time>
    </p>
  <% else %>
    <p class="grand-inventory-panel__empty"><%= t("pages.home.grand_inventory.empty") %></p>
  <% end %>
<% end %>
