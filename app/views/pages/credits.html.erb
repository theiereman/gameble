<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<article class="legal credits" aria-labelledby="credits-heading">
  <h1 id="credits-heading" class="legal__title"><%= t(".title") %></h1>

  <%= render PanelComponent.new(tag: :section, class: "legal__section", aria: { label: t(".list_label") }) do %>
    <p class="credits__intro"><%= t(".intro") %></p>
    <ul class="legal__list credits__list">
      <% %w[wikimasters helldivers balatro_dead_cells hearthstone].each do |work| %>
        <li class="credits__work">
          <strong class="credits__name"><%= t(".#{work}.name") %></strong>
          <span class="credits__inspired"><%= t(".#{work}.inspired") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= render PanelComponent.new(tag: :section, class: "legal__section", aria: { label: t(".contributors.label") }) do %>
    <h2 class="legal__heading"><%= t(".contributors.title") %></h2>
    <ul class="legal__list credits__list">
      <% Credits::CONTRIBUTORS.each do |handle, contribution| %>
        <li class="credits__person">
          <%= external_link_to handle, "https://github.com/#{handle}", class: "legal__link credits__handle" %>
          <span class="credits__contribution"><%= t(".contributors.#{contribution}") %></span>
        </li>
      <% end %>
    </ul>
    <p class="credits__rule"><%= t(".contributors.rule") %></p>
  <% end %>

  <%= render PanelComponent.new(tag: :section, class: "legal__section", aria: { label: t(".testers.label") }) do %>
    <h2 class="legal__heading"><%= t(".testers.title") %></h2>
    <ul class="legal__list credits__list">
      <% Credits::BETA_TESTERS.each do |name| %>
        <li class="credits__tester"><%= name %></li>
      <% end %>
    </ul>
  <% end %>
</article>
