<%# locals: (invitations:) %>
<% if invitations.positive? %>
  <span class="menu-item__badge menu-item__badge--friends" aria-hidden="true"><%= number_with_delimiter(invitations) %></span>
  <span class="visually-hidden"><%= t("pages.home.menu.invitations_waiting", count: invitations, number: number_with_delimiter(invitations)) %></span>
<% end %>
