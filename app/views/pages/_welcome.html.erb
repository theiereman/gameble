<%# The Brotherhood's welcome to a new player, shown once at the top of the
    hub in the panel style: the title, the message and one closing button.
    No modal and no animation, the hub stays usable under it. Closing
    answers in Turbo Stream, which removes the panel, and the hub's heading
    takes the focus (welcome_controller.ts); without JavaScript the hub
    reloads without it. %>
<%= render PanelComponent.new(tag: :section, id: "welcome-panel", class: "hub-welcome", aria: { labelledby: "welcome-title" },
      data: { controller: "welcome", action: "turbo:submit-end->welcome#closed", welcome_heading_value: "hub-title" }) do %>
  <h2 id="welcome-title" class="hub-welcome__title"><%= t("pages.home.welcome.title") %></h2>
  <div class="hub-welcome__message">
    <p class="hub-welcome__line"><%= t("pages.home.welcome.founders") %></p>
    <p class="hub-welcome__line"><%= t("pages.home.welcome.legacy") %></p>
    <p class="hub-welcome__line"><%= t("pages.home.welcome.collection") %></p>
    <p class="hub-welcome__line"><%= t("pages.home.welcome.wishes") %></p>
  </div>
  <%= render ButtonComponent.new(variant: :secondary, size: :small, href: welcome_path, method: :delete) do %><%= t("pages.home.welcome.close") %><% end %>
<% end %>
