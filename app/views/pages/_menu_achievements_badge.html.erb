<%# locals: (unclaimed:) %>
<% if unclaimed.positive? %>
  <span class="menu-item__badge menu-item__badge--alert" aria-hidden="true"><%= number_with_delimiter(unclaimed) %></span>
  <span class="visually-hidden"><%= t("pages.home.menu.rewards_waiting", count: unclaimed, number: number_with_delimiter(unclaimed)) %></span>
<% end %>
