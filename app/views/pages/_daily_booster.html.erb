<% arc = local_assigns.fetch(:arc, false) %>
<% state = bank[:bonus_collected] ? :collected : (bank[:reserve_full] ? :full : :ready) %>
<% seconds = daily_bonus_seconds(bank) %>
<%= render PanelComponent.new(tag: :section, quiet: true, id: "daily-booster", class: "daily-booster daily-booster--#{state}",
      aria: { labelledby: "daily-booster-title" },
      data: ({ bonus_arc_collected: "", bonus_arc_bank: bank_changed_json(bank) } if arc) || {}) do %>
  <div class="daily-booster__head">
    <h2 id="daily-booster-title" class="daily-booster__title"><%= t("pages.home.daily.title") %></h2>
    <p class="daily-booster__state daily-booster__state--<%= state %>"><%= t("pages.home.daily.#{state}") %></p>
  </div>
  <% case state %>
  <% when :collected %>
    <p class="daily-booster__text"><%= local_time_sentence(bank[:next_bonus_at]) { t("daily_bonuses.create.collected", time: it) } %></p>
    <div class="daily-booster__next" data-controller="countdown" data-countdown-seconds-value="<%= seconds %>" data-countdown-hours-value="true"
         data-countdown-total-value="<%= ShellHelper::DAY_SECONDS %>">
      <p class="daily-booster__next-label" aria-hidden="true"><%= t("pages.home.daily.next_in") %></p>
      <p class="daily-booster__clock" aria-hidden="true" data-countdown-target="clock"><%= format_clock(seconds) %></p>
      <progress class="daily-booster__bar" aria-hidden="true" max="<%= ShellHelper::DAY_SECONDS %>" value="<%= ShellHelper::DAY_SECONDS - seconds %>" data-countdown-target="bar"></progress>
      <span class="visually-hidden"><%= local_time_sentence(bank[:next_bonus_at]) { t("pages.home.daily.next_at", time: it) } %></span>
    </div>
  <% when :full %>
    <p class="daily-booster__text"><%= t("pages.home.daily.full_text") %></p>
    <%= render ButtonComponent.new(size: :small, disabled: true) do %><%= t("pages.home.daily.collect") %><% end %>
  <% else %>
    <p class="daily-booster__text"><%= t("pages.home.daily.text") %></p>
    <%= render ButtonComponent.new(variant: primary ? :primary : :secondary, size: :small, href: daily_bonus_path, method: :post) do %><%= t("pages.home.daily.collect") %><% end %>
  <% end %>
<% end %>
