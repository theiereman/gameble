<%# locals: (online:, invitations:) %>
<li class="hub-menu__entry">
  <%= link_to friends_path, class: "menu-item", aria: { keyshortcuts: "4" },
        data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
    <span class="menu-item__number" aria-hidden="true">04</span>
    <span class="menu-item__label"><%= t("pages.home.menu.friends") %></span>
    <% if online %>
      <span class="menu-item__meta"><%= t("pages.home.menu.friends_online", count: online, number: number_with_delimiter(online)) %></span>
    <% end %>
    <span id="menu-friends-badge" class="stream-slot"><%= render "pages/menu_invitations_badge", invitations: %></span>
    <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
  <% end %>
</li>
