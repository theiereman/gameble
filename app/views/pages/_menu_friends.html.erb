<%# Menu 04, "Amis" (see pages/_menu): for a player a link to the Friends
    screen, for a visitor a button opening the sign-in panel, as menu 01
    does. %>
<li class="hub-menu__entry">
  <% head = capture do %><span class="menu-item__number" aria-hidden="true">04</span><span class="menu-item__label"><%= t("pages.home.menu.friends") %></span><% end %>
  <% arrow = pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
  <% if signed_in %>
    <%= link_to friends_path, class: "menu-item", aria: { keyshortcuts: "4" },
          data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
      <%= head %><%= arrow %>
    <% end %>
  <% else %>
    <%= tag.button type: :button, class: "menu-item", aria: { haspopup: "dialog", keyshortcuts: "4" },
          data: { hub_menu_target: "item", controller: "dialog-opener", action: "dialog-opener#open", dialog_opener_dialog_value: "sign-in-panel" } do %>
      <%= head %><%= arrow %>
    <% end %>
  <% end %>
</li>
