<% reward = local_assigns[:reward] %>
<%= render PanelComponent.new(tag: :section, brackets: true, id: "community-goal", class: "hub-goal", aria: { labelledby: "community-goal-title" }) do %>
  <%= render "pages/goal_progress", goal: goal %>
  <%= render "pages/goal_reward", reward: reward, bank: local_assigns[:bank] if reward %>
<% end %>
