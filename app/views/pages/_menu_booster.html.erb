<li id="hub-menu-booster" class="hub-menu__entry">
  <%= link_to booster_path, class: "menu-item", aria: { keyshortcuts: "1" },
        data: { hub_menu_target: "item", action: "hub-menu#remember", turbo_prefetch: false } do %>
    <span class="menu-item__number" aria-hidden="true">01</span>
    <span class="menu-item__label"><%= t("pages.home.menu.open_booster") %></span>
    <% if bank[:available].positive? %>
      <span class="menu-item__badge menu-item__badge--standard" aria-hidden="true"><%= number_with_delimiter(bank[:available]) %></span>
      <span class="visually-hidden"><%= t("pages.home.menu.reserve", count: bank[:available], number: number_with_delimiter(bank[:available])) %></span>
    <% end %>
    <% if bank[:special].positive? %>
      <span class="menu-item__badge menu-item__badge--special" aria-hidden="true"><%= number_with_delimiter(bank[:special]) %></span>
      <span class="visually-hidden"><%= t("pages.home.menu.special", count: bank[:special], number: number_with_delimiter(bank[:special])) %></span>
    <% end %>
    <% if bank[:openable].zero? %>
      <span class="visually-hidden"><%= t("pages.home.menu.reserve_empty") %></span>
    <% end %>
    <%= pixel_icon("arrow-small-right", class: "menu-item__arrow") %>
  <% end %>
</li>
