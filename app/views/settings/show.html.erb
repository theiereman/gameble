<% content_for :back_button, true %>
<% content_for :title, t(".title") %>
<% content_for :screen_title, t(".title") %>
<% content_for :phone_back do %>
  <%= link_to more_path, class: "button button--secondary button--small top-bar__phone-back" do %>
    <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= t(".more") %></span>
  <% end %>
<% end %>
<%# Profil et paramètres (EXPERIENCE.md, Settings row; DESIGN.md, Profile and
    settings): a muted label on the left and a control on the right, one row
    each. LANGUE is two links to this screen in the other locale (a GET,
    read only); ANIMATIONS RÉDUITES is one form of three buttons (PATCH,
    a full page load so `html[data-motion]` is re-rendered); SE DÉCONNECTER
    is the sign-out. Export and the card-back picker come with their own
    stories. VISIBILITÉ DU PROFIL is a group of three buttons (one pressed)
    that apply at once (PATCH, a full page load); with trades open, PRIVÉ
    first opens the private dialog, since going private cancels them
    (without JavaScript it applies at once). COMPTE's danger button opens
    the delete dialog (accounts/_dialog). %>
<section class="settings" aria-labelledby="settings-heading">
  <h1 id="settings-heading" class="settings__title"><%= t(".title") %></h1>
  <%= render PanelComponent.new(brackets: true, class: "settings__panel") do %>
    <ul class="settings__list">
      <li class="settings-row">
        <p id="settings-language" class="settings-row__label"><%= t(".language.label") %></p>
        <div class="segmented" role="group" aria-labelledby="settings-language">
          <% { fr: "Français", en: "English" }.each do |locale, name| %>
            <%= link_to name, settings_path(locale:), class: "segmented__option", lang: locale, hreflang: locale,
                  aria: { current: ("true" if locale == I18n.locale) }, data: { turbo_prefetch: false } %>
          <% end %>
        </div>
      </li>

      <li class="settings-row">
        <p id="settings-visibility" class="settings-row__label"><%= t(".visibility.label") %></p>
        <%= form_with url: settings_visibility_path, method: :patch, class: "settings-row__form", data: { turbo: false } do %>
          <div class="segmented" role="group" aria-labelledby="settings-visibility">
            <% Accounts::Player.visibilities.each_key do |choice| %>
              <% confirm = choice == "private" && @visibility != choice && @open_trades.positive? %>
              <%= tag.button t(".visibility.#{choice}"), type: :submit, name: "visibility", value: choice, class: "segmented__option",
                    aria: { pressed: (@visibility == choice).to_s, haspopup: ("dialog" if confirm) },
                    data: ({ controller: "dialog-opener", action: "dialog-opener#open", dialog_opener_dialog_value: "private-dialog" } if confirm) %>
            <% end %>
          </div>
        <% end %>
      </li>

      <li class="settings-row">
        <p id="settings-motion" class="settings-row__label"><%= t(".motion.label") %></p>
        <%= form_with url: settings_path, method: :patch, class: "settings-row__form", data: { turbo: false } do %>
          <div class="segmented" role="group" aria-labelledby="settings-motion">
            <% { "system" => nil, "on" => true, "off" => false }.each do |choice, value| %>
              <%= tag.button t(".motion.#{choice}"), type: :submit, name: "reduced_motion", value: choice, class: "segmented__option",
                    aria: { pressed: (@reduced_motion == value).to_s } %>
            <% end %>
          </div>
        <% end %>
      </li>

      <li class="settings-row">
        <p id="settings-session" class="settings-row__label"><%= t(".session.label") %></p>
        <%= render ButtonComponent.new(variant: :secondary, size: :small, href: session_path, method: :delete, turbo: false) do %><%= t(".session.sign_out") %><% end %>
      </li>

      <li class="settings-row">
        <p id="settings-account" class="settings-row__label"><%= t(".account.label") %></p>
        <%= render ButtonComponent.new(variant: :danger, size: :small, opens: "delete-dialog") do %><%= t(".account.delete") %><% end %>
      </li>
    </ul>
  <% end %>
</section>
<%= render "accounts/dialog" %>
<% if @visibility != "private" && @open_trades.positive? %>
  <%= render "settings/private_dialog", open_trades: @open_trades %>
<% end %>
