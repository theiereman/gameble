<dialog id="private-dialog" class="modal" aria-labelledby="private-dialog-title" aria-describedby="private-dialog-text"
        data-controller="dialog" data-action="click->dialog#closeOnScrim">
  <%= render PanelComponent.new(brackets: true, class: "modal__panel") do %>
    <span class="modal__handle" aria-hidden="true"></span>
    <div class="modal__head">
      <p id="private-dialog-title" class="modal__title"><%= t("settings.private_dialog.title") %></p>
      <button type="button" class="modal__close" aria-label="<%= t("settings.private_dialog.close") %>" data-action="dialog#close">
        <%= pixel_icon("close", class: "modal__close-icon") %>
      </button>
    </div>
    <%= form_with url: settings_visibility_path, method: :patch, class: "private-dialog__form", data: { turbo: false } do %>
      <%= hidden_field_tag "visibility", "private", id: nil %>
      <p id="private-dialog-text" class="private-dialog__text"><%= t("settings.private_dialog.text", count: open_trades) %></p>
      <div class="private-dialog__actions">
        <%= tag.button t("settings.private_dialog.confirm"), type: :submit, class: "button button--primary" %>
        <%= tag.button t("settings.private_dialog.cancel"), type: :button, class: "button button--secondary", data: { action: "dialog#close" } %>
      </div>
    <% end %>
  <% end %>
</dialog>
