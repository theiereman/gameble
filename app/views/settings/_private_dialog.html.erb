<%= tag.dialog id: "private-dialog", class: "modal", open: shown, aria: { labelledby: "private-dialog-title", describedby: "private-dialog-text" },
      data: { controller: "dialog", action: "click->dialog#closeOnScrim" } do %>
  <%= render PanelComponent.new(brackets: true, class: "modal__panel") do %>
    <span class="modal__handle" aria-hidden="true"></span>
    <div class="modal__head">
      <p id="private-dialog-title" class="modal__title"><%= t("settings.private_dialog.title") %></p>
      <button type="submit" form="private-dialog-form" formmethod="dialog" class="modal__close" aria-label="<%= t("settings.private_dialog.close") %>" data-action="dialog#close">
        <%= pixel_icon("close", class: "modal__close-icon") %>
      </button>
    </div>
    <%= form_with url: settings_visibility_path, method: :patch, id: "private-dialog-form", class: "private-dialog__form", data: { turbo: false } do %>
      <%= hidden_field_tag "visibility", "private", id: nil %>
      <%= hidden_field_tag "confirmed_trades", open_trades, id: nil %>
      <p id="private-dialog-text" class="private-dialog__text"><%= t("settings.private_dialog.text", count: open_trades) %></p>
      <div class="private-dialog__actions">
        <%= tag.button t("settings.private_dialog.confirm"), type: :submit, class: "button button--primary" %>
        <%= tag.button t("settings.private_dialog.cancel"), type: :submit, formmethod: :dialog, class: "button button--secondary", data: { action: "dialog#close" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
