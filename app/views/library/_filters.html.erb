<%# The search and the FILTRES zone of the collection (DESIGN.md, Collection:
    Filter zone; EXPERIENCE.md, Filter zone, Search): one GET form, outside
    the frame that holds the grid so the field and the chips keep focus while
    the grid is replaced. The search is applied as the player types; the
    zone is a folded panel (open when a filter is on) with the count of
    active filters and, in it, groups of chips switched on or off: state,
    rarity, set (whole season only), genre; OR within a group, AND across.
    The chips are checkboxes, so the form works without JavaScript; the
    collection-filters controller submits on change and keeps the count.
    - kind, shelf: the list of sets, kept by the form;
    - grid: the Catalog::CollectionGrid (chosen values, genres);
    - states, states_asked: the states shown, and whether the player chose
      them (none chosen shows every slot);
    - spines: the sets listed beside the grid, offered as the set chips;
    - query: the text searched. %>
<% set_refs = (spines.map { Catalog::SetSlots::SetRef.new(kind: it.kind, key: it.key, params: nil) } + grid.chosen_sets).uniq { [ it.kind, it.key ] } %>
<% labelled_sets = spines.to_h { [ [ it.kind, it.key ], it.label ] } %>
<% chosen_set_keys = grid.chosen_sets.map { "#{it.kind}:#{it.key}" } %>
<% count = collection_filter_count(grid:, states:, states_asked:) %>
<% clear_path = collection_clear_path(kind:, shelf:, set:) %>
<%= form_with url: request.path, method: :get, class: "filters", html: { role: "search" }, data: {
  controller: "collection-filters", turbo_frame: "collection-results", turbo_action: "replace",
  action: "input->collection-filters#typed compositionend->collection-filters#typed change->collection-filters#changed submit->collection-filters#submitted"
} do %>
  <% if kind != ShelfLoading::KINDS.first %><%= hidden_field_tag "kind", kind, id: nil %><% end %>
  <% if shelf > 1 %><%= hidden_field_tag "shelf", shelf, id: nil %><% end %>
  <div class="filters__search">
    <label class="visually-hidden" for="collection-search"><%= t("library.filters.search.label") %></label>
    <%= search_field_tag "q", query, id: "collection-search", class: "filters__search-field", autocomplete: "off", maxlength: Catalog::CollectionGrid::MAX_QUERY,
      placeholder: t("library.filters.search.placeholder"), data: { collection_filters_target: "search" } %>
  </div>
  <details class="filters__zone" <%= "open" if count.positive? %>>
    <summary class="filters__summary">
      <%= pixel_icon("arrow-small-right", class: "filters__chevron") %>
      <span class="filters__title"><%= t("library.filters.title") %></span>
      <span class="filters__count" data-collection-filters-target="count" <%= "hidden" if count.zero? %>><span class="visually-hidden"><%= t("library.filters.active") %></span> <span data-collection-filters-target="number"><%= count %></span></span>
    </summary>
    <div class="filters__groups">
      <fieldset class="filters__group" data-collection-filters-target="group" data-group="state" data-default="<%= Game::CollectionStates::DEFAULT %>">
        <legend class="filters__legend"><%= t("library.filters.groups.state") %></legend>
        <% Game::CollectionStates::STATES.each do |state| %>
          <label class="filter-chip">
            <%= check_box_tag "state[]", state, states.include?(state), id: nil, class: "filter-chip__box" %>
            <span class="filter-chip__text"><%= t("library.filters.states.#{state}") %></span>
          </label>
        <% end %>
      </fieldset>
      <fieldset class="filters__group" data-collection-filters-target="group" data-group="rarity">
        <legend class="filters__legend"><%= t("library.filters.groups.rarity") %></legend>
        <% Catalog::Rarity::TIERS.each_value do |rarity| %>
          <label class="filter-chip">
            <%= check_box_tag "rarity[]", rarity, grid.chosen_rarities.include?(rarity.to_s), id: nil, class: "filter-chip__box" %>
            <span class="filter-chip__text"><%= t("catalog.rarity.#{rarity}") %></span>
          </label>
        <% end %>
      </fieldset>
      <% if set.nil? && set_refs.any? %>
        <fieldset class="filters__group" data-collection-filters-target="group" data-group="sets">
          <legend class="filters__legend"><%= t("library.filters.groups.sets") %></legend>
          <% set_refs.each do |ref| %>
            <label class="filter-chip">
              <%= check_box_tag "sets[]", "#{ref.kind}:#{ref.key}", chosen_set_keys.include?("#{ref.kind}:#{ref.key}"), id: nil, class: "filter-chip__box" %>
              <span class="filter-chip__text"><%= labelled_sets[[ ref.kind, ref.key ]] || SetLabel.for(ref) %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
      <% if grid.genres.any? %>
        <fieldset class="filters__group" data-collection-filters-target="group" data-group="genre">
          <legend class="filters__legend"><%= t("library.filters.groups.genre") %></legend>
          <% grid.genres.each do |genre| %>
            <label class="filter-chip">
              <%= check_box_tag "genre[]", genre, grid.chosen_genres.include?(genre), id: nil, class: "filter-chip__box" %>
              <span class="filter-chip__text"><%= SetLabel.genre(genre) %></span>
            </label>
          <% end %>
        </fieldset>
      <% end %>
    </div>
  </details>
  <%= link_to t("library.filters.clear"), clear_path, class: "filters__clear", data: { turbo_frame: "_top", collection_filters_target: "clear" }, hidden: (count.zero? && query.blank?) %>
  <noscript><%= submit_tag t("library.filters.apply"), name: nil, class: "filters__apply" %></noscript>
<% end %>
