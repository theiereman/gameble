<%# The collection's status in the top bar:
    "Cartes uniques : 87 / 16 480" and a progress bar (180px; 48px on the
    phone). Under 900px the label gives way to the value; the sentence read
    out keeps both. The bar is hidden from assistive technology. A player's
    only: a visitor owns nothing.
    - unique: the games held, in any edition, a game gone from the season
      included, so the bar fills at most;
    - total: the season's cards. %>
<div class="collection-status">
  <span class="collection-status__label" aria-hidden="true"><%= t("library.status.label") %></span>
  <span class="collection-status__value" aria-hidden="true"><%= number_with_delimiter(unique) %> / <%= number_with_delimiter(total) %></span>
  <span class="visually-hidden"><%= t("library.status.progress", count: unique, owned: number_with_delimiter(unique), total: number_with_delimiter(total)) %></span>
  <% bar_max = [ total, 1 ].max %>
  <progress class="collection-status__bar" value="<%= [ unique, bar_max ].min %>" max="<%= bar_max %>" aria-hidden="true"></progress>
</div>
