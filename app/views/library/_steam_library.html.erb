<%# locals: (tile:) %>
<% library = tile.own_set %>
<% head_note = steam_library_head_note(library) %>
<section class="set-entry__section steam-library" aria-labelledby="steam-library-title">
  <div class="steam-library__head">
    <h2 id="steam-library-title" class="set-entry__title"><%= t("library.entry.steam_library.title") %></h2>
    <% if head_note %>
      <p class="steam-library__note"><%= head_note %></p>
    <% end %>
  </div>
  <% if library.library_private? %>
    <p class="steam-library__not-shared"><%= t("library.entry.steam_library.not_shared") %></p>
  <% end %>
  <ul class="set-tiles">
    <li><%= render "library/set_progress_tile", href: set_tile_path(tile), tile: %></li>
  </ul>
</section>
