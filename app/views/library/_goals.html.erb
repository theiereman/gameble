<%# locals: (goals:) %>
<% free = goal_free_slot(goals) %>
<section id="goals" class="set-entry__section goals" aria-labelledby="goals-title">
  <div class="goals__head">
    <h2 id="goals-title" class="set-entry__title"><%= t("library.entry.goals.title") %></h2>
    <span class="goals__count"><%= t("library.entry.goals.count_html", count: goals.size, max: Game::Goal::POSITIONS.max) %></span>
  </div>
  <%= render PanelComponent.new(brackets: true, class: "goals__panel") do %>
    <% if goals.any? %>
      <ol class="goals__list">
        <% goals.each do |need| %>
          <% standing = need.to_set_standing %>
          <li>
            <%= link_to goal_album_path(need), class: class_names("goal-row", "goal-tone--#{need.position}", "goal-row--tiered": set_tier_ticks?(standing)),
              data: { turbo_prefetch: false } do %>
              <%= goal_bookmark(need.position, size: :large) %>
              <span class="goal-row__name" aria-hidden="true">
                <b><%= goal_set_name(need) %></b>
                <span class="goal-row__kind"><%= goal_kind_name(need) %></span>
              </span>
              <span class="goal-row__track" aria-hidden="true" data-controller="tier-ticks">
                <progress class="set-row__bar goal-row__bar" value="<%= [ standing.held, standing.total ].min %>" max="<%= [ standing.total, 1 ].max %>"></progress>
                <%= set_tier_ticks(standing) %>
              </span>
              <span class="goal-row__count" aria-hidden="true"><b><%= number_with_delimiter(standing.held) %></b>/<%= number_with_delimiter(standing.total) %></span>
              <span class="goal-row__next" aria-hidden="true"><%= set_goal_line(standing) %></span>
              <span class="goal-row__album" aria-hidden="true"><%= t("library.entry.goals.album") %><%= pixel_icon("arrow-small-right") %></span>
              <span class="visually-hidden"><%= goal_row_sentence(need) %></span>
            <% end %>
          </li>
        <% end %>
      </ol>
      <% if free %>
        <p class="goals__free"><%= goal_bookmark(free, hollow: true) %><span><%= t("library.entry.goals.free", count: Game::Goal::POSITIONS.count - goals.size) %></span></p>
      <% end %>
    <% else %>
      <p class="goals__empty"><%= goal_bookmark(nil, size: :large, hollow: true) %><span><%= t("library.entry.goals.empty") %></span></p>
    <% end %>
  <% end %>
</section>
