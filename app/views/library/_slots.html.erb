<% strings = CardStrings.new %>
<% goals = local_assigns.fetch(:goals, GoalMarks::NONE) %>
<% slots.each do |card, held, price, reserved| %>
  <% marks = goals.goals_for(card.card_id) %>
  <li class="collection-slot">
    <% if held %>
      <%= link_to_card_detail(card, strings:, context: { grid: context }, goals: marks, price:) do %><%= render CardComponent.new(card:, size: :grid, goals: marks.map(&:position)) %><% end %>
      <span class="collection-slot__counts">
        <span class="collection-slot__copies" aria-hidden="true">x<%= number_with_delimiter(held.copies) %></span>
        <span class="visually-hidden"><%= t("library.grid.copies", count: held.copies, number: number_with_delimiter(held.copies)) %></span>
        <% if held.editions > 1 %>
          <span class="collection-slot__editions" aria-hidden="true"><%= t("library.grid.editions.short", count: held.editions) %></span>
          <span class="visually-hidden"><%= t("library.grid.editions.full", count: held.editions) %></span>
        <% end %>
      </span>
      <% if held.new && new_badge %>
        <span class="collection-slot__new"><%= t("library.grid.new") %></span>
      <% end %>
      <% if reserved %>
        <%= render "library/reserved", reserved: %>
      <% end %>
    <% else %>
      <%= link_to_card_detail(card, strings:, context: { grid: context }, owned: !set_apart, goals: marks, price:) do %><%= render CardComponent.new(card:, size: :grid, owned: !set_apart, goals: marks.map(&:position)) %><% end %>
    <% end %>
    <% if price %>
      <span class="collection-slot__price"><%= render AveragePriceComponent.new(price:, compact: true) %></span>
    <% end %>
  </li>
<% end %>
