<%# The collection grid (DESIGN.md, Collection: Copy badge, NOUVEAU tag,
    Missing-card slot): one page of the scope's cards in order. An owned
    card shows its medium face, its copies ("x3", from x1, in an accent box
    at the top-right) and, when gained since the player last saw their
    collection, "Nouveau" in a lime box at the top-left; a missing one is a
    hatched slot with a padlock, naming its game and year. Each leads to its
    card's detail: a face's link is named by the card's title, rarity and
    season, a missing slot's by its visible text and "Missing card"; each
    carries the grid's filters, search and set, so the detail walks this
    grid as shown (◀ ▶), leads back to it, and shows a card the viewer does
    not hold as their faded card back. No card: the empty-filter line, or,
    past the last page of a scope that has cards, the past-the-end line.
    - context: the grid's filters, search and set, as a detail's `grid`
      parameter carries them (CollectionGridLoading#grid_context);
    - slots: [ [ Catalog::CardView, Game::CollectionSlots::Slot | nil ], … ];
    - pagy: the grid's page. %>
<% strings = CardStrings.new %>
<% if slots.empty? %>
  <p class="collection-grid__empty"><%= pagy.count.positive? ? t("library.grid.past_the_end") : t("library.grid.empty") %></p>
<% else %>
  <ol class="collection-grid" aria-label="<%= t("library.grid.label") %>">
    <% slots.each do |card, held| %>
      <li class="collection-slot">
        <% if held %>
          <%= link_to_card_detail(card, strings:, context: { grid: context }) do %><%= render CardComponent.new(card:, size: :m) %><% end %>
          <span class="collection-slot__copies" aria-hidden="true">x<%= number_with_delimiter(held.copies) %></span>
          <span class="visually-hidden"><%= t("library.grid.copies", count: held.copies, number: number_with_delimiter(held.copies)) %></span>
          <% if held.new %>
            <span class="collection-slot__new"><%= t("library.grid.new") %></span>
          <% end %>
        <% else %>
          <%= link_to_card_detail(card, context: { grid: context }) do %>
            <span class="missing-slot">
              <%= pixel_icon("lock", class: "missing-slot__icon") %>
              <span class="missing-slot__title"><%= card.title %></span>
              <span class="missing-slot__year"><%= card.year %></span>
              <span class="visually-hidden"><%= t("library.grid.missing") %></span>
            </span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>
<%= render "library/pages", pagy:, empty: slots.empty? %>
