<% heading = SetLabel.for(@set) %>
<% content_for :back_button, true %>
<% content_for :phone_previous, true %>
<% content_for :screen_title, t("library.collection.title") %>
<% content_for :title, t("library.album.title", set: heading) %>
<% content_for :top_bar_status do %><%= render "library/status", unique: @unique, total: @season_cards %><% end %>
<%= render "library/album", set: @set, standing: @standing, heading:, slots: @album_slots, pagy: @album_pagy,
  slot_context: ->(slot) { { set_kind: @set.kind, set_key: @set.key } if slot.member } %>
