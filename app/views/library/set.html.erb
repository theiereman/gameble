<% heading = SetLabel.for(@set) %>
<% content_for :back_button, true %>
<% content_for :phone_previous, true %>
<% content_for :screen_title, t("library.collection.title") %>
<% content_for :title, t("library.album.title", set: heading) %>
<% content_for :top_bar_status do %><%= render "library/status", unique: @unique, total: @season_cards %><% end %>
<% actions = render("goals/control", aim: @goal_aim, goal: @goal, refused: flash[:goal_refused].present?, complete: @standing.complete?) %>
<%= render "library/album", standing: @standing, heading:, slots: @album_slots, pagy: @album_pagy, filters: @album_filters,
  context: { set_kind: @set.kind, set_key: @set.key }, actions:, goals: goal_marks.without(@goal) %>
