<% content_for :back_button, true %>
<% content_for :title, SetLabel.heading(@set, @slots.values.map(&:year)) %>
<%# One set opened (CAP-6; DESIGN.md: a decorated room; mockups/key-screens.html,
    library()): the shelf of its kind on the left, the open tome on the right;
    on a phone the tome alone, with a way back to the shelf. %>
<section class="library library--open" aria-labelledby="library-heading">
  <div class="library__aside">
    <%= render "library/shelf", kind: @kind, spines: @spines, pagy: @pagy, current_set: @set, **library_shelf_links %>
  </div>
  <div class="library__open">
    <%= link_to t(".back_to_shelf"), library_path(kind: @kind, page: @shelf_page), class: "library__back" %>
    <%= render "library/tome", set: @set, slots: @slots, quantities: @quantities %>
  </div>
</section>
