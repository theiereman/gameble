<% progress = local_assigns.fetch(:progress, true) %>
<% row_class = if progress
     class_names("set-row", "set-row--progress", "set-row--tiered": set_tier_ticks?(standing), "set-row--complete": standing.complete?)
   else
     "set-row set-row--visitor"
   end %>
<%= link_to href, class: row_class, data: { turbo_prefetch: false } do %>
  <span class="set-row__name" aria-hidden="true"><%= SetLabel.for(set) %></span>
  <span class="set-row__meta" aria-hidden="true">
    <span class="set-row__kind"><%= set_kind_name(set.kind) %></span>
    <%= set_tier_mark(standing) if progress %>
  </span>
  <% if progress %>
    <span class="set-row__count" aria-hidden="true"><%= number_with_delimiter(standing.held) %>/<%= number_with_delimiter(standing.total) %></span>
    <span class="set-row__track" aria-hidden="true" data-controller="tier-ticks">
      <progress class="set-row__bar" value="<%= [ standing.held, standing.total ].min %>" max="<%= [ standing.total, 1 ].max %>"></progress>
      <%= set_tier_ticks(standing) %>
    </span>
  <% end %>
  <span class="visually-hidden"><%= progress ? set_progress_sentence(set, standing) : set_label_sentence(set) %></span>
<% end %>
