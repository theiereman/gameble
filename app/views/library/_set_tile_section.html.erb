<%# locals: (id:, title:, page:, section:) %>
<section class="set-entry__section" aria-labelledby="<%= id %>">
  <h2 id="<%= id %>" class="set-entry__title"><%= title %></h2>
  <%= render "library/set_tile_page", page:, next_href: library_in_progress_path(section:, offset: page.next_offset),
    next_frame: "set-more-#{section}-#{page.next_offset}" %>
</section>
