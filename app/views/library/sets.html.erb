<% content_for :back_button, true %>
<% content_for :screen_title, t("library.collection.title") %>
<% content_for :title, t("library.sets.title") %>
<% if @season.nil? %>
  <section class="collection-none" aria-labelledby="collection-heading">
    <h1 id="collection-heading" class="visually-hidden"><%= t("library.sets.heading") %></h1>
    <%= render PanelComponent.new(tag: :p) do %><%= t("library.show.no_season") %><% end %>
  </section>
<% else %>
  <% content_for :top_bar_status do %><%= render "library/status", unique: @unique, total: @season_cards %><% end %>
  <div class="set-browser" data-controller="last-album" data-action="turbo:frame-load->last-album#mark">
    <h1 class="visually-hidden"><%= t("library.sets.heading") %></h1>
    <%= render "library/set_filters", browser: @browser, clear_path: library_sets_path, results_count: @browser_pagy.count %>
    <%= turbo_frame_tag "collection-results", target: "_top", data: { turbo_action: "replace", controller: "next-page", action: "focusout->next-page#focusLeft" } do %>
      <p id="collection-results-status" class="visually-hidden" role="status"><%= t("library.sets.result", count: @browser_pagy.count) %></p>
      <% if @browser_tiles.any? %>
        <ul id="set-browser-tiles" class="set-tiles" aria-label="<%= t("library.sets.heading") %>">
          <%= render "library/set_tile_items", tiles: @browser_tiles, goals: @browser.goals.needs %>
        </ul>
      <% else %>
        <p class="collection-grid__empty"><%= @browser_pagy.count.positive? ? t("library.sets.past_the_end") : t("library.sets.empty") %></p>
      <% end %>
      <%= render "library/pages", pagy: @browser_pagy, empty: @browser_tiles.empty?, label: t("library.sets.pages_label") %>
    <% end %>
  </div>
<% end %>
