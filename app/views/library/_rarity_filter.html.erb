<fieldset class="filters__group" data-collection-filters-target="group" data-group="rarity">
  <legend class="<%= class_names("filters__legend", "visually-hidden": local_assigns.fetch(:titled, false)) %>"><%= t("library.filters.groups.rarity") %></legend>
  <% Catalog::Rarity::TIERS.each_value do |rarity| %>
    <label class="filter-chip">
      <%= check_box_tag "rarity[]", rarity, chosen.include?(rarity.to_s), id: nil, class: "filter-chip__box" %>
      <span class="filter-chip__text"><%= t("catalog.rarity.#{rarity}") %></span>
    </label>
  <% end %>
</fieldset>
