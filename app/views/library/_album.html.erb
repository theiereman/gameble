<% strings = CardStrings.new %>
<div class="set-album" data-controller="set-album">
  <%= render PanelComponent.new(tag: :header, brackets: true, class: class_names("set-album__header", "set-album__header--tiered": set_tier_ticks?(standing), "set-album__header--complete": standing.complete?)) do %>
    <div class="set-album__title">
      <h1 id="set-album-heading" class="set-album__name" tabindex="-1" data-set-album-target="heading"><%= heading %></h1>
      <% if standing.complete? %>
        <span class="set-album__stamp"><%= set_tier_name("complete") %></span>
      <% end %>
      <span class="set-album__count" aria-hidden="true"><b><%= number_with_delimiter(standing.held) %></b>/<%= number_with_delimiter(standing.total) %></span>
      <% if local_assigns[:actions] %>
        <div class="set-album__actions"><%= actions %></div>
      <% end %>
    </div>
    <div class="set-album__track" data-controller="tier-ticks">
      <progress class="set-row__bar set-album__bar" value="<%= [ standing.held, standing.total ].min %>" max="<%= [ standing.total, 1 ].max %>"
        aria-labelledby="set-album-heading" aria-valuetext="<%= set_album_value_text(standing) %>"></progress>
      <% if set_tier_ticks?(standing) %>
        <span class="set-album__ticks" aria-hidden="true"><%= set_tier_ticks(standing, figures: true) %></span>
      <% end %>
    </div>
  <% end %>
  <%= render "library/filters", filters:, state_choices: SetAlbumFilters::STATES, states: filters.states, states_asked: filters.states_asked,
    query: filters.query, clear_path: request.path, clear_action: "replace", search_label: t("library.album.search.label"), search_placeholder: t("library.album.search.placeholder") %>
  <%= turbo_frame_tag "collection-results", target: "_top", data: { turbo_action: "replace" } do %>
    <p class="visually-hidden" role="status"><%= t("library.grid.result", count: pagy.count) %></p>
    <% if slots.any? %>
      <ol class="collection-grid collection-grid--fill set-album__grid" aria-label="<%= t("library.album.slots") %>"
        data-controller="grid-keys" data-action="keydown->grid-keys#move focusin->grid-keys#remember">
        <% slots.each do |slot| %>
          <li class="collection-slot">
            <% if slot.copies %>
              <%= link_to_card_detail(slot.card, strings:, context:, number: slot.number) do %><%= render CardComponent.new(card: slot.card, size: :grid) %><% end %>
              <% if slot.copies > 1 %>
                <span class="collection-slot__copies" aria-hidden="true">x<%= number_with_delimiter(slot.copies) %></span>
              <% end %>
              <span class="visually-hidden"><%= t("library.grid.copies", count: slot.copies, number: number_with_delimiter(slot.copies)) %></span>
              <% if slot.new %>
                <span class="collection-slot__new"><%= t("library.grid.new") %></span>
              <% end %>
            <% else %>
              <%= link_to_card_detail(slot.card, strings:, context:, number: slot.number, owned: false) do %><%= render CardComponent.new(card: slot.card, size: :grid, owned: false) %><% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="collection-grid__empty"><%= pagy.count.positive? ? t("library.grid.past_the_end") : t("library.grid.empty") %></p>
    <% end %>
    <%= render "library/pages", pagy:, empty: slots.empty? %>
  <% end %>
</div>
