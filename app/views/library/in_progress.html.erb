<%= turbo_frame_tag "set-entry-in-progress", class: "set-entry__in-progress", target: "_top" do %>
  <% if @in_progress_tiles.any? %>
    <section class="set-entry__section" aria-labelledby="set-entry-in-progress-title">
      <h2 id="set-entry-in-progress-title" class="set-entry__title"><%= t("library.entry.in_progress") %></h2>
      <ul class="set-tiles">
        <%= render "library/set_tile_items", tiles: @in_progress_tiles, goals: @goals %>
      </ul>
      <% if @more_in_progress %>
        <%= render ButtonComponent.new(variant: :link, href: library_sets_path(state: [ SetBrowser::IN_PROGRESS ]), aria_label: t("library.entry.see_all_label")) do %><%= t("library.entry.see_all") %><% end %>
      <% end %>
    </section>
  <% elsif @goals.empty? %>
    <p class="set-entry__empty"><%= t("library.entry.no_progress") %></p>
  <% else %>
    <p class="set-entry__empty"><%= t("library.entry.no_other_progress") %></p>
  <% end %>
<% end %>
