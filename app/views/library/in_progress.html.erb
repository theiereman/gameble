<%= turbo_frame_tag "set-entry-in-progress", class: "set-entry__in-progress", target: "_top" do %>
  <% if @group_pages.any? %>
    <section class="set-entry__section set-groups" aria-labelledby="set-entry-in-progress-title">
      <h2 id="set-entry-in-progress-title" class="set-entry__title"><%= t("library.entry.in_progress") %></h2>
      <% @group_pages.each do |kind, page| %>
        <%= render "library/set_tile_section", id: "set-entry-#{kind}-title", title: t("library.entry.kinds.#{kind}"), page:, section: kind, goals: @goals,
          heading: :h3 %>
      <% end %>
    </section>
  <% elsif @goals.empty? %>
    <p class="set-entry__empty"><%= t("library.entry.no_progress") %></p>
  <% else %>
    <p class="set-entry__empty"><%= t("library.entry.no_other_progress") %></p>
  <% end %>
  <% if @completed_page.tiles.any? %>
    <%= render "library/set_tile_section", id: "set-entry-completed-title", title: t("library.entry.completed"), page: @completed_page,
      section: SetBoardLoading::COMPLETED, goals: @goals %>
  <% end %>
<% end %>
