<% next_page_data = local_assigns.fetch(:scroll_pages, false) ? { controller: "next-page", action: "focusout->next-page#focusLeft" } : {} %>
<div class="<%= class_names("collection", "collection--visitor": !set_apart) %>">
  <h1 class="visually-hidden"><%= heading %></h1>
  <% if set_apart %>
    <aside class="collection__aside" aria-labelledby="collection-report-title">
      <%= render "library/report", counts: tier_counts, games: games_by_rarity, unique: unique %>
    </aside>
  <% end %>
  <section class="collection__main" aria-label="<%= heading %>">
    <% state_choices = set_apart ? Game::CollectionStates::STATES - (local_assigns.fetch(:with_new, true) ? [] : [ "new" ]) : [] %>
    <%= render "library/filters", filters: grid, state_choices:, states:, states_asked:, query:, set_filter: set_filter, clear_path: clear_path %>
    <%= turbo_frame_tag "collection-results", target: "_top", data: { turbo_action: "replace", **next_page_data } do %>
      <p id="collection-results-status" class="visually-hidden" role="status"><%= t("library.grid.result", count: pagy.count) %></p>
      <%= render "library/grid", context:, slots:, set_apart:, pagy: pagy, new_badge: !context.key?(:brother) %>
      <% if seen_up_to %>
        <%= render "library/seen", seen_up_to: %>
      <% end %>
    <% end %>
  </section>
</div>
