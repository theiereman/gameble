<%# A set progress row (DESIGN.md, Set progress row), the same on the hub
    and in the collection: a link to the set (or the whole season) with its
    name, the unique cards owned out of its size and a thin bar (a native
    <progress>, hidden from assistive technology, which reads the sentence
    instead). The current one, in the collection, carries aria-current and
    a 5px accent bar on its left.
    - href, label, owned, total;
    - current: whether it is the scope shown (default: false). %>
<%= link_to href, class: "set-row", aria: { current: ("page" if local_assigns[:current]) }, data: { turbo_prefetch: false } do %>
  <span class="set-row__name"><%= label %></span>
  <span class="set-row__count" aria-hidden="true"><%= number_with_delimiter(owned) %>/<%= number_with_delimiter(total) %></span>
  <span class="visually-hidden"><%= t("library.set_row.progress", count: owned, owned: number_with_delimiter(owned), total: number_with_delimiter(total)) %></span>
  <progress class="set-row__bar" value="<%= owned %>" max="<%= [ total, 1 ].max %>" aria-hidden="true"></progress>
<% end %>
