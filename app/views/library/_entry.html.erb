<div class="set-entry" data-controller="last-album" data-action="turbo:frame-load->last-album#mark">
  <%= render("library/goals", goals:, suggestions: goal_suggestions) %>
  <%= render "library/all_cards_tile", **all_cards %>
  <%= render "library/all_sets_tile", **all_sets %>
  <%= turbo_frame_tag "set-entry-in-progress", src: in_progress_url, loading: :lazy, class: "set-entry__in-progress", target: "_top" do %>
    <p class="set-entry__loading"><%= t("library.entry.loading") %></p>
  <% end %>
  <%= render("library/custom_sets", tiles: custom_set_tiles, goals:) %>
  <%= render("library/steam_library", tile: steam_library_tile) if steam_library_tile %>
</div>
