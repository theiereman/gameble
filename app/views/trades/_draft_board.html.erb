<% name = friend_name(friend) %>
<% prefilled = local_assigns.fetch(:prefilled, false) %>
<% data = trade_board_root_data(focus: "heading", editing: true, editor:, draft_key: trade_draft_key(current_player, friend),
          prefilled:, board_url: (new_trade_path(friend: friend.token) if prefilled)) %>
<%= render PanelComponent.new(tag: :section, brackets: true, id: "trade-board", class: "trade-board trade-board--editing",
      aria: { labelledby: "trade-board-heading" }, data: data.merge(editing: true)) do %>
  <div class="trade-board__form">
    <header class="trade-board__header">
      <%= player_avatar(friend, class_name: "trade-board__avatar") %>
      <h2 id="trade-board-heading" class="trade-board__title" tabindex="-1" data-trade-board-target="heading"><%= t("trades.board.heading", name:) %></h2>
      <span class="trade-chip trade-chip--accent"><%= t("trades.chip.draft") %></span>
      <p class="trade-board__expiry"><%= t("trades.board.valid") %></p>
    </header>
    <%= render "trades/edit_side", side: :friend, label: t("trades.side.friend_gives", name:), lines: editor[:friend][:lines], form: TradesHelper::DRAFT_FORM_ID,
          priced: editor[:priced] %>
    <%= render "trades/board_middle", message: t("trades.board.choose") %>
    <%= render "trades/edit_side", side: :own, label: t("trades.side.you_give"), lines: editor[:own][:lines], form: TradesHelper::DRAFT_FORM_ID, priced: editor[:priced],
          help: trade_open_help(friend) %>
    <div class="trade-board__actions">
      <%= form_with url: trades_path, method: :post, id: TradesHelper::DRAFT_FORM_ID, class: "trade-board__action-set",
            data: { controller: "trade-board-send", action: ("submit->trade-board#send" if prefilled) } do %>
        <%= hidden_field_tag :friend, friend.token, id: nil %>
        <%= render ButtonComponent.new(type: :submit) do %><%= t("trades.actions.send") %><% end %>
        <span class="trade-board__action" data-action="click->trade-board#abandon">
          <%= render ButtonComponent.new(variant: :secondary, href: trades_path) do %><%= t("trades.actions.abandon") %><% end %>
        </span>
        <p id="trade-send-reason" class="trade-board__reason visually-hidden" data-trade-board-send-target="reason" hidden><%= t("trades.board.send_reason", name:) %></p>
      <% end %>
    </div>
  </div>
  <%= render("trades/picker", editor:, friend:) %>
  <%= render "trades/faces", views: editor[:faces] %>
  <% [ :friend, :own ].each do |side| %>
    <% editor[side][:lines].each do |line| %>
      <%= tag.span hidden: true, data: { trade_board_target: "line", side:, key: line.key, quantity: line.quantity } %>
    <% end %>
  <% end %>
<% end %>
