<% content_for :back_button, true %>
<% content_for :screen_title, t("trades.title") %>
<% turbo_exempts_page_from_cache %>
<% if view == :board %>
  <% content_for :phone_back do %>
    <%= phone_back_link t("trades.list.back"), trades_path %>
  <% end %>
<% end %>
<%= tag.section class: "trades trades--#{view} page page--regular", aria: { labelledby: "trades-heading" },
      data: { controller: "live-refresh", live_refresh_signal_value: "trades-updated" } do %>
  <%= render "exchanges/tabs", current: :friends %>
  <h1 id="trades-heading" class="visually-hidden" tabindex="-1"><%= t("trades.title") %></h1>
  <div class="trades__layout">
    <%= render "trades/list", trades:, current: (trade if view == :board), cards:, suggestions: local_assigns[:suggestions],
          prefill: local_assigns[:prefill] %>
    <% if local_assigns.key?(:chooser) %>
      <%= render "trades/chooser", friends: chooser %>
    <% elsif local_assigns[:draft] %>
      <%= render "trades/draft_board", friend: draft, editor:, prefilled: local_assigns[:prefill].present? %>
    <% elsif trade %>
      <%= render "trades/board", trade:, cards:, **local_assigns.fetch(:board, {}) %>
    <% end %>
  </div>
<% end %>
