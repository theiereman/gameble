<%# The trades screen: the list in its three groups beside one board.
    `view` is :list (/trades: on a phone the list alone) or :board (one
    trade, or a draft: on a phone the board alone, back to the list with
    "◀ Liste"); on a desktop both show. `board` holds the board partial's
    locals; with `draft` (the friend) the board is that draft's. %>
<section class="trades trades--<%= view %>" aria-labelledby="trades-heading">
  <h1 id="trades-heading" class="trades__title"><%= t("trades.title") %></h1>
  <div class="trades__layout">
    <%= render "trades/list", trades:, current: (trade if view == :board), cards: %>
    <% if local_assigns[:draft] %>
      <%= render "trades/draft_board", friend: draft, island: %>
    <% elsif trade %>
      <%= render "trades/board", trade:, cards:, **local_assigns.fetch(:board, {}) %>
    <% end %>
  </div>
</section>
