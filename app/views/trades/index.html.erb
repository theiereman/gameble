<% content_for :back_button, true %>
<% content_for :title, t("trades.title") %>
<% content_for :screen_title, t("trades.title") %>
<% turbo_exempts_page_from_cache %>
<%# Échanges: the list, and on a desktop the first trade's board beside it. %>
