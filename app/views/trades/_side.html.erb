<% size = lines.size == 1 ? :m : :s %>
<% fresh = local_assigns[:fresh] || [] %>
<% blank = lines.empty? && local_assigns[:empty_label].present? %>
<div class="<%= class_names("trade-side", "trade-side--#{side}", "trade-board__read-only": local_assigns[:read_only]) %>">
  <p class="trade-side__header">
    <span class="trade-side__label"><%= label %></span>
    <% unless blank %><span class="trade-side__count"><%= trade_side_count(lines) %></span><% end %>
  </p>
  <% if blank %>
    <p class="trade-side__open"><%= local_assigns[:empty_label] %></p>
  <% else %>
    <ul class="trade-side__cards">
      <% lines.each do |line| %>
        <% view = cards[line.card_season_id] or next %>
        <%= tag.li class: class_names("trade-card", "trade-card--stack": line.quantity > 1),
              data: ({ trade_board_target: "line", side:, key: trade_card_key(view), quantity: line.quantity } if local_assigns[:received]) do %>
          <%= render CardComponent.new(card: view, size:) %>
          <% if line.quantity > 1 %>
            <span class="trade-card__quantity"><span class="visually-hidden"><%= t("trades.side.copies_label") %></span>×<%= line.quantity %></span>
          <% end %>
          <% if reserved %>
            <span class="trade-card__reserved"><%= t("trades.side.reserved", count: line.quantity) %></span>
          <% end %>
          <% if fresh.include?(line.card_season_id) %>
            <span class="trade-card__new"><%= t("trades.side.new") %></span>
          <% end %>
        <% end %>
      <% end %>
    </ul>
  <% end %>
</div>
