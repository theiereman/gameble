<%# One side of the trade board (DESIGN.md, Trade board, Stack, Reserved
    tag): its label and count, then its cards, a single one at card-m, two
    or more at card-s; several copies show a stack and a gold "×2"; copies
    reserved by the trade carry "RÉSERVÉE" / "2 RÉSERVÉES". When editing,
    each card has a quantity field named by its slug and season (AD-15),
    from 0 (removed) to `max` (the player's free copies, or what the friend
    owns), and the side is marked "EN ÉDITION"; `none`, when set, says why
    no card of the side has a copy left to place ("Aucune carte
    disponible."). %>
<% size = lines.size == 1 ? :m : :s %>
<% field = side == :own ? "give" : "take" %>
<div class="<%= class_names("trade-side", "trade-side--#{side}", "trade-side--editing": editing) %>">
  <p class="trade-side__header">
    <span class="trade-side__label"><%= label %></span>
    <% if editing %><span class="trade-side__editing"><%= t("trades.chip.editing") %></span><% end %>
    <span class="trade-side__count"><%= trade_side_count(lines) %></span>
  </p>
  <% if local_assigns[:none] %>
    <p class="trade-side__none"><b class="trade-side__none-title"><%= t("trades.side.none.title") %></b> <%= none %></p>
  <% end %>
  <ul class="trade-side__cards">
    <% lines.each do |line| %>
      <% view = cards[line.card_season_id] or next %>
      <li class="<%= class_names("trade-card", "trade-card--stack": line.quantity > 1) %>">
        <%= render CardComponent.new(card: view, size:) %>
        <% if line.quantity > 1 %>
          <span class="trade-card__quantity"><span class="visually-hidden"><%= t("trades.side.copies_label") %></span>×<%= line.quantity %></span>
        <% end %>
        <% if reserved && !editing %>
          <span class="trade-card__reserved"><%= t("trades.side.reserved", count: line.quantity) %></span>
        <% end %>
        <% if editing %>
          <% key = trade_card_key(view) %>
          <% limit = [ max&.fetch(line.card_season_id, 0).to_i, 0 ].max %>
          <span class="trade-card__stepper">
            <label class="visually-hidden" for="<%= field %>-<%= key %>"><%= t("trades.side.quantity_label", title: view.title) %></label>
            <input type="number" id="<%= field %>-<%= key %>" name="<%= field %>[<%= key %>]" class="trade-card__field"
                   value="<%= [ line.quantity, limit ].min %>" min="0" max="<%= limit %>" step="1" inputmode="numeric">
            <span class="trade-card__max"><%= t("trades.side.max", max: limit) %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
