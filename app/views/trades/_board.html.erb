<%# The trade board: a bracketed panel headed "Échange avec Léa", the status
    chip and the expiry (or the outcome's age), the friend's column and the
    player's facing each other (stacked under 700px of board), the swap icon
    and the status line between them, a refusal inline under it, and the
    actions of the state below, each a form posting to its operation, or a
    link to the counter-proposal or to a new trade with the friend.

    `island`, on the player's turn, mounts the TradeBoard island over the
    sides: it shows the proposal as received and turns it into a
    counter-proposal in place (CONTRE-PROPOSER, then ANNULER LES
    MODIFICATIONS, confirmed when something changed). `editing` opens it as
    the counter-proposal (the counter page), its fallback the quantity
    fields of each side, a side with no copy left to place saying so and
    why. The counter form sits in the actions; the sides' fields reach it by
    its id. Once concluded the cards have crossed: `swap` plays their swap,
    and `fresh` names the received cards still new in the collection.
    `trade_again` offers a closed trade's friend a new one. %>
<% editing = local_assigns.fetch(:editing, false) %>
<% fresh = local_assigns.fetch(:fresh, nil) || [] %>
<% friend_label, own_label = trade_side_labels(trade) %>
<% friend_lines, own_lines = trade_board_lines(trade) %>
<% tone, chip = trade_chip(trade) %>
<% form_id = TradesHelper::COUNTER_FORM_ID %>
<% yours = trade.state == :yours %>
<% body = capture do %>
  <header class="trade-board__header">
    <%= pixel_icon("avatar-default", class: "trade-board__avatar") %>
    <h2 id="trade-board-heading" class="trade-board__title" tabindex="-1"><%= t("trades.board.heading", name: trade_friend_name(trade.friend)) %></h2>
    <%= tag.span chip, class: "trade-chip trade-chip--#{tone}", hidden: editing, data: { trade_board_target: ("chip" if yours) } %>
    <% if yours %>
      <%= tag.span t("trades.chip.editing"), class: "trade-chip trade-chip--accent", hidden: !editing, data: { trade_board_target: "editingChip" } %>
    <% end %>
    <p class="trade-board__expiry">
      <% if trade.open? %>
        <%= pixel_icon("hourglass", class: "trade-board__hourglass") %>
        <%= t("trades.board.expires_html", days: tag.b(t("trades.board.days", count: trade_days_left(trade)))) %>
      <% else %>
        <%= trade_outcome_age(trade) %>
      <% end %>
    </p>
  </header>
  <% sides = capture do %>
    <%= render "trades/side", side: :friend, label: friend_label, lines: friend_lines, cards:, editing:, form: form_id,
          reserved: yours, max: local_assigns[:friend_max],
          none: (trade_nothing_to_place(trade, :friend, local_assigns[:friend_max]) if editing) %>
    <div class="trade-board__middle">
      <%= pixel_icon("swap", class: "trade-board__swap") %>
      <p class="trade-board__message" tabindex="-1"><%= trade_message(trade, editing:) %></p>
      <% if flash[:trade_error] %>
        <p class="trade-board__error" role="alert"><%= flash[:trade_error] %></p>
      <% end %>
    </div>
    <%= render "trades/side", side: :own, label: own_label, lines: own_lines, cards:, editing:, form: form_id,
          reserved: trade.state == :theirs, max: local_assigns[:own_max], fresh:,
          none: (trade_nothing_to_place(trade, :own, local_assigns[:own_max], local_assigns[:own_copies]) if editing) %>
  <% end %>
  <% if local_assigns[:island] %>
    <%= turbo_mount("TradeBoard", props: island, class: "trade-island") { sides } %>
  <% else %>
    <%= sides %>
  <% end %>
  <div class="trade-board__actions">
    <% if yours %>
      <%= tag.div class: "trade-board__action-set", hidden: editing, data: { trade_board_target: "readActions" } do %>
        <%= render ButtonComponent.new(href: accept_trade_path(token: trade.token), method: :post) do %><%= t("trades.actions.accept") %><% end %>
        <span class="trade-board__action" data-trade-board-target="editButton" data-action="click->trade-board#edit">
          <%= render ButtonComponent.new(variant: :secondary, href: counter_trade_path(token: trade.token)) do %><%= t("trades.actions.counter") %><% end %>
        </span>
        <%= render ButtonComponent.new(variant: :secondary, href: decline_trade_path(token: trade.token), method: :post) do %><%= t("trades.actions.decline") %><% end %>
      <% end %>
      <%= form_with url: counter_trade_path(token: trade.token), method: :post, id: form_id, class: "trade-board__action-set",
            html: { hidden: !editing }, data: { controller: "trade-send", trade_board_target: "editActions" } do %>
        <%= render ButtonComponent.new(type: :submit) do %><%= t("trades.actions.send_counter") %><% end %>
        <span class="trade-board__action" data-action="click->trade-board#undo">
          <%= render ButtonComponent.new(variant: :secondary, href: trade_path(token: trade.token)) do %><%= t("trades.actions.undo") %><% end %>
        </span>
        <p id="trade-send-reason" class="trade-board__reason" data-trade-send-target="reason" hidden><%= t("trades.board.choose") %></p>
      <% end %>
    <% elsif trade.state == :theirs %>
      <%= render ButtonComponent.new(variant: :secondary, href: cancel_trade_path(token: trade.token), method: :post) do %><%= t("trades.actions.cancel") %><% end %>
    <% elsif trade.state == :closed && local_assigns[:trade_again] %>
      <%= render ButtonComponent.new(href: new_trade_path(friend: trade.friend.token)) do %><%= t("trades.actions.again", name: trade_friend_name(trade.friend)) %><% end %>
    <% end %>
  </div>
  <% if yours %>
    <%= render "trades/undo_dialog", trade: %>
  <% end %>
<% end %>
<%= render PanelComponent.new(tag: :section, brackets: true, class: class_names("trade-board", "trade-board--editing": editing),
      aria: { labelledby: "trade-board-heading" },
      data: { controller: class_names("trade-board", "trade-swap": trade.state == :concluded),
              trade_board_editing_value: editing, trade_board_focus_value: local_assigns.fetch(:focus, false),
              trade_board_forget_value: local_assigns[:forget], trade_board_counter_url_value: (counter_trade_path(token: trade.token) if yours),
              trade_board_board_url_value: (trade_path(token: trade.token) if yours),
              trade_swap_play_value: (true if local_assigns[:swap] && trade.state == :concluded) }) do %>
  <div class="trade-board__form"><%= body %></div>
<% end %>
