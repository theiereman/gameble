<% editing = local_assigns.fetch(:editing, false) %>
<% fresh = local_assigns.fetch(:fresh, nil) || [] %>
<% friend_label, own_label = trade_side_labels(trade) %>
<% friend_lines, own_lines = trade_board_lines(trade) %>
<% tone, chip = trade_chip(trade) %>
<% form_id = TradesHelper::COUNTER_FORM_ID %>
<% yours = trade.state == :yours %>
<% editor = local_assigns[:editor] if yours %>
<% data = trade_board_root_data(focus: local_assigns.fetch(:focus, ""), editing:, editor:, forget: local_assigns[:forget],
          swap: local_assigns[:swap] && trade.state == :concluded, draft_key: (trade_counter_key(current_player, trade) if editor),
          counter_url: (counter_trade_path(token: trade.token) if editor), board_url: (trade_path(token: trade.token) if editor)) %>
<%= render PanelComponent.new(tag: :section, brackets: true, id: "trade-board", class: class_names("trade-board", "trade-board--editing": editing),
      aria: { labelledby: "trade-board-heading" }, data: data.merge(editing: (true if editing))) do %>
  <div class="trade-board__form">
    <header class="trade-board__header">
      <%= pixel_icon("avatar-default", class: "trade-board__avatar") %>
      <h2 id="trade-board-heading" class="trade-board__title" tabindex="-1" data-trade-board-target="heading"><%= t("trades.board.heading", name: friend_name(trade.friend)) %></h2>
      <%= tag.span chip, class: class_names("trade-chip", "trade-chip--#{tone}", "trade-board__read-only": editor) %>
      <% if editor %>
        <span class="trade-chip trade-chip--accent trade-board__edit-only"><%= t("trades.chip.editing") %></span>
      <% end %>
      <p class="trade-board__expiry">
        <% if trade.open? %>
          <%= pixel_icon("hourglass", class: "trade-board__hourglass") %>
          <%= t("trades.board.expires_html", days: tag.b(t("trades.board.days", count: trade_days_left(trade)))) %>
        <% else %>
          <%= trade_outcome_age(trade) %>
        <% end %>
      </p>
    </header>
    <%= render "trades/side", side: :friend, label: friend_label, lines: friend_lines, title: trade.friend_title, cards:, reserved: yours, read_only: editor.present?,
          received: editor.present?, empty_label: (trade_empty_side_label(:friend, trade.friend) if trade.open?) %>
    <% if editor %>
      <%= render "trades/edit_side", side: :friend, label: friend_label, lines: editor[:friend][:lines], drawn: editing, form: form_id %>
    <% end %>
    <%= render "trades/board_middle", message: trade_message(trade), edit_message: (trade_message(trade, editing: true) if editor) %>
    <%= render "trades/side", side: :own, label: own_label, lines: own_lines, title: trade.own_title, cards:, reserved: trade.state == :theirs, fresh:,
          read_only: editor.present?, received: editor.present?, empty_label: (trade_empty_side_label(:own, trade.friend) if trade.open?) %>
    <% if editor %>
      <%= render "trades/edit_side", side: :own, label: own_label, lines: editor[:own][:lines], drawn: editing, form: form_id,
            help: trade_open_help(trade.friend) %>
    <% end %>
    <div class="trade-board__actions">
      <% if yours %>
        <%= tag.div class: class_names("trade-board__action-set", "trade-board__read-only": editor) do %>
          <% if trade.friend_side.empty? %>
            <p class="trade-board__open"><%= t("trades.board.open_request", name: friend_name(trade.friend)) %></p>
          <% else %>
            <%= render ButtonComponent.new(href: accept_trade_path(token: trade.token), method: :post, params: { revision: trade.revision }) do %><%= t("trades.actions.accept") %><% end %>
          <% end %>
          <span class="trade-board__action" data-trade-board-target="editButton" data-action="click->trade-board#edit">
            <%= render ButtonComponent.new(variant: :secondary, href: counter_trade_path(token: trade.token)) do %><%= t("trades.actions.counter") %><% end %>
          </span>
          <%= render ButtonComponent.new(variant: :secondary, href: decline_trade_path(token: trade.token), method: :post, params: { revision: trade.revision }) do %><%= t("trades.actions.decline") %><% end %>
        <% end %>
        <% if editor %>
          <%= form_with url: counter_trade_path(token: trade.token), method: :post, id: form_id, class: "trade-board__action-set trade-board__edit-only",
                data: { controller: "trade-board-send" } do %>
            <%= hidden_field_tag :revision, trade.revision, id: nil %>
            <%= render ButtonComponent.new(type: :submit) do %><%= t("trades.actions.send_counter") %><% end %>
            <span class="trade-board__action" data-action="click->trade-board#undo">
              <%= render ButtonComponent.new(variant: :secondary, href: trade_path(token: trade.token)) do %><%= t("trades.actions.undo") %><% end %>
            </span>
            <p id="trade-send-reason" class="trade-board__reason" data-trade-board-send-target="reason" hidden><%= t("trades.board.send_reason", name: friend_name(trade.friend)) %></p>
          <% end %>
        <% end %>
      <% elsif trade.state == :theirs %>
        <%= render ButtonComponent.new(variant: :secondary, href: cancel_trade_path(token: trade.token), method: :post) do %><%= t("trades.actions.cancel") %><% end %>
      <% elsif trade.state == :closed && local_assigns[:trade_again] %>
        <%= render ButtonComponent.new(href: new_trade_path(friend: trade.friend.token)) do %><%= t("trades.actions.again", name: friend_name(trade.friend)) %><% end %>
      <% elsif trade.state == :closed && local_assigns[:trades_closed] %>
        <%= trades_closed_line(local_assigns[:trades_closed], trade.friend) %>
      <% end %>
    </div>
    <% if editor %>
      <%= render "trades/undo_dialog", trade: %>
    <% end %>
  </div>
  <% if editor %>
    <%= render "trades/picker", editor:, friend: trade.friend %>
    <%= render "trades/faces", views: editor[:faces] %>
  <% end %>
<% end %>
