<% content_for :back_button, true %>
<% content_for :title, t("trades.board.heading", name: trade_friend_name(@trade.friend)) %>
<% content_for :screen_title, t("trades.title") %>
<%# The counter-proposal (EXPERIENCE.md, Counter-proposal in progress): the
    board as a form, both sides in edition in the TradeBoard island, with
    the card picker. On a phone, back to the list. %>
<% content_for :phone_back do %>
  <%= render "trades/phone_back" %>
<% end %>
<%= render "trades/screen", view: :board, editing: true, trades: @trades, trade: @trade, cards: @cards,
      own_max: @own_max, friend_max: @friend_max,
      island: trade_board_props(@trade, own_held: @own_held, friend_held: @friend_held, picks: @picks, error: flash[:trade_error]) %>
