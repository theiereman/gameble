<%# locals: (suggestion:, cards:, goals:, current:) %>
<%= tag.li class: class_names("trade-suggestion", "trade-suggestion--current": current),
      data: { trade_suggestions_target: "row", draft_key: trade_draft_key(current_player, suggestion.player) } do %>
  <%= link_to "", trade_suggestion_opener_path(suggestion, cards), class: "trade-suggestion__opener",
        aria: { label: trade_suggestion_opener_name(suggestion, cards, goals), current: ("true" if current) }, data: { turbo_prefetch: false } %>
  <div class="trade-suggestion__head">
    <%= player_avatar(suggestion.player, class_name: "trade-suggestion__avatar") %>
    <span class="trade-suggestion__who" aria-hidden="true">
      <span class="trade-suggestion__name"><%= friend_name(suggestion.player) %></span>
      <%= render "friends/presence", presence: suggestion.friend %>
    </span>
  </div>
  <p class="trade-suggestion__marks" aria-hidden="true">
    <% suggestion.served_goals.each do |position, count| %>
      <span class="trade-suggestion__mark">
        <%= goal_bookmark(position) %>
        <% if count > 1 %><span class="trade-suggestion__count">×<%= count %></span><% end %>
      </span>
    <% end %>
  </p>
  <p class="trade-suggestion__summary" aria-hidden="true"><%= trade_suggestion_summary(suggestion, cards) %></p>
<% end %>
