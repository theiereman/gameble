<% tabs = shell_tabs %>
<nav class="tab-bar" aria-label="<%= t("shell.tabs.label") %>" data-controller="navigation-lock">
  <%= tag.ul class: [ "tab-bar__list", ("tab-bar__list--visitor" unless current_player) ] do %>
    <% tabs.each do |key, icon, path, current| %>
      <li class="tab-bar__item">
        <%= link_to path, class: "tab-bar__tab", aria: { current: }, data: { turbo_prefetch: false } do %>
          <%= pixel_icon(icon, class: "tab-bar__icon") %>
          <span class="tab-bar__label"><%= t("shell.tabs.#{key}") %></span>
          <% if key == :booster %>
            <%= render "shell/tab_capsules_badge", bank: shell_bank %>
          <% elsif key == :duels %>
            <span id="tab-duels-badge" class="stream-slot"><%= render("shell/tab_duels_badge", count: shell_duels_in_progress) %></span>
          <% elsif key == :trades %>
            <span id="tab-trades-badge" class="stream-slot"><%= render("shell/tab_trades_badge", waiting: shell_trades_waiting, outbid: shell_outbid_count) %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  <% end %>
</nav>
