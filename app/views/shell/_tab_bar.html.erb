<% waiting = shell_trades_waiting %>
<% invitations = shell_invitations_waiting %>
<% tabs = if current_player
     [
       [ :booster, "tab-capsule", booster_path, %w[boosters packs].include?(controller_path) ],
       [ :sets, "tab-sets", library_path, %w[library cards custom_sets].include?(controller_path) ],
       [ :social, "tab-social", social_path, social_tab_current? ],
       [ :me, "tab-me", me_path, me_tab_current? ]
     ]
   else
     [
       [ :landing, "tab-hub", home_path, controller_path == "pages" && action_name == "home" ],
       [ :all_cards, "tab-collection", library_cards_path, (controller_path == "library" && action_name == "cards") || controller_path == "cards" ]
     ]
   end %>
<nav class="tab-bar" aria-label="<%= t("shell.tabs.label") %>" data-controller="navigation-lock">
  <%= tag.ul class: [ "tab-bar__list", ("tab-bar__list--visitor" unless current_player) ] do %>
    <% tabs.each do |key, icon, path, current| %>
      <li class="tab-bar__item">
        <%= link_to path, class: "tab-bar__tab", aria: { current: ("page" if current) }, data: { turbo_prefetch: false } do %>
          <%= pixel_icon(icon, class: "tab-bar__icon") %>
          <span class="tab-bar__label"><%= t("shell.tabs.#{key}") %></span>
          <% if key == :social %>
            <span id="tab-trades-badge" class="stream-slot"><%= render "shell/tab_trades_badge", waiting: %></span>
            <span id="tab-invitations-badge" class="stream-slot tab-bar__slot--start"><%= render "shell/tab_invitations_badge", invitations: %></span>
          <% end %>
          <% if key == :me %>
            <span id="tab-me-badge" class="stream-slot"><%= render "shell/tab_achievements_badge", unclaimed: shell_achievements_unclaimed %></span>
          <% end %>
        <% end %>
      </li>
    <% end %>
  <% end %>
</nav>
