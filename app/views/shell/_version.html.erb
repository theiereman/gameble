<%# The deployed version, fixed in the bottom-left corner of the window:
    the release tag on staging, "dev" locally. %>
<div class="app-version">
  <p class="app-version__tag" title="<%= t("shell.version.label") %>"><span class="visually-hidden"><%= t("shell.version.label") %> </span><%= shell_version %></p>
  <%= link_to t("shell.version.legal"), legal_path, class: "app-version__legal" %>
</div>
