<% messages = flash.to_hash.slice("notice", "alert").compact_blank %>
<div id="toasts" class="toasts" popover="manual" role="status" aria-live="polite" aria-label="<%= t("shell.toast.region") %>" data-controller="toast">
  <% title = flash["toast_title"].presence %>
  <% messages.each do |type, message| %>
    <%= render ToastComponent.new(message:, title:, tone: type.to_sym) %>
  <% end %>
  <%= content_for(:toasts) %>
  <template data-toast-target="template"><%= render ToastComponent.new(message: "", title: "", action: { label: "", href: "#" }) %></template>
</div>
