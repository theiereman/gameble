<% wordmark_shine = { controller: "wordmark-shine", action: "pointerenter->wordmark-shine#sweep animationend->wordmark-shine#end animationcancel->wordmark-shine#end" } %>
<% top_level = shell_top_level_screen? %>
<% status_in_bar = content_for?(:top_bar_status) && !native_top_bar? %>
<header class="<%= class_names("top-bar", "top-bar--status": status_in_bar, "top-bar--top-level": top_level) %>" <%= tag.attributes(data: { controller: ("top-bar-scroll" if top_level && !native_top_bar?), screen_label: shell_screen_label, screen_labels: shell_screen_labels&.to_json }) %>>
  <div class="top-bar__inner">
    <% unless native_top_bar? %>
    <div class="<%= class_names("top-bar__start", "top-bar__start--phone-back": content_for?(:phone_back)) %>" data-controller="navigation-lock">
      <% if top_level && hotwire_native_app? %>
        <span class="top-bar__brand top-bar__phone-home" role="img" aria-label="<%= t("shell.top_bar.brand") %>"><%= pixel_icon("back-g", class: "top-bar__home-g") %></span>
      <% elsif top_level %>
        <%= link_to_unless_current pixel_icon("wordmark-sweep", class: "top-bar__wordmark"), home_path, class: "top-bar__brand top-bar__phone-home", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <span class="top-bar__brand top-bar__phone-home" role="img" aria-label="<%= shell_home_label %>" <%= tag.attributes(data: wordmark_shine) %>><%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %></span>
        <% end %>
      <% end %>
      <% if content_for?(:back_button) %>
        <%= link_to home_path, class: "top-bar__brand top-bar__home", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
        <span class="top-bar__divider" aria-hidden="true"></span>
        <%= link_to home_path, class: "button button--secondary button--small top-bar__bridge" do %>
          <%= pixel_icon("arrow-left", class: "button__icon") %><%= pixel_icon("back-g", class: "top-bar__back-g") %><span class="button__label"><%= shell_back_label %></span>
        <% end %>
        <%= yield :phone_back %>
        <% unless hotwire_native_app? %>
          <a class="button button--secondary button--small top-bar__previous" hidden
            data-controller="previous-screen" data-action="previous-screen#back turbo:morph@document->previous-screen#sync" data-turbo-prefetch="false">
            <%= pixel_icon("arrow-left", class: "button__icon") %><span class="visually-hidden"><%= t("shell.top_bar.previous") %> </span><span class="button__label" data-previous-screen-target="label"></span>
          </a>
        <% end %>
        <% if content_for?(:screen_title) %>
          <p class="top-bar__title"><%= yield :screen_title %></p>
        <% end %>
      <% elsif controller_path == "pages" && action_name == "home" %>
        <%= tag.p class: "top-bar__brand", data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
      <% elsif controller_path == "roadmaps" %>
        <%= link_to home_path, class: "top-bar__brand", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
      <% else %>
        <%= link_to home_path, class: "top-bar__brand top-bar__home", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
        <% if current_player %>
          <%= tag.p class: "top-bar__brand top-bar__phone-brand", data: wordmark_shine do %>
            <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
            <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
          <% end %>
        <% else %>
          <%= link_to home_path, class: "top-bar__brand top-bar__phone-brand", aria: { label: shell_home_label }, data: wordmark_shine do %>
            <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
            <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <% end %>

    <div class="top-bar__end" <%= tag.attributes(data: native_top_bar_data) %>>
      <%= yield :top_bar_status if status_in_bar %>
      <% if current_player %>
        <% unless back_office_page? || status_in_bar %>
          <%= render "shell/rarity_counter", counts: shell_tier_counts unless native_top_bar? %>
          <% if content_for?(:booster_top_bar) %>
            <%= render "shell/reserve_chip", bank: shell_bank %>
          <% else %>
            <%= render "shell/packs_chip", bank: shell_bank %>
          <% end %>
        <% end %>
        <%= render "shell/bell" unless back_office_page? %>
        <%= render "shell/phone_menu" unless back_office_page? %>
        <%= render "shell/player_chip", player: current_player %>
      <% else %>
        <% if controller_path == "pages" && action_name == "home" %>
          <%= button_to motion_path, params: { reduced: motion_reduced? ? "off" : "on" }, class: "motion-switch", form_class: "motion-switch__form", form: { data: { turbo: false } },
                aria: { pressed: motion_reduced?.to_s } do %>
            <span class="motion-switch__label"><%= t("shell.top_bar.motion_switch") %></span>
            <span class="motion-switch__box" aria-hidden="true"></span>
          <% end %>
        <% end %>
        <%= sign_in_button t("shell.top_bar.sign_in"), origin: request.path, class: "button button--primary button--small" %>
      <% end %>
    </div>
  </div>
</header>
