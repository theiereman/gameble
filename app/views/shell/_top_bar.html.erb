<%# The top bar: on the left the wordmark, or, on every other page
    (`content_for :back_button`), the wordmark as a link to the hub (the
    landing for a visitor), a divider, the back button to the previous screen (shown by
    previous-screen once the tab's history names that screen) and the
    screen title, when the view gives one. A mouse over any of its
    wordmarks sweeps the shine once (wordmark-shine). Under 720px the
    wordmark link, divider and previous-screen button give way to the back
    button to the bridge (the landing for a visitor), or to a view's contextual back in its place
    (`content_for :phone_back`, a sub-view's "◀ Grille"), or, on a view
    asking for it (`content_for :phone_previous`, a set's album), to the
    previous-screen button once it names a screen. The header
    carries the screen's short name, recorded with each history entry for
    the next screen's back button. On the right the player's rarity
    counter, packs chip and player chip, or the official Steam sign-in
    image for a visitor. A screen with its own status
    (`content_for :top_bar_status`, the collection's unique cards) shows it
    first, in place of the rarity counter and packs chip (on the phone, of
    the player chip too: collection.css). The booster screen
    (`content_for :booster_top_bar`) shows the rarity counter and a static
    reserve chip, both following its island's events. The back-office
    shows the player chip only. The start's links and buttons are locked
    while the booster island opens or reveals (navigation-lock). %>
<% wordmark_shine = { controller: "wordmark-shine", action: "pointerenter->wordmark-shine#sweep animationend->wordmark-shine#end animationcancel->wordmark-shine#end" } %>
<header class="<%= class_names("top-bar", "top-bar--status": content_for?(:top_bar_status)) %>" <%= tag.attributes(data: { screen_label: shell_screen_label, screen_labels: shell_screen_labels&.to_json }) %>>
  <div class="top-bar__inner">
    <div class="<%= class_names("top-bar__start", "top-bar__start--phone-back": content_for?(:phone_back), "top-bar__start--phone-previous": content_for?(:phone_previous)) %>" data-controller="navigation-lock">
      <% if content_for?(:back_button) %>
        <%= link_to shell_home_path, class: "top-bar__brand top-bar__home", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
        <span class="top-bar__divider" aria-hidden="true"></span>
        <%= link_to shell_home_path, class: "button button--secondary button--small top-bar__bridge" do %>
          <%= pixel_icon("arrow-left", class: "button__icon") %><span class="button__label"><%= shell_back_label %></span>
        <% end %>
        <%= yield :phone_back %>
        <a class="button button--secondary button--small top-bar__previous" hidden
          data-controller="previous-screen" data-action="previous-screen#back turbo:morph@document->previous-screen#sync" data-turbo-prefetch="false">
          <%= pixel_icon("arrow-left", class: "button__icon") %><span class="visually-hidden"><%= t("shell.top_bar.previous") %> </span><span class="button__label" data-previous-screen-target="label"></span>
        </a>
        <% if content_for?(:screen_title) %>
          <p class="top-bar__title"><%= yield :screen_title %></p>
        <% end %>
      <% elsif (controller_path == "pages" && action_name == "home") || controller_path == "landings" %>
        <%= tag.p class: "top-bar__brand", data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
      <% elsif controller_path == "roadmaps" %>
        <%= link_to shell_home_path, class: "top-bar__brand", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
      <% else %>
        <%= link_to shell_home_path, class: "top-bar__brand top-bar__home", aria: { label: shell_home_label }, data: wordmark_shine do %>
          <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
          <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
        <% end %>
        <% if current_player %>
          <%= tag.p class: "top-bar__brand top-bar__phone-brand", data: wordmark_shine do %>
            <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
            <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
          <% end %>
        <% else %>
          <%= link_to shell_home_path, class: "top-bar__brand top-bar__phone-brand", aria: { label: shell_home_label }, data: wordmark_shine do %>
            <%= pixel_icon("wordmark-sweep", class: "top-bar__wordmark") %>
            <span class="top-bar__name visually-hidden"><%= t("shell.top_bar.brand") %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="top-bar__end">
      <%= yield :top_bar_status if content_for?(:top_bar_status) %>
      <% if current_player %>
        <% unless back_office_page? || content_for?(:top_bar_status) %>
          <%= render "shell/rarity_counter", counts: shell_tier_counts %>
          <% if content_for?(:booster_top_bar) %>
            <%= render "shell/reserve_chip", bank: shell_bank %>
          <% else %>
            <%= render "shell/packs_chip", bank: shell_bank %>
          <% end %>
        <% end %>
        <%= render "shell/player_chip", player: current_player %>
      <% else %>
        <% if controller_path == "landings" %>
          <%= button_to motion_path, params: { reduced: motion_reduced? ? "off" : "on" }, class: "motion-switch", form_class: "motion-switch__form", form: { data: { turbo: false } },
                aria: { pressed: motion_reduced?.to_s } do %>
            <span class="motion-switch__label"><%= t("shell.top_bar.motion_switch") %></span>
            <span class="motion-switch__box" aria-hidden="true"></span>
          <% end %>
        <% end %>
        <%= render SteamSignInComponent.new(origin: request.path) %>
      <% end %>
    </div>
  </div>
</header>
