<div id="live-ticker" class="ticker" data-turbo-permanent
     data-controller="ticker" data-ticker-size-value="<%= LiveStream::TICKER_SIZE %>">
  <%= link_to feed_path, class: "ticker__open", data: { turbo_prefetch: false } do %><span class="visually-hidden"><%= t("shell.ticker.open") %></span><% end %>
  <div class="ticker__inner" aria-hidden="true">
    <%= render "shell/live_marker" %>
    <div class="ticker__window" data-ticker-target="window">
      <div class="ticker__track" data-ticker-target="track">
        <ul class="ticker__run" data-ticker-target="run">
          <% items.each do |item, card, partner_card, set| %>
            <%= render "shell/ticker_item", item:, card:, partner_card:, set: %>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
  <ul id="live-ticker-queue" class="ticker__queue" hidden data-ticker-target="queue"></ul>
  <%= turbo_stream_from(*LiveStream.feed_streamables) %>
</div>
