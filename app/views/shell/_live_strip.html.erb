<%# locals: (items:, title:, id:, stacked: false, subscribe: true, open_label: nil) %>
<section class="<%= class_names("live-strip", "live-strip--stacked": stacked) %>" aria-labelledby="<%= id %>">
  <h2 id="<%= id %>" class="live-strip__title">
    <%= render "shell/live_marker" %>
    <span aria-hidden="true">·</span>
    <%= title %>
  </h2>
  <%= render "shell/live_strip_body", items: %>
  <% if open_label %>
    <p class="live-strip__open">
      <%= render ButtonComponent.new(variant: :link, href: feed_path) do %><%= open_label %><% end %>
    </p>
  <% end %>
  <%= turbo_stream_from(*LiveStream.feed_streamables) if subscribe %>
</section>
