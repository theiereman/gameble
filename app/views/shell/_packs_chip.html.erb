<%# The packs chip (DESIGN.md, Packs chip): the boosters in reserve and the
    countdown to the next one, or "Réserve pleine" at Game::Pack::BANK_SIZE.
    Not a link until the booster screen exists. The ticking clock is hidden
    from screen readers, which read the static time; it never refreshes the
    page. %>
<% seconds = shell_next_pack_in(bank) %>
<p class="packs-chip">
  <%= pixel_icon("canister-small", class: "packs-chip__icon") %>
  <span class="packs-chip__count"><%= number_with_delimiter(bank[:available]) %></span>
  <span class="packs-chip__label"><%= t("shell.packs.label") %></span>
  <% if shell_reserve_full?(bank) %>
    <span class="packs-chip__divider" aria-hidden="true"></span>
    <span class="packs-chip__next packs-chip__next--full"><%= t("shell.packs.full") %></span>
  <% elsif seconds %>
    <span class="packs-chip__divider" aria-hidden="true"></span>
    <span class="packs-chip__next" data-controller="countdown" data-countdown-seconds-value="<%= seconds %>" data-countdown-refresh-value="false">
      <span aria-hidden="true"><%= t("shell.packs.next_in") %>
        <span class="packs-chip__clock" data-countdown-target="clock"><%= format("%02d:%02d", *seconds.divmod(60)) %></span></span>
      <span class="visually-hidden"><%= t("shell.packs.next_at", time: bank[:next_available_at].utc.strftime("%H:%M")) %></span>
    </span>
  <% end %>
</p>
