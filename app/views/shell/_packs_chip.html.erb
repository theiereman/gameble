<% refresh = local_assigns.fetch(:refresh, controller_path == "pages" && action_name == "home") %>
<%= tag.div id: "packs-chip", class: "packs-chips", data: { controller: "reserve-chip", reserve_chip_delimiter_value: t("number.format.delimiter"), reserve_chip_special_templates_value: t("shell.packs.special_label").to_json } do %>
  <%= link_to booster_path, class: "packs-chip", data: { turbo_prefetch: false } do %>
    <%= pixel_icon("canister-small", class: "packs-chip__icon") %>
    <span class="packs-chip__count" data-reserve-chip-target="count"><%= number_with_delimiter(bank[:available]) %></span>
    <span class="packs-chip__label"><%= t("shell.packs.label") %></span>
    <%= render "shell/packs_next", bank:, refresh:, refresh_url: packs_chip_path %>
  <% end %>
  <%= render "shell/special_chip", bank:, link: true %>
  <%= render "shell/bank_counter", bank: %>
<% end %>
