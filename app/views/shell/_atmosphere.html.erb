<%# The atmosphere (DESIGN.md, Elevation & Depth): a still star field where a
    dozen stars twinkle softly (their places and rhythms are in shell.css, as
    the CSP forbids inline styles), faint scanlines and a vignette, fixed
    under every other layer. Kept across visits by Turbo; the stars never move
    at a screen change. %>
<div id="atmosphere" class="atmosphere" data-turbo-permanent aria-hidden="true">
  <div class="atmosphere__stars" data-controller="starfield"></div>
  <div class="atmosphere__twinkle">
    <% 12.times do %><i></i><% end %>
  </div>
  <div class="atmosphere__scanlines"></div>
  <div class="atmosphere__vignette"></div>
</div>
