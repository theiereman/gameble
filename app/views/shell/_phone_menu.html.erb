<div class="phone-menu">
  <button type="button" class="phone-menu__button" popovertarget="phone-menu-panel">
    <%= pixel_icon("menu", class: "phone-menu__icon") %>
    <span class="visually-hidden"><%= t("shell.phone_menu.label") %></span>
    <span id="phone-menu-badge" class="stream-slot"><%= render "shell/phone_menu_badge", unclaimed: shell_achievements_unclaimed %></span>
  </button>
  <nav id="phone-menu-panel" class="phone-menu__panel shell-popover" popover aria-label="<%= t("shell.phone_menu.label") %>">
    <ul class="player-menu__list">
      <li><%= link_to t("shell.player.profile"), me_path, class: "player-menu__item", data: { turbo_prefetch: false } %></li>
      <li><%= link_to t("shell.phone_menu.how_it_works"), how_it_works_path, class: "player-menu__item", data: { turbo_prefetch: false } %></li>
      <li><%= link_to t("shell.player.settings"), settings_path, class: "player-menu__item", data: { turbo_prefetch: false } %></li>
      <li><%= donation_menu_item_to t("shell.phone_menu.support"), class: "player-menu__item" %></li>
      <li><%= source_code_menu_item_to t("shell.phone_menu.source_code"), class: "player-menu__item" %></li>
    </ul>
  </nav>
</div>
