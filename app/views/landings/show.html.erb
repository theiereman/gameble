<% content_for :public_page, true %>
<% content_for :title, t("landings.show.title") %>
<% content_for :head, render("landings/search_tags") if Rails.configuration.x.search_indexing %>
<% content_for :page_footer do %>
  <%= render "landings/footer" %>
<% end %>
<% content_for :page_aside do %>
  <%= render "landings/moving_cards", samples: @samples %>
  <%= render "landings/side_gauge" %>
<% end %>
<% covers = landing_covers(@samples) %>
<div class="landing" data-controller="power-on">
  <%= render "landings/hero", samples: @samples %>
  <%= render "landings/concept", samples: @samples %>
  <%= render "landings/brotherhood", covers: covers %>
  <%= render "landings/how", covers: covers %>
  <%= render "landings/live" %>
  <%= render "landings/unlock", covers: covers %>
  <%= render "landings/roadmap", milestones: @roadmap %>
  <%= render "landings/open_source" %>
  <%= render "landings/free" %>
  <%= render "landings/boarding" %>
</div>
