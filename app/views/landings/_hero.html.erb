<section class="landing-hero">
  <div class="landing-hero__copy">
    <p class="landing-hero__kicker landing-kicker">
      <span class="landing-light" aria-hidden="true"></span>
      <span><%= t("landings.show.hero.kicker") %></span>
    </p>
    <h1 class="landing-hero__hook" tabindex="-1"><%= t("landings.show.hero.hook") %></h1>
    <p class="landing-hero__line"><%= t("landings.show.hero.line") %></p>
    <div class="landing-hero__action">
      <%= link_to home_path, class: "button button--primary landing-hero__embark", aria: { label: t("landings.show.hero.embark_label") } do %>
        <%= t("landings.show.hero.embark") %>
      <% end %>
    </div>
  </div>
  <div class="landing-hero__field" aria-hidden="true"></div>
</section>
