<section class="landing-module landing-boarding">
  <%= render PanelComponent.new(brackets: true, class: "landing-boarding__panel") do %>
    <div class="landing-boarding__copy">
      <%= landing_module_heading(:boarding, id: "landing-boarding", modifier: :banner) %>
      <p class="landing-body"><%= t("landings.show.boarding.line") %></p>
      <p class="landing-boarding__reserve">
        <%= landing_pips(LandingsHelper::RESERVE_CELLS) %>
        <span><%= t("landings.show.boarding.reserve") %></span>
      </p>
    </div>
    <div class="landing-boarding__actions">
      <%= render SteamSignInComponent.new(origin: request.path) %>
      <%= render "shell/sign_in_acceptance" %>
    </div>
  <% end %>
</section>
