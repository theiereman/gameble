<% description = t("landings.show.description") %>
<% url = current_language_url(:home_path) %>
<% image = public_url_for(vite_asset_path("images/share/landing-#{I18n.locale}.png")) %>
<%= tag.meta name: "description", content: description %>
<%= render "layouts/language_links", route: :home_path %>
<%= tag.meta property: "og:type", content: "website" %>
<%= tag.meta property: "og:site_name", content: t("layouts.application.application_name") %>
<%= tag.meta property: "og:title", content: t("landings.show.title") %>
<%= tag.meta property: "og:description", content: description %>
<%= tag.meta property: "og:url", content: url %>
<%= tag.meta property: "og:locale", content: og_locale %>
<% I18n.available_locales.map(&:to_s).excluding(I18n.locale.to_s).each do |locale| %>
  <%= tag.meta property: "og:locale:alternate", content: og_locale_for(locale) %>
<% end %>
<%= tag.meta property: "og:image", content: image %>
<%= tag.meta property: "og:image:type", content: "image/png" %>
<%= tag.meta property: "og:image:width", content: CardShareImage::WIDTH %>
<%= tag.meta property: "og:image:height", content: CardShareImage::HEIGHT %>
<%= tag.meta property: "og:image:alt", content: t("landings.show.share_image_alt") %>
<%= tag.meta name: "twitter:card", content: "summary_large_image" %>
<%= tag.meta name: "twitter:image", content: image %>
<%= tag.meta name: "twitter:image:alt", content: t("landings.show.share_image_alt") %>
<%= tag.script landing_structured_data.html_safe, type: "application/ld+json" %>
