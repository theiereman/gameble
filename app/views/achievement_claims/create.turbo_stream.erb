<% if @tile %>
  <%= turbo_stream.replace "achievement-#{@tile.key}", partial: "achievements/tile", locals: { tile: @tile } %>
  <%= turbo_stream_action_tag "gameble-focus", target: "achievement-#{@tile.key}" %>
<% end %>
<%= turbo_stream.update "menu-achievements-badge", partial: "pages/menu_achievements_badge", locals: { unclaimed: @unclaimed } %>
<%= turbo_stream.update "plus-achievements-badge", partial: "pages/menu_achievements_badge", locals: { unclaimed: @unclaimed } %>
<%= turbo_stream.update "tab-me-badge", partial: "shell/tab_achievements_badge", locals: { unclaimed: @unclaimed } %>
<%= turbo_stream.append "toasts" do %><%= render ToastComponent.new(message: @message, tone: @tone) %><% end %>
