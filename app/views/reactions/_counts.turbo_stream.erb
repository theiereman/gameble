<% summaries.each do |token, summary| %>
  <% summary.counts.each do |kind, count| %>
    <%= turbo_stream.update_all ReactionStream.count_targets(token, kind), reaction_count_text(count) %>
    <%= turbo_stream.update_all ReactionStream.names_targets(token, kind) do %><%= render "reactions/who", kind:, count:, names: summary.names.fetch(kind) %><% end %>
  <% end %>
<% end %>
