<% if items.any? %>
  <%= turbo_stream.prepend "feed-entries" do %>
    <% preload_avatars(items.map { it.first.player }) %>
    <% items.each do |item, card, partner_card, set| %>
      <%= render "feeds/entry", item:, card:, partner_card:, set:, reactions:, lazy: true, post: true %>
    <% end %>
  <% end %>
<% end %>
<% if ticker.any? %>
  <%= turbo_stream.prepend "live-ticker-queue" do %>
    <% ticker.each do |item, card, partner_card, set| %>
      <%= render "shell/ticker_item", item:, card:, partner_card:, set: %>
    <% end %>
  <% end %>
<% end %>
<%= turbo_stream.replace "live-strip", partial: "shell/live_strip_body", locals: { items: strip } %>
