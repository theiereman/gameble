<% unless waiting.nil? %>
  <%= turbo_stream.update "menu-trades-badge", partial: "pages/menu_trades_badge", locals: { waiting: } %>
  <%= turbo_stream.update "tab-trades-badge", partial: "shell/tab_trades_badge", locals: { waiting: } %>
<% end %>
<% unless invitations.nil? %>
  <%= turbo_stream.update "menu-friends-badge", partial: "pages/menu_invitations_badge", locals: { invitations: } %>
  <%= turbo_stream.update "tab-invitations-badge", partial: "shell/tab_invitations_badge", locals: { invitations: } %>
<% end %>
<% unless unclaimed.nil? %>
  <%= turbo_stream.update "menu-achievements-badge", partial: "pages/menu_achievements_badge", locals: { unclaimed: } %>
  <%= turbo_stream.update "plus-achievements-badge", partial: "pages/menu_achievements_badge", locals: { unclaimed: } %>
  <%= turbo_stream.update "phone-menu-badge", partial: "shell/phone_menu_badge", locals: { unclaimed: } %>
<% end %>
<% friends.each do |friend| %>
  <%= turbo_stream.append "toasts", ToastComponent.new(title: t("invitations.new_friend.title"),
        message: t("invitations.new_friend.text", name: friend_name(friend))) %>
<% end %>
<% achievements.each do |achievement| %>
  <%= turbo_stream.append "toasts", ToastComponent.new(title: t("achievements.unlocked.title"), message: t("achievements.names.#{achievement}"),
        after_reveal: true) %>
<% end %>
<% card_backs.each do |key| %>
  <%= turbo_stream.append "toasts", ToastComponent.new(title: t("card_backs.unlocked.title"), message: card_back_name(Game::CardBacks.find(key)),
        after_reveal: true) %>
<% end %>
<% signals.each do |signal| %>
  <%= turbo_stream_action_tag "gameble-event", event: signal %>
<% end %>
