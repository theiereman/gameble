<%= turbo_stream.replace "packs-chip", partial: "shell/packs_chip", locals: { bank: @bank, refresh: false } %>
<%= turbo_stream.replace "rarity-counter", partial: "shell/rarity_counter", locals: { counts: shell_tier_counts } %>
<%= turbo_stream.update "player-menu-badge", partial: "shell/player_menu_badge", locals: { pending: shell_player_pending } %>
<% if native_top_bar? %>
  <%= turbo_stream.update "tab-trades-badge", partial: "shell/tab_trades_badge", locals: { waiting: shell_trades_waiting } %>
  <%= turbo_stream.update "player-menu-invitations-badge", partial: "pages/menu_invitations_badge", locals: { invitations: shell_invitations_waiting } %>
<% end %>
