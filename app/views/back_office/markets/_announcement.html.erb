<fieldset class="stack market-announcement" <%= tag.attributes(disabled:, aria: { describedby: (reason_id if disabled) }) %>>
  <legend><%= legend %></legend>
  <p class="ban-form__hint"><%= t("back_office.markets.announcement.hint", length: Accounts::Announcement::MESSAGE_LENGTH) %></p>
  <%= render "back_office/announcements/fields", dom:, scope:, message_fr: opening.message_fr, message_en: opening.message_en, disabled: %>
</fieldset>
