<%# locals: (key:, label:, align: nil) %>
<% id = "market-settings-help-#{key.to_s.dasherize}" %>
<% help = t("back_office.markets.settings.help.#{key}") %>
<button type="button" class="market-settings__help-button" data-tip="<%= help %>" data-market-settings-help="<%= key %>" <%= tag.attributes(data: { tip_align: align }) %>
        aria-label="<%= t("back_office.markets.settings.help_button", label:) %>" aria-describedby="<%= id %>">i</button>
<span id="<%= id %>" class="visually-hidden"><%= help %></span>
