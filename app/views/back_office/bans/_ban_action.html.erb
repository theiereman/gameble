<%# locals: (player:, name:, back: {}) %>
<% refusal = Accounts::BanPlayer.refusal(staff: current_player, player:) %>
<% if refusal %>
  <span data-ban-refusal="<%= refusal %>"><%= Accounts::BanPlayer.failure_message(refusal) %></span>
<% else %>
  <%= form_with url: back_office_bans_path, method: :post, class: "ban-form",
        data: { turbo_confirm: t("back_office.bans.actions.ban_confirm", name:) } do %>
    <%= hidden_field_tag :token, player.token, id: nil %>
    <% back.each do |key, value| %>
      <%= hidden_field_tag key, value, id: nil %>
    <% end %>
    <% field_id = "ban-reason-#{player.token}" %>
    <% hint_id = "ban-reason-hint-#{player.token}" %>
    <label class="visually-hidden" for="<%= field_id %>"><%= t("back_office.bans.actions.reason_label", name:) %></label>
    <%= text_field_tag :reason, nil, id: field_id, class: "ban-form__field", required: true, maxlength: Accounts::BanReason::LENGTH,
          autocomplete: "off", placeholder: t("back_office.bans.actions.reason_placeholder"), aria: { describedby: hint_id } %>
    <%= render ButtonComponent.new(variant: :danger, size: :small, type: :submit) do %><%= t("back_office.bans.actions.ban") %><% end %>
    <p id="<%= hint_id %>" class="ban-form__hint"><%= t("back_office.bans.actions.reason_hint") %></p>
  <% end %>
<% end %>
