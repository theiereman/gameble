<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <p><%= link_to t(".all_runs"), back_office_import_runs_path %></p>

  <%= turbo_frame_tag "import_run", target: "_top", aria: { live: "polite" } do %>
    <div class="stack" <% if @import_run.active? %>data-controller="poller" data-poller-url-value="<%= back_office_import_run_path(@import_run) %>" data-poller-interval-value="3000"<% end %>>
      <dl class="ledger-entry">
        <dt><%= t(".status") %></dt>
        <dd data-import-run-status="<%= @import_run.status %>"><%= t("back_office.import_runs.statuses.#{@import_run.status}") %></dd>
        <dt><%= t(".step") %></dt>
        <dd data-import-run-step="<%= @import_run.step %>"><%= @import_run.step ? t("back_office.import_runs.steps.#{@import_run.step}") : "—" %> <% if @import_run.step %><code><%= @import_run.step %></code><% end %></dd>
        <dt><%= t(".apps_listed") %></dt>
        <dd data-import-run-apps-listed="<%= @import_run.apps_listed %>"><%= number_with_delimiter(@import_run.apps_listed) %></dd>
        <% if @import_run.reached?("reviews") %>
          <dt><%= t(".apps_reviewed") %></dt>
          <dd data-import-run-apps-reviewed="<%= @import_run.apps_reviewed %>"><%= number_with_delimiter(@import_run.apps_reviewed) %></dd>
          <dt><%= t(".apps_kept") %></dt>
          <dd data-import-run-apps-kept="<%= @import_run.apps_kept %>"><%= number_with_delimiter(@import_run.apps_kept) %></dd>
          <dt><%= t(".apps_excluded") %></dt>
          <dd data-import-run-apps-excluded="<%= @import_run.apps_excluded %>"><%= number_with_delimiter(@import_run.apps_excluded) %></dd>
        <% end %>
        <% if @import_run.reached?("tags") %>
          <dt><%= t(".tags_named") %></dt>
          <dd data-import-run-tags-named="<%= @import_run.tags_named %>"><%= number_with_delimiter(@import_run.tags_named) %></dd>
        <% end %>
        <% if @import_run.reached?("details") %>
          <dt><%= t(".apps_detailed") %></dt>
          <dd data-import-run-apps-detailed="<%= @import_run.apps_detailed %>"><%= number_with_delimiter(@import_run.apps_detailed) %></dd>
          <dt><%= t(".apps_excluded_details") %></dt>
          <dd data-import-run-apps-excluded-details="<%= @import_run.apps_excluded_details %>"><%= number_with_delimiter(@import_run.apps_excluded_details) %></dd>
        <% end %>
        <% if @import_run.reached?("cards") %>
          <dt><%= t(".cards_written") %></dt>
          <dd data-import-run-cards-written="<%= @import_run.cards_written %>"><%= number_with_delimiter(@import_run.cards_written) %></dd>
          <dt><%= t(".cards_refused") %></dt>
          <dd data-import-run-cards-refused="<%= @import_run.cards_refused %>"><%= number_with_delimiter(@import_run.cards_refused) %></dd>
        <% end %>
        <dt><%= t(".cursor") %></dt>
        <dd><%= @import_run.last_appid %></dd>
        <dt><%= t(".started_at") %></dt>
        <dd><%= render "back_office/import_runs/time", time: @import_run.started_at %></dd>
        <dt><%= t(".finished_at") %></dt>
        <dd><%= render "back_office/import_runs/time", time: @import_run.finished_at %></dd>
      </dl>

      <% if @review %>
        <section class="stack" aria-labelledby="import-run-review" data-import-run-review>
          <h2 id="import-run-review"><%= t(".review_heading") %></h2>
          <%= render PanelComponent.new(tag: :p) do %><%= t(".review_intro") %><% end %>
          <table class="ledger">
            <caption class="visually-hidden"><%= t(".review_gap_caption") %></caption>
            <tbody>
              <% { staged: @review.staged_count, draft: @review.draft_count, added: @review.added, removed: @review.removed, rescored: @review.rescored }.each do |name, count| %>
                <tr>
                  <th scope="row"><%= t(".#{name}_cards") %></th>
                  <td data-import-run-review-<%= name %>="<%= count %>"><%= number_with_delimiter(count) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @review.draft_panel&.tiers %>
            <h3><%= t(".draft_spread") %></h3>
            <table class="ledger">
              <caption class="visually-hidden"><%= t(".draft_spread_caption") %></caption>
              <thead>
                <tr>
                  <th scope="col"><%= t(".tier") %></th>
                  <th scope="col"><%= t(".cards") %></th>
                </tr>
              </thead>
              <tbody>
                <% @review.draft_panel.tiers.each do |tier| %>
                  <% name = Catalog::Rarity::TIERS.fetch(tier.tier) %>
                  <tr>
                    <th scope="row"><%= t("catalog.rarity.#{name}") %></th>
                    <td data-import-run-review-draft-tier="<%= name %>"><%= number_with_delimiter(tier.card_count) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% end %>
          <%= render "back_office/seasons/preview", panel: @review.panel, heading: t(".preview_heading"), intro: t(".preview_intro") %>
          <p>
            <%= render ButtonComponent.new(variant: :primary, href: promote_back_office_import_run_path(@import_run), method: :post,
                  confirm: t(".promote_confirm")) do %><%= t(".promote") %><% end %>
            <%= render ButtonComponent.new(variant: :secondary, href: discard_back_office_import_run_path(@import_run), method: :post,
                  confirm: t(".discard_confirm")) do %><%= t(".discard") %><% end %>
          </p>
        </section>
      <% end %>

      <% if @resumable %>
        <p>
          <%= render ButtonComponent.new(variant: :primary, href: resume_back_office_import_run_path(@import_run), method: :post, turbo: false) do %><%= t(".resume") %><% end %>
        </p>
      <% end %>

      <% errors = @import_run.latest_errors %>
      <% if errors.any? %>
        <section class="stack" aria-labelledby="import-run-errors">
          <h2 id="import-run-errors"><%= t(".errors") %></h2>
          <ul class="ledger-errors">
            <% errors.each do |error| %>
              <li><%= render "back_office/import_runs/time", time: error.at %> — <%= error.message %></li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @rescorable %>
        <p>
          <%= render ButtonComponent.new(variant: :secondary, href: rescore_back_office_import_run_path(@import_run), method: :post,
                confirm: t(".rescore_confirm")) do %><%= t(".rescore") %><% end %>
        </p>
      <% end %>
      <% if @abandon_refusal.nil? %>
        <p>
          <%= render ButtonComponent.new(variant: :secondary, href: abandon_back_office_import_run_path(@import_run), method: :post,
                confirm: t(".abandon_confirm")) do %><%= t(".abandon") %><% end %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
