<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render TextPlateComponent.new(tag: :p) do %>
    <%= t(".empty") %>
  <% end %>

  <% if policy([ :back_office, :jobs ]).show? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: mission_control_jobs.root_path(locale: nil), turbo: false) do %><%= t(".jobs") %><% end %>
    </p>
  <% end %>
</div>
