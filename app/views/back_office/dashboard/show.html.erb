<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render PanelComponent.new(tag: :p, data: { report_queue_size: @queue_size }) do %>
    <%= t(".queue", count: @queue_size) %>
  <% end %>

  <% if policy([ :back_office, :players ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_players_path) do %><%= t(".players") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :reports ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_reports_path) do %><%= t(".reports") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :bans ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_bans_path) do %><%= t(".bans") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :history ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_history_path) do %><%= t(".history") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :import_runs ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_import_runs_path) do %><%= t(".import_runs") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :seasons ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_seasons_path) do %><%= t(".seasons") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :roadmap ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_roadmap_milestones_path) do %><%= t(".roadmap") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :themes ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_themes_path) do %><%= t(".themes") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :cards ]).index? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: back_office_cards_path) do %><%= t(".cards") %><% end %>
    </p>
  <% end %>

  <% if policy([ :back_office, :jobs ]).show? %>
    <p>
      <%= render ButtonComponent.new(variant: :secondary, href: mission_control_jobs.root_path(locale: nil), turbo: false) do %><%= t(".jobs") %><% end %>
    </p>
  <% end %>
</div>
