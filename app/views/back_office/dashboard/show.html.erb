<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <% back_office_groups.each do |group, tiles| %>
    <section class="office-group" aria-labelledby="office-group-<%= group %>">
      <h2 class="office-group__heading" id="office-group-<%= group %>"><%= t(".groups.#{group}") %></h2>
      <ul class="office-tiles">
        <% tiles.each do |tile| %>
          <li><%= render BackOfficeTileComponent.new(tile:) %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
