<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render PanelComponent.new(tag: :p) do %>
    <%= t(".intro") %>
  <% end %>

  <%= form_with url: back_office_players_path, method: :get, class: "ledger-search", html: { role: "search" } do %>
    <label class="visually-hidden" for="player-search"><%= t(".search_label") %></label>
    <%= search_field_tag "q", @query, id: "player-search", class: "ledger-search__field", autocomplete: "off",
          maxlength: Accounts::PlayerSearch::MAX_QUERY, placeholder: t(".search_placeholder") %>
    <%= render ButtonComponent.new(variant: :secondary, type: :submit) do %><%= t(".search_submit") %><% end %>
  <% end %>

  <% if @players.empty? %>
    <%= render PanelComponent.new(tag: :p, data: { player_search_empty: true }) do %>
      <%= @query.present? ? t(".no_match", query: @query) : t(".empty") %>
    <% end %>
  <% else %>
    <table class="ledger">
      <caption class="visually-hidden"><%= t(".caption") %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t(".player") %></th>
          <th scope="col"><%= t(".role") %></th>
          <th scope="col"><%= t(".visibility") %></th>
          <th scope="col"><%= t(".state") %></th>
          <th scope="col"><span class="visually-hidden"><%= t(".action") %></span></th>
          <th scope="col"><span class="visually-hidden"><%= t(".history_column") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% back = { return_to: "players", q: @query.presence, page: (@pagy.page if @pagy.page > 1) }.compact %>
        <% @players.each do |player| %>
          <% name = public_profile_title(player) %>
          <tr data-player-token="<%= player.token %>">
            <td><%= link_to name, brother_path(token: player.token) %></td>
            <td data-player-role="<%= player.role %>"><%= t(".roles.#{player.role}") %></td>
            <td data-player-visibility="<%= player.visibility %>"><%= t("settings.show.visibility.#{player.visibility}") %></td>
            <% if player.banned? %>
              <td data-player-state="banned"><%= t(".states.banned") %></td>
              <td><%= render "back_office/bans/unban_action", player:, name:, back: %></td>
            <% else %>
              <td data-player-state="good_standing"><%= t(".states.good_standing") %></td>
              <td><%= render "back_office/bans/ban_action", player:, name:, back: %></td>
            <% end %>
            <td data-player-history><%= link_to t(".history_link"), back_office_history_path(player: player.token) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @pagy.last > 1 %>
      <%= @pagy.series_nav.html_safe %>
    <% end %>
  <% end %>

  <p>
    <%= render ButtonComponent.new(variant: :secondary, href: back_office_reports_path) do %><%= t(".reports") %><% end %>
  </p>
  <p>
    <%= render ButtonComponent.new(variant: :secondary, href: back_office_history_path) do %><%= t(".history") %><% end %>
  </p>
</div>
