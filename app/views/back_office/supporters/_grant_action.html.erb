<%# locals: (player:, name:, back: {}) %>
<% if !Game::GrantSupporter.refusal(staff: current_player, player:) %>
  <%= render ButtonComponent.new(variant: :secondary, size: :small, href: back_office_supporters_path, method: :post,
        params: back.except(:return_to).merge(token: player.token), confirm: t("back_office.supporters.actions.grant_confirm", name:)) do %><%= t("back_office.supporters.actions.grant") %><% end %>
<% elsif !Game::RevokeSupporter.refusal(staff: current_player, player:) %>
  <%= render ButtonComponent.new(variant: :secondary, size: :small, href: back_office_supporter_path(token: player.token), method: :delete,
        params: back.except(:return_to), confirm: t("back_office.supporters.actions.revoke_confirm", name:)) do %><%= t("back_office.supporters.actions.revoke") %><% end %>
<% end %>
