<%# locals: (player:, name:, back: {}) %>
<% unless Game::GrantCodeContribution.refusal(staff: current_player, player:) %>
  <%= render ButtonComponent.new(variant: :secondary, size: :small, href: back_office_code_contributions_path, method: :post,
        params: back.except(:return_to).merge(token: player.token), confirm: t("back_office.code_contributions.actions.grant_confirm", name:)) do %><%= t("back_office.code_contributions.actions.grant") %><% end %>
<% end %>
