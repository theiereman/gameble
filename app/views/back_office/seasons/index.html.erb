<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render PanelComponent.new(tag: :p) do %>
    <%= t(".intro") %>
  <% end %>

  <% if @seasons.empty? %>
    <%= render PanelComponent.new(tag: :p) do %>
      <%= t(".empty") %>
    <% end %>
  <% else %>
    <table class="ledger">
      <caption class="visually-hidden"><%= t(".caption") %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t(".number") %></th>
          <th scope="col"><%= t(".status") %></th>
          <th scope="col"><%= t(".card_count") %></th>
          <th scope="col"><%= t(".published_at") %></th>
          <% Catalog::Rarity::TIERS.each_value do |name| %>
            <th scope="col"><%= t("catalog.rarity.#{name}") %></th>
          <% end %>
          <% Catalog::Set.kinds.each_key do |kind| %>
            <th scope="col"><%= t(".sets.#{kind}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @seasons.each do |season| %>
          <tr data-season-number="<%= season.number %>" data-season-status="<%= season.status %>">
            <td><%= link_to season.number, back_office_season_path(season.number) %></td>
            <td><%= t("back_office.seasons.statuses.#{season.status}") %></td>
            <td data-season-card-count="<%= season.card_count %>"><%= number_with_delimiter(season.card_count) %></td>
            <td><%= render "back_office/import_runs/time", time: season.published_at %></td>
            <% Catalog::Rarity::TIERS.each do |tier, name| %>
              <% if season.tier_counts %>
                <td data-season-tier="<%= name %>"><%= number_with_delimiter(season.tier_counts.fetch(tier)) %></td>
              <% else %>
                <td>—</td>
              <% end %>
            <% end %>
            <% Catalog::Set.kinds.each_key do |kind| %>
              <% if season.set_counts %>
                <td data-season-sets-<%= kind.dasherize %>="<%= season.set_counts.fetch(kind) %>"><%= number_with_delimiter(season.set_counts.fetch(kind)) %></td>
              <% else %>
                <td>—</td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% draft = @seasons.find(&:draft?) %>
  <% if draft %>
    <% if @preview %>
      <%= render "preview", panel: @preview, heading: t("back_office.seasons.preview.heading", number: draft.number), intro: t("back_office.seasons.preview.intro") %>
    <% end %>

    <% if @unfinished_import %>
      <%= render PanelComponent.new(tag: :p) do %>
        <%= @unfinished_import.ready? ? t("back_office.seasons.publish.import_awaiting_promotion") : t("back_office.seasons.publish.import_active") %>
      <% end %>
    <% end %>
    <p>
      <%= render ButtonComponent.new(variant: :primary, href: publish_back_office_seasons_path, method: :post, params: { number: draft.number },
            confirm: t(".confirm", number: draft.number, count: draft.card_count)) do %><%= t(".publish", number: draft.number) %><% end %>
    </p>
  <% end %>
</div>
