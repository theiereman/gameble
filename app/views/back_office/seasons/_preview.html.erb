<section class="stack" aria-labelledby="score-panel" data-preview>
  <h2 id="score-panel"><%= heading %></h2>

  <%= render PanelComponent.new(tag: :p) do %>
    <%= intro %>
  <% end %>

  <% if panel.empty_season? %>
    <%= render PanelComponent.new(tag: :p) do %>
      <span data-preview-verdict="empty_season"><%= Catalog::PublishSeason.failure_message(:empty_season) %></span>
    <% end %>
  <% else %>
    <h3><%= t(".scores") %></h3>
    <p data-preview-card-count="<%= panel.card_count %>"><%= t(".card_count", count: panel.card_count, formatted: number_with_delimiter(panel.card_count)) %></p>
    <table class="ledger">
      <caption class="visually-hidden"><%= t(".scores_caption") %></caption>
      <thead>
        <tr>
          <th scope="col"><%= t(".min") %></th>
          <% panel.percentiles.each_key do |p| %>
            <th scope="col"><%= t(".percentile", p:) %></th>
          <% end %>
          <th scope="col"><%= t(".max") %></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-preview-percentile="min"><%= number_with_precision(panel.min, precision: 3, delimiter: t("number.format.delimiter")) %></td>
          <% panel.percentiles.each do |p, score| %>
            <td data-preview-percentile="p<%= p %>"><%= number_with_precision(score, precision: 3, delimiter: t("number.format.delimiter")) %></td>
          <% end %>
          <td data-preview-percentile="max"><%= number_with_precision(panel.max, precision: 3, delimiter: t("number.format.delimiter")) %></td>
        </tr>
      </tbody>
    </table>

    <h3><%= t(".tiers") %></h3>
    <% if panel.score_version_verdict %>
      <%= render PanelComponent.new(tag: :p) do %>
        <span data-preview-verdict="<%= panel.score_version_verdict %>"><%= Catalog::PublishSeason.failure_message(panel.score_version_verdict) %></span>
      <% end %>
    <% end %>
    <% if panel.tiers %>
      <table class="ledger">
        <caption class="visually-hidden"><%= t(".tiers") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t(".tier") %></th>
            <th scope="col"><%= t(".cards") %></th>
            <th scope="col"><%= t(".threshold") %></th>
          </tr>
        </thead>
        <tbody>
          <% panel.tiers.each do |tier| %>
            <% name = Catalog::Rarity::TIERS.fetch(tier.tier) %>
            <tr>
              <th scope="row"><%= t("catalog.rarity.#{name}") %></th>
              <td data-preview-tier="<%= name %>"><%= number_with_delimiter(tier.card_count) %></td>
              <% if tier.threshold %>
                <td data-preview-threshold="<%= name %>"><%= number_with_precision(tier.threshold, precision: 3, delimiter: t("number.format.delimiter")) %></td>
              <% else %>
                <td>—</td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <%= render PanelComponent.new(tag: :p) do %>
        <span data-preview-verdict="empty_tier"><%= Catalog::PublishSeason.failure_message(:empty_tier) %></span>
      <% end %>
    <% end %>

    <% [ [ :top, panel.top, t(".top", count: panel.top.size) ], [ :bottom, panel.bottom, t(".bottom", count: panel.bottom.size) ] ].each do |end_name, entries, end_heading| %>
      <h3><%= end_heading %></h3>
      <table class="ledger">
        <caption class="visually-hidden"><%= end_heading %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t(".rank") %></th>
            <th scope="col"><%= t(".title") %></th>
            <th scope="col"><%= t(".rating") %></th>
            <th scope="col"><%= t(".prestige_score") %></th>
          </tr>
        </thead>
        <tbody>
          <% entries.each.with_index(1) do |entry, rank| %>
            <tr data-preview-<%= end_name %>="<%= rank %>">
              <td><%= rank %></td>
              <td><%= entry.title || "—" %></td>
              <td><%= number_to_percentage(entry.rating, precision: 0) %></td>
              <td><%= number_with_precision(entry.prestige_score, precision: 3, delimiter: t("number.format.delimiter")) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <h3><%= t(".themes") %></h3>
    <% if panel.sources_verdict %>
      <%= render PanelComponent.new(tag: :p) do %>
        <span data-preview-verdict="<%= panel.sources_verdict %>"><%= Catalog::PublishSeason.failure_message(panel.sources_verdict) %></span>
      <% end %>
    <% end %>
    <% if panel.ufo_count.nil? %>
      <p data-preview-no-themes><%= t(".no_themes") %></p>
    <% else %>
      <p data-preview-ufo-count="<%= panel.ufo_count %>" <%= "data-preview-ufo-over-limit" if panel.ufo_share_over_limit? %>>
        <%= t(".ufos", count: panel.ufo_count, formatted: number_with_delimiter(panel.ufo_count),
          share: number_to_percentage(panel.ufo_share * 100, precision: 1)) %>
      </p>
    <% end %>
    <% { classification_verdict: panel.classification_verdict, ufo_verdict: panel.ufo_verdict }.each_value do |verdict| %>
      <% next unless verdict %>
      <%= render PanelComponent.new(tag: :p) do %>
        <span data-preview-verdict="<%= verdict %>"><%= Catalog::PublishSeason.refusal_message(verdict, panel) %></span>
      <% end %>
    <% end %>
    <% if panel.rescore_verdict %>
      <%= render PanelComponent.new(tag: :p) do %>
        <span data-preview-verdict="<%= panel.rescore_verdict %>"><%= t(".rescore_needed") %></span>
      <% end %>
    <% end %>
    <% if panel.themes.any? %>
      <table class="ledger">
        <caption class="visually-hidden"><%= t(".themes") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t(".theme") %></th>
            <th scope="col"><%= t(".cards") %></th>
          </tr>
        </thead>
        <tbody>
          <% panel.themes.each do |theme| %>
            <tr data-preview-theme="<%= theme.theme %>">
              <th scope="row"><%= SetLabel.genre(theme.theme) %></th>
              <td><%= number_with_delimiter(theme.card_count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <h3><%= t(".sets") %></h3>
    <table class="ledger">
      <caption class="visually-hidden"><%= t(".sets") %></caption>
      <thead>
        <tr>
          <% panel.set_counts.each_key do |kind| %>
            <th scope="col"><%= t("back_office.seasons.index.sets.#{kind}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <% panel.set_counts.each do |kind, count| %>
            <td data-preview-set-kind="<%= kind.dasherize %>"><%= number_with_delimiter(count) %></td>
          <% end %>
        </tr>
      </tbody>
    </table>
  <% end %>
</section>
