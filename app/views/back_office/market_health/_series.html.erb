<%# locals: (series:, income_rarity:) %>
<section class="stack" id="health-series" aria-labelledby="health-series-heading" data-health-series>
  <h2 id="health-series-heading"><%= t("back_office.market_health.show.series.heading") %></h2>
  <div class="market-health__charts">
    <% { destroyed_share: series.destroyed_share, picoins_per_player: series.picoins_per_player, top_share: series.top_share }.each do |key, indicator| %>
      <%= render ChartComponent.new(drawing: indicator_drawing(key, indicator, series.days), id: "health-chart-#{key.to_s.dasherize}") %>
    <% end %>
    <div class="market-health__income-chart">
      <nav class="market-health__rarity-chips" aria-label="<%= t("back_office.market_health.show.series.rarities") %>">
        <% indicator_rarities.each do |rarity| %>
          <% if rarity == income_rarity %>
            <span class="market-screen__chip market-screen__chip--current" aria-current="true"><%= health_rarity_name(rarity) %></span>
          <% else %>
            <%= link_to health_rarity_name(rarity), back_office_market_health_path(rarity:, anchor: "health-series"), class: "market-screen__chip" %>
          <% end %>
        <% end %>
      </nav>
      <%= render ChartComponent.new(drawing: indicator_drawing(:days_of_income, series.days_of_income.fetch(income_rarity), series.days, rarity: income_rarity),
            id: "health-chart-days-of-income") %>
    </div>
  </div>
</section>
