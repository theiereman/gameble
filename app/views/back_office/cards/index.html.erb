<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render PanelComponent.new(tag: :p) do %>
    <%= t(".intro") %>
  <% end %>

  <div class="card-preview">
    <% @specimens.each do |specimen| %>
      <figure class="card-preview__item" data-specimen="<%= specimen[:specimen] %>">
        <figcaption class="card-preview__label"><%= specimen[:label] %></figcaption>
        <%= render CardComponent.new(card: specimen[:card], size: specimen[:size], booster: specimen[:booster]) %>
      </figure>
    <% end %>
  </div>
</div>
