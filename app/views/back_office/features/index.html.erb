<% content_for :back_button, true %>

<div class="stack">
  <h1><%= t(".heading") %></h1>

  <%= render PanelComponent.new(tag: :p) do %>
    <%= t(".intro") %>
  <% end %>

  <% Game::FeatureFlag::KEYS.each do |key| %>
    <% on = @enabled.include?(key) %>
    <%= render PanelComponent.new(tag: :section, aria: { labelledby: "feature-#{key}" }, data: { feature: key, enabled: on }) do %>
      <h2 id="feature-<%= key %>"><%= t(".names.#{key}") %> · <%= t(on ? ".enabled" : ".disabled") %></h2>
      <p><%= t(".descriptions.#{key}") %></p>
      <%= button_to t(on ? ".turn_off" : ".turn_on"), back_office_feature_path(key:), method: :patch, params: { enabled: on ? "0" : "1" },
            class: class_names("button", "button--secondary": on) %>
    <% end %>
  <% end %>
</div>
