<%# locals: (id:, heading:, screen:, side:) %>
<section id="<%= id %>" class="duel-side" aria-labelledby="<%= id %>-heading">
  <h2 id="<%= id %>-heading" class="duel-board__heading"><%= heading %></h2>
  <ol class="duel-side__cards">
    <% side.deck.each do |card| %>
      <% played = screen.played?(side, card) %>
      <li class="<%= class_names("duel-side__card", "duel-side__card--played": played) %>">
        <span><%= screen.title(card) %></span>
        <% if played %><span class="duel-side__played"><%= t("duels.board.played") %></span><% end %>
      </li>
    <% end %>
  </ol>
  <p class="duel-side__calls"><%= t("duels.board.calls_left", stats: duel_stat_names(side.stats_left)) %></p>
</section>
