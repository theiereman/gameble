<%# locals: (screen:) %>
<%= render PanelComponent.new(tag: :section, id: "duel-table", class: "duel-table", aria: { labelledby: "duel-table-heading" }) do %>
  <h2 id="duel-table-heading" class="duel-board__heading"><%= t("duels.board.table") %></h2>
  <% if screen.turn == :call %>
    <%= render(layout: "duels/call_form", locals: { screen: }) { render "duels/slots", screen: } %>
  <% elsif screen.turn == :answer %>
    <%= render(layout: "duels/answer_form", locals: { screen: }) { render "duels/slots", screen: } %>
  <% else %>
    <%= tag.div class: "duel-table__slots", data: { mirrored: (true unless screen.caller_side?) } do %><%= render "duels/slots", screen: screen %><% end %>
  <% end %>
  <% if (reveal = screen.reveal) %><%= render "duels/reveal", screen: screen, reveal: reveal %><% end %>
  <% if screen.reveals.any? %><%= render "duels/past_rounds", screen: screen %><% end %>
<% end %>
