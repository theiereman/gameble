<%# locals: (screen:) %>
<section id="duel-hand" class="duel-hand">
  <% if screen.turn == :call %>
    <%= render "duels/call_form", screen: screen %>
  <% elsif screen.turn == :answer %>
    <%= render "duels/answer_form", screen: screen %>
  <% else %>
    <h2 class="visually-hidden"><%= t("duels.board.hand") %></h2>
    <ul class="duel-hand__cards">
      <% screen.hand.each do |card| %>
        <li class="duel-hand__card" data-card="<%= screen.position(card) %>">
          <%= render "duels/face", screen: screen, card: card %>
          <span class="visually-hidden"><%= duel_card_name(screen, card) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
