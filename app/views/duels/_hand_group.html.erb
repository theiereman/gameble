<%# locals: (screen:) %>
<fieldset class="duel-group duel-group--hand">
  <legend class="duel-group__legend"><%= t("duels.board.hand") %></legend>
  <div class="duel-hand__cards">
    <% screen.hand.each do |card| %>
      <label class="duel-hand__card" data-card="<%= screen.position(card) %>">
        <%= radio_button_tag :card, screen.position(card), false, id: nil, class: "duel-radio", data: { action: "change->duel#choose" } %>
        <%= render "duels/face", screen: screen, card: card %>
        <span class="visually-hidden"><%= duel_card_name(screen, card) %></span>
      </label>
    <% end %>
  </div>
</fieldset>
