<%# locals: (decks:) %>
<fieldset class="duel-lobby__choice">
  <legend class="duel-lobby__legend"><%= t("duels.lobby.deck") %></legend>
  <% decks.each_with_index do |deck, index| %>
    <label class="duel-lobby__option">
      <%= radio_button_tag :deck, deck.token, index.zero?, id: nil %>
      <span><%= deck.name %></span>
    </label>
  <% end %>
</fieldset>
