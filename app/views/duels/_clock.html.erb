<%# locals: (name:, deadline:, server_time:) %>
<% seconds = [ (deadline - server_time).ceil, 0 ].max %>
<%= tag.p class: "duel-clock", data: { controller: "duel-clock", duel_clock_deadline_value: deadline.utc.iso8601(3),
      duel_clock_server_time_value: server_time.utc.iso8601(3), duel_clock_template_value: t("duels.clock.seconds", seconds: "{seconds}"),
      duel_clock_spoken_value: t("duels.clock.spoken", seconds: "{seconds}"), duel_clock_warning_value: t("duels.clock.warning") } do %>
  <span class="duel-clock__name"><%= name %></span>
  <span class="duel-clock__time" aria-hidden="true" data-duel-clock-target="text"><%= t("duels.clock.seconds", seconds:) %></span>
  <span class="visually-hidden" data-duel-clock-target="spoken"><%= t("duels.clock.spoken", seconds:) %></span>
  <span class="visually-hidden" role="status" aria-live="polite" data-duel-clock-target="status"></span>
<% end %>
