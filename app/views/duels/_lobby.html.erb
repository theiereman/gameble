<%# locals: (lobby:, sheet:) %>
<%= render PanelComponent.new(tag: :section, class: "duel-lobby", aria: { label: t("duels.sheet.title") }) do %>
  <% if (seated = lobby.seated) %>
    <div id="duel-seated" class="duel-lobby__block">
      <% if seated.active %>
        <p class="duel-lobby__line"><%= t("duels.lobby.in_progress_html", name: duel_player_name(seated.opponent)) %></p>
        <%= render ButtonComponent.new(href: duel_path(token: seated.token), aria_label: t("duels.lobby.resume_label", name: duel_plain_name(seated.opponent))) do %><%= t("duels.lobby.resume") %><% end %>
      <% else %>
        <%= render "duels/waiting_line", seated: seated %>
      <% end %>
    </div>
  <% end %>
  <%= render ButtonComponent.new(opens: "duel-sheet") do %><%= t("duels.sheet.open") %><% end %>
  <% if sheet.practice_deck_token %>
    <%= form_with url: duel_practice_path, method: :post, authenticity_token: false, class: "duel-lobby__practice" do %>
      <%= hidden_field_tag :deck, sheet.practice_deck_token, id: nil %>
      <%= render ButtonComponent.new(type: :submit, variant: :secondary) do %><%= t("duels.lobby.practice") %><% end %>
      <p class="duel-lobby__line duel-lobby__line--muted"><%= t("duels.lobby.practice_hint") %></p>
    <% end %>
  <% end %>
<% end %>
