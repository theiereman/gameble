<%# locals: (screen:) %>
<%= form_with url: duel_calls_path(token: screen.token), method: :post, id: "duel-call", class: "duel-form duel-table__slots", authenticity_token: false,
      data: { mirrored: (true unless screen.caller_side?), duel_target: "form", duel_kind: "call", duel_sending: t("duels.board.sending"),
        action: "click->duel#press keydown->duel#keydown keyup->duel#keyup turbo:fetch-request-error->duel#failed turbo:submit-end->duel#ended" } do %>
  <%= hidden_field_tag :move_number, screen.move_number, id: nil %>
  <%= hidden_field_tag :resent, 0, id: nil %>
  <%= hidden_field_tag :stat, nil, id: nil %>
  <%= hidden_field_tag :direction, nil, id: nil %>
  <%= yield %>
  <%= render ButtonComponent.new(type: :submit, aria_disabled: true) do %><%= t("duels.board.call") %><% end %>
<% end %>
