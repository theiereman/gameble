<% content_for :back_button, true %>
<section class="pack-result" aria-labelledby="pack-result-heading">
  <h1 id="pack-result-heading"><%= @pack.bonus? ? t(".heading_bonus") : t(".heading") %></h1>
  <ol class="pack-result__cards" aria-label="<%= t(".cards") %>">
    <% @cards.each do |card| %>
      <% marks = goal_marks.goals_for(card.card_id) %>
      <li class="pack-result__card"><%= link_to_card_detail(card, strings: @strings, goals: marks) do %><%= render CardComponent.new(card:, size: :m, goals: marks.map(&:position)) %><% end %></li>
    <% end %>
  </ol>
  <% if @next_pack %>
    <div class="pack-end">
      <%= render ButtonComponent.new(href: booster_path) do %><%= t(".open_booster") %><% end %>
    </div>
  <% end %>
</section>
