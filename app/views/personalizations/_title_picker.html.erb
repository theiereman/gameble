<%# locals: (titles:, active:, chosen: nil) %>
<%= render "personalizations/section", id: "personalization-title", heading: t("personalizations.show.profile_title.heading"), why: t("personalizations.show.profile_title.intro"),
      count: t("personalizations.show.profile_title.count_html", count: titles.size), scope: :public do %>
  <%= form_with url: personalization_title_path, method: :patch, class: "title-picker", data: { controller: "change-submit", action: "change->change-submit#submit" } do %>
    <%= select_tag "title", profile_title_options(titles, active, t("personalizations.show.profile_title.none")),
          class: "title-picker__select", autofocus: chosen.present?, aria: { labelledby: "personalization-title-heading" } %>
    <% if titles.empty? %>
      <p class="personalization-section__empty"><%= t("personalizations.show.profile_title.empty") %></p>
    <% end %>
    <noscript><%= button_tag t("personalizations.show.profile_title.apply"), type: :submit, class: "button button--secondary button--small" %></noscript>
  <% end %>
<% end %>
