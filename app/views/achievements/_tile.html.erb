<%# locals: (tile:) %>
<li class="<%= class_names("achievement", "achievement--locked": !tile.earned) %>">
  <span class="achievement__icon"><%= achievement_icon(tile) %></span>
  <div class="achievement__text">
    <h3 class="achievement__name"><%= t("achievements.names.#{tile.key}") %></h3>
    <p class="achievement__condition"><%= t("achievements.conditions.#{tile.key}") %></p>
  </div>
  <% back_reward = achievement_back_reward(tile) %>
  <% counting = !tile.earned && tile.countable? %>
  <% if back_reward || counting || tile.claimable %>
  <div class="achievement__side">
    <%= back_reward %>
    <% if tile.claimable %>
      <%= button_to t("achievements.claim.button"), claim_achievement_path(tile.key), class: "button button--primary button--small achievement__claim",
            form: { class: "achievement__claim-form" }, aria: { label: t("achievements.claim.label", name: t("achievements.names.#{tile.key}")) } %>
    <% end %>
    <% if counting %>
      <div class="achievement__count" aria-hidden="true">
        <progress class="achievement__bar" value="<%= tile.progress %>" max="<%= tile.threshold %>"></progress>
        <p class="achievement__progress"><%= number_with_delimiter(tile.progress) %> / <%= number_with_delimiter(tile.threshold) %></p>
      </div>
      <p class="visually-hidden"><%= t("achievements.show.progress", progress: number_with_delimiter(tile.progress), threshold: number_with_delimiter(tile.threshold)) %></p>
    <% end %>
  </div>
  <% end %>
</li>
