<%# locals: (tile:) %>
<li class="<%= class_names("achievement", "achievement--locked": !tile.earned && !tile.ready, "achievement--ready": tile.ready) %>">
  <span class="achievement__icon"><%= achievement_icon(tile) %></span>
  <div class="achievement__text">
    <h3 class="achievement__name"><%= t("achievements.names.#{tile.key}") %></h3>
    <p class="achievement__condition"><%= t("achievements.conditions.#{tile.key}") %></p>
    <%= achievement_back_reward(tile) %>
    <% if tile.ready %>
      <%= button_to t("achievements.show.collect"), collect_achievement_path(key: tile.key), class: "button button--primary button--small achievement__collect",
            form_class: "achievement__collect-form", form: { data: { turbo: false } },
            aria: { label: t("achievements.show.collect_label", name: t("achievements.names.#{tile.key}")) } %>
    <% elsif !tile.earned && tile.countable? %>
      <progress class="achievement__bar" value="<%= tile.progress %>" max="<%= tile.threshold %>" aria-hidden="true"></progress>
      <p class="achievement__progress" aria-hidden="true"><%= number_with_delimiter(tile.progress) %> / <%= number_with_delimiter(tile.threshold) %></p>
      <p class="visually-hidden"><%= t("achievements.show.progress", progress: number_with_delimiter(tile.progress), threshold: number_with_delimiter(tile.threshold)) %></p>
    <% end %>
  </div>
</li>
