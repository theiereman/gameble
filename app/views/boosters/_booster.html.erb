<%# locals: (bank:, season:, next_pack_sizes:, opened_pack:, opened_cards:, reserve:, held:, opened_first_copies: [], opened_goals: GoalMarks::NONE, next_steps: nil) %>
<% next_size = next_pack_sizes[reserve] || Game::Pack::SIZE %>
<% size = opened_cards&.size || next_size %>
<%= tag.section id: "booster", class: "booster", aria: { labelledby: "booster-panel-title" }, data: booster_root_data(bank:, season:, next_pack_sizes:, reserve:, held:) do %>
  <%= render("boosters/strip", season:, bank:) %>
  <%= render("boosters/reserves", bank:, reserve:) %>
  <%= render("boosters/daily", bank:) if bank[:bonus_collectable] && !hotwire_native_app? %>
  <%= render("boosters/info", season:, bank:, size:, reserve:) %>
  <%= render("boosters/stage", season:, available: booster_reserve_size(bank, reserve), reserve:, origin: booster_origin(bank, reserve), next_size:) %>
  <div class="booster__phone-actions" data-booster-target="phoneActions"></div>
  <%= render "boosters/next_steps", bank:, next_steps: %>
  <%= render("boosters/zoom", season:) %>
  <div class="visually-hidden" role="status" aria-live="polite" data-booster-target="live"></div>
  <template data-booster-target="announcement"><span></span></template>
  <% booster_rarities.each do |rarity| %>
    <%= tag.template rarity[:icon], data: { booster_target: "rarity", tier: rarity[:code], name: rarity[:name], label: rarity[:label] } %>
  <% end %>
  <% if opened_pack %>
    <%= render "boosters/opened", pack: opened_pack, cards: opened_cards, first_copies: opened_first_copies, goals: opened_goals %>
  <% end %>
<% end %>
