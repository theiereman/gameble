<% content_for :back_button, true %>
<% content_for :screen_title, t(".title") %>
<% content_for :title, t(".title") %>
<% content_for :booster_top_bar, true %>
<% turbo_exempts_page_from_cache %>
<h1 class="visually-hidden"><%= t(".title") %></h1>
<%= render "boosters/booster", bank: @bank, season: @season, next_pack_size: @next_pack_size, opened_pack: @opened_pack, opened_cards: @opened_cards %>
<div class="booster__fallback">
  <% if @bank[:available].positive? %>
    <%= render ButtonComponent.new(href: packs_path, method: :post) do %><%= t("booster.open") %><% end %>
  <% end %>
  <%= render ButtonComponent.new(variant: :secondary, href: home_path) do %><%= t("booster.back") %><% end %>
</div>
