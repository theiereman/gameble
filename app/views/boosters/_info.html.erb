<%# locals: (season:, bank:, size:, reserve:) %>
<% available = booster_reserve_size(bank, reserve) %>
<% origin = booster_origin(bank, reserve) %>
<aside class="booster__info" data-controller="booster-info">
  <div class="booster__id">
    <p class="booster__kicker"><%= booster_kicker(season, size) %></p>
    <h2 id="booster-panel-title" class="booster__title"><%= season_title(season) %></h2>
  </div>
  <div class="booster__reserve">
    <p class="booster__figure">
      <span class="booster__count" data-booster-info-target="count"><%= number_with_delimiter(available) %></span>
      <span class="booster__unit" data-booster-info-target="reserve"><%= booster_reserve_unit(available) %></span>
    </p>
    <p class="booster__source"<%= " hidden" unless origin %>>
      <span class="booster__source-label"><%= t("booster.origin_label") %></span>
      <span class="booster__source-name" data-booster-info-target="origin"><%= origin %></span>
    </p>
    <p class="booster__reserve-head">
      <%= render "boosters/next", full_class: "booster__next booster__next--full", next_class: "booster__next" %>
    </p>
    <div class="booster__pips" aria-hidden="true"><%= booster_pips([ bank[:available], BoostersHelper::RESERVE_PIPS ].min) %></div>
  </div>
  <div class="booster__actions" data-booster-target="panelActions">
    <%= render "boosters/actions" %>
  </div>
  <%= render "boosters/celebration", phone: false %>
</aside>
