<%# locals: (repost:, market:) %>
<template data-booster-stage-target="card">
  <li class="booster-card">
    <div class="booster-card__frame">
      <div class="booster-card__travel">
        <div class="booster-card__float">
          <div class="booster-card__hover">
            <div class="booster-card__lift">
              <span class="booster-card__aura" aria-hidden="true"></span>
              <span class="booster-card__glow" aria-hidden="true"></span>
              <span class="card-rays booster-card__rays" aria-hidden="true"></span>
              <div class="booster-card__flip">
                <div class="booster-card__back" aria-hidden="true"></div>
                <div class="booster-card__front" aria-hidden="true"></div>
                <div class="booster-card__marks" aria-hidden="true"><span class="booster-card__new"><%= t("booster.first_copy") %></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="booster-card__fx" aria-hidden="true"></div>
      <button type="button" class="booster-card__hit"></button>
    </div>
    <div class="booster-card__badges">
      <% if repost %>
        <button type="button" class="booster-card__action booster-card__repost" data-tip="<%= t("booster.repost_tip") %>"><%= pixel_icon("repost", class: "booster-card__action-icon") %></button>
      <% end %>
      <% if market %>
        <button type="button" class="booster-card__action booster-card__entrust" data-market="entrust" data-tip="<%= t("booster.entrust_tip") %>"><%= pixel_icon("entrust", class: "booster-card__action-icon") %></button>
        <button type="button" class="booster-card__action booster-card__sell" data-market="sell" data-tip="<%= t("booster.sell_tip") %>"><%= pixel_icon("sell", class: "booster-card__action-icon") %></button>
      <% end %>
    </div>
  </li>
</template>
