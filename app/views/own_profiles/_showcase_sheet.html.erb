<%# locals: (cards:, removed: nil) %>
<% focus = removed if removed.is_a?(Hash) %>
<% focused_card = cards.find { it.id == focus["slug"] && it.season_number.to_s == focus["number"].to_s } if focus %>
<%= render BottomSheetComponent.new(id: "me-showcase-sheet", title: t("personalizations.show.showcase.title"), open: focus.present?) do %>
  <div class="me-sheet">
    <p class="me-sheet__intro"><%= t("personalizations.show.showcase.why") %></p>
    <% if cards.any? %>
      <ul class="me-showcase-rows">
        <% cards.each do |card| %>
          <li class="me-showcase-row">
            <span class="me-showcase-row__face" aria-hidden="true"><%= render CardComponent.new(card:, size: :s) %></span>
            <span class="me-showcase-row__title"><%= card.title %></span>
            <%= button_to card_showcase_path(slug: card.id, number: card.season_number), method: :delete,
                  class: "button button--secondary button--small me-showcase-row__remove", form_class: "me-showcase-row__form",
                  aria: { label: t("public_profiles.show.showcase.remove", title: card.title) }, autofocus: card == focused_card do %>
              <%= pixel_icon("close", class: "button__icon") %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="me-sheet__note"><%= t("personalizations.show.showcase.empty") %></p>
    <% end %>
    <p class="me-sheet__note"><%= t("own_profiles.show.add_hint", add: t("showcases.add")) %></p>
    <%= link_to t("own_profiles.show.card_list"), library_cards_path, class: "button button--secondary button--small me-sheet__link",
          autofocus: focus.present? && focused_card.nil? %>
  </div>
<% end %>
