<%# locals: (shelf:, chosen: nil) %>
<% unlocked = shelf.count { !it.locked? } %>
<%= render BottomSheetComponent.new(id: "me-back-sheet", title: t("personalizations.show.card_back.heading"), open: chosen.present?) do %>
  <div class="me-sheet">
    <p class="me-sheet__intro"><%= t("personalizations.show.card_back.intro") %></p>
    <p class="me-sheet__count"><%= personalization_fraction(unlocked, shelf.size, suffix: t("personalizations.show.card_back.unlocked", count: unlocked)) %></p>
    <%= render "personalizations/back_picker", shelf:, chosen: %>
  </div>
<% end %>
