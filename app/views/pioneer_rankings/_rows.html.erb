<%# locals: (rows:, viewer:, anchored: true) %>
<% rows.each do |row| %>
  <% mine = viewer.present? && row.player == viewer %>
  <% anchor = mine && anchored ? { id: "pioneer-ranking-me", tabindex: -1, data: { pioneer_ranking_target: "mine" } } : {} %>
  <%= tag.li class: class_names("pioneer-row", "pioneer-row--mine": mine), **anchor do %>
    <span class="pioneer-row__rank"><%= pioneer_rank(row.rank) %></span>
    <span class="pioneer-row__who">
      <%= render PlayerNameComponent.new(player: row.player, viewer:, friends: @friends) %>
      <% if mine %><span class="pioneer-row__you"><%= t("pioneer_rankings.you") %></span><% end %>
    </span>
    <span class="pioneer-row__count">
      <span aria-hidden="true"><%= number_with_delimiter(row.count) %></span>
      <span class="visually-hidden"><%= t("pioneer_rankings.discoveries", count: row.count) %></span>
    </span>
  <% end %>
<% end %>
