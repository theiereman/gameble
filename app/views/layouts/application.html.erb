<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# The shell (AD-28; DESIGN.md, Chrome): atmosphere under everything, the
      top bar, the page, the phone tab bar, the toasts and, for a visitor,
      the sign-in panel. The back-office keeps the tokens and the top bar
      only. %>
  <body class="<%= "is-back-office" if back_office_page? %>">
    <%= render "shell/atmosphere" unless back_office_page? %>
    <%= render "shell/top_bar" %>
    <%= yield :ticker if content_for?(:ticker) %>

    <main id="main" class="main">
      <%= yield %>
    </main>

    <%= render "shell/tab_bar" unless back_office_page? %>
    <%= render "shell/toasts" %>
    <%= render "shell/sign_in_panel" unless current_player || back_office_page? %>
  </body>
</html>
