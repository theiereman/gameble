<!DOCTYPE html>
<%# data-motion is the one switch for reduced motion: CSS, Stimulus, the
    islands and View Transitions read it (motion.ts; AD-27). %>
<html lang="<%= I18n.locale %>"<% if motion_reduced? %> data-motion="reduced"<% end %>>
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# The shell (AD-28; DESIGN.md, Chrome): atmosphere under everything, the
      top bar, the page, the phone tab bar, the toasts and, for a visitor,
      the sign-in panel. The back-office keeps the tokens and the top bar
      only. The public card page (`content_for :public_page`) has the slim
      top bar and no tab bar. %>
  <body class="<%= class_names("is-back-office": back_office_page?, "is-public-page": content_for?(:public_page)) %>">
    <%= render "shell/atmosphere" unless back_office_page? %>
    <%= render "shell/top_bar" %>
    <%= yield :ticker if content_for?(:ticker) %>

    <main id="main" class="main">
      <%= yield %>
    </main>

    <%= render "shell/tab_bar" unless back_office_page? || content_for?(:public_page) %>
    <%= render "shell/toasts" %>
    <%= render "shell/sign_in_panel" unless current_player || back_office_page? %>
    <%= player_stream_tag %>
  </body>
</html>
