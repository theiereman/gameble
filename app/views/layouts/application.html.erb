<!DOCTYPE html>
<html lang="<%= I18n.locale %>"<% if forced_motion %> data-motion="<%= forced_motion %>"<% end %>>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body class="<%= class_names("is-back-office": back_office_page?, "is-public-page": content_for?(:public_page)) %>">
    <%= render "shell/atmosphere" unless back_office_page? %>
    <%= render "shell/top_bar" %>

    <main id="main" class="main">
      <%= yield %>
    </main>
    <%= yield :page_aside if content_for?(:page_aside) %>
    <%= yield :page_footer if content_for?(:page_footer) %>
    <%= yield :ticker if content_for?(:ticker) %>

    <%= render "shell/tab_bar" unless back_office_page? || content_for?(:public_page) %>
    <%= render "shell/toasts" %>
    <%= render "shell/version" %>
    <%= player_stream_tag %>
  </body>
</html>
