<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t(".title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t(".application_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_typescript_tag "application" %>
  </head>

  <body>
    <header class="status-band" aria-label="<%= t(".status_band.label") %>">
      <% if content_for?(:back_button) %>
        <%= render ButtonComponent.new(variant: :secondary, href: home_path) do %><%= t(".status_band.back") %><% end %>
      <% end %>
      <section class="status-band__gauge" aria-label="<%= t(".status_band.gauge") %>"></section>
      <section class="status-band__counters" aria-label="<%= t(".status_band.counters") %>">
        <% if policy([ :back_office, :dashboard ]).show? && !current_page?(back_office_path) %>
          <%= render ButtonComponent.new(variant: :secondary, href: back_office_path) do %><%= t(".status_band.back_office") %><% end %>
        <% end %>
        <% if current_player %>
          <%= render ButtonComponent.new(variant: :secondary, href: session_path, method: :delete) do %><%= t(".status_band.sign_out") %><% end %>
        <% else %>
          <%= render ButtonComponent.new(variant: :primary, href: "/auth/steam", method: :post, params: { origin: request.path }, turbo: false) do %><%= t(".status_band.sign_in") %><% end %>
        <% end %>
      </section>
    </header>

    <% if flash.any? %>
      <div class="flash" role="status">
        <% flash.each do |type, message| %>
          <p class="flash__message flash__message--<%= type %>"><%= message %></p>
        <% end %>
      </div>
    <% end %>

    <main class="main">
      <%= yield %>
    </main>
  </body>
</html>
