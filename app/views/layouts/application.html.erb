<!DOCTYPE html>
<%# data-motion is the one switch over the system's motion preference:
    "reduced" or "full" overrides it, no attribute follows it. CSS,
    Stimulus, the islands and View Transitions read it (motion.ts). %>
<html lang="<%= I18n.locale %>"<% if forced_motion %> data-motion="<%= forced_motion %>"<% end %>>
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# The shell: atmosphere under everything, the top bar, the page, the
      LIVE ticker along its bottom (the hub only), the phone tab bar, the
      toasts, the deployed version in the bottom-left corner and, for a
      visitor, the sign-in panel. The back-office keeps the tokens and the
      top bar only. The public card page (`content_for :public_page`) has
      the slim top bar and no tab bar. %>
  <body class="<%= class_names("is-back-office": back_office_page?, "is-public-page": content_for?(:public_page)) %>">
    <%= render "shell/atmosphere" unless back_office_page? %>
    <%= render "shell/top_bar" %>

    <main id="main" class="main">
      <%= yield %>
    </main>
    <%= yield :ticker if content_for?(:ticker) %>

    <%= render "shell/tab_bar" unless back_office_page? || content_for?(:public_page) %>
    <%= render "shell/toasts" %>
    <%= render "shell/version" %>
    <%= render "shell/sign_in_panel" unless current_player || back_office_page? %>
    <%= player_stream_tag %>
  </body>
</html>
