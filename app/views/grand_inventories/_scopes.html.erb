<%# locals: (inventory:, view:) %>
<%= form_with url: grand_inventory_path, method: :get, class: "grand-inventory__scopes",
  data: { turbo_frame: "grand-inventory", turbo_action: "advance", action: "submit->grand-inventory#scope" } do %>
  <%= hidden_field_tag :view, view, id: nil, disabled: view == GrandInventoriesController::VIEWS.first, data: { grand_inventory_target: "viewField" } %>
  <div class="grand-inventory__chips" role="group" aria-label="<%= t("grand_inventories.show.scopes.label") %>">
    <% Game::GrandInventory::SCOPES.each do |scope| %>
      <%= button_tag t("grand_inventories.show.scopes.#{scope}"), type: :submit, name: ("seasons" if scope == :current), value: ("current" if scope == :current),
        class: "grand-inventory__chip", aria: { pressed: inventory.scope == scope }, data: { grand_inventory_target: "chip" } %>
    <% end %>
  </div>
<% end %>
<p class="visually-hidden" role="status" data-grand-inventory-target="status"></p>
