<% if Game::Visibility.open_to_friends?(friend) %>
  <%= link_to brother_collection_path(token: friend.token), class: "button button--small friend-profile__view friends__collection-link",
        aria: { label: t("friends.collection_link.named", name: friend_name(friend)) } do %>
    <span class="button__label"><%= t("friends.collection_link.label") %></span>
  <% end %>
<% end %>
