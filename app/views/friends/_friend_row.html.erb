<%# locals: (friend:, supporters:) %>
<% player = friend.player %>
<% name = friend_name(player) %>
<li class="friends__row friends__friend">
  <span class="friends__who-row">
    <%= tag.button name, type: :button, class: "friends__name", **dialog_opener_attributes(friend_dialog_id(player.token), label: t(".see_profile_of", name:)) %>
    <% if supporters.include?(player.id) && Accounts::PersonaName.clean(player.persona_name) %><%= supporter_badge_tag(compact: true) %><% end %>
  </span>
  <%= render "friends/presence", presence: friend %>
  <div class="friends__trade">
    <% if (refusal = trades_refusal(player)) %>
      <%= trades_closed_line(refusal, player) %>
    <% else %>
      <%= render ButtonComponent.new(variant: :secondary, size: :small,
            href: new_trade_path(friend: player.token),
            aria_label: t(".trade_with", name:)) do %><%= t(".trade") %><% end %>
    <% end %>
    <%= render "duels/challenge_button", friend: player %>
    <% if Game::Visibility.open_to_friends?(player) %>
      <%= render ButtonComponent.new(variant: :secondary, size: :small, href: brother_collection_path(token: player.token),
            aria_label: t(".collection_of", name:)) do %><%= t(".collection") %><% end %>
    <% end %>
  </div>
  <%= render "friends/more_actions", player:, menu_id: friend_actions_menu_id(player.token), remove_dialog_id: remove_friend_dialog_id(player.token),
        report_dialog_id: (friend_report_dialog_id(player.token) unless Game::Visibility.open_to_friends?(player)) %>
</li>
