<% if Game::Visibility.shown_to_a_friend?(friend) %>
  <%= link_to brother_path(token: friend.token), class: "button button--secondary button--small friends__profile-link",
        aria: { label: t("friends.public_profile.named", name: friend_name(friend)) } do %>
    <span class="button__label"><%= t("friends.public_profile.label") %></span>
  <% end %>
<% end %>
