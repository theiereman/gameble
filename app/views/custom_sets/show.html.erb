<% content_for :back_button, true %>
<% content_for :phone_previous, true %>
<% content_for :screen_title, t("library.collection.title") %>
<% content_for :title, t("library.album.title", set: @custom_set.name) %>
<% content_for :top_bar_status do %><%= render "library/status", unique: @unique, total: @season_cards %><% end %>
<% actions = capture do %>
  <% if @custom_set.custom? %>
    <%= render ButtonComponent.new(variant: :secondary, size: :small, href: edit_custom_set_path(token: @custom_set.token)) do %><%= t("custom_sets.album.edit") %><% end %>
    <%= render ButtonComponent.new(variant: :danger, size: :small, href: custom_set_path(token: @custom_set.token), method: :delete,
      confirm: t("custom_sets.album.delete_confirm", name: @custom_set.name)) do %><%= t("custom_sets.album.delete") %><% end %>
  <% end %>
<% end %>
<%= render "library/album", standing: @standing, heading: @custom_set.name, slots: @album_slots, pagy: @album_pagy, filters: @album_filters,
  context: {}, actions: actions.presence %>
