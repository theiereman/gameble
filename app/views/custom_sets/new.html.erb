<% content_for :back_button, true %>
<% content_for :screen_title, t("library.collection.title") %>
<% content_for :title, t("custom_sets.new.title") %>
<section class="custom-set-form" aria-labelledby="custom-set-form-title">
  <%= render PanelComponent.new(brackets: true) do %>
    <h1 id="custom-set-form-title" class="custom-set-form__title"><%= t("custom_sets.new.heading") %></h1>
    <%= render "custom_sets/picker", name: @name, query: @query, picked: @picked, found: @found, refusal: @refusal %>
  <% end %>
</section>
