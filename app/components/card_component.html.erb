<span class="<%= classes %>"<% if owned %> data-controller="tilt" data-tilt-max-value="<%= tilt_max %>"<% end %>>
  <span class="card__body">
    <span class="card__band">
      <span class="card__title"><%= card.title %></span>
      <% if publisher? %>
        <span class="card__publisher"><%= card.publisher %></span>
      <% end %>
    </span>
    <span class="card__art" data-controller="card-art" data-card-art-url-value="<%= card.image_url %>" data-card-art-width-value="<%= art[:width] %>" data-card-art-height-value="<%= art[:height] %>" data-card-art-palette-width-value="<%= PALETTE[:width] %>" data-card-art-palette-height-value="<%= PALETTE[:height] %>"<% if fluid? %> data-card-art-fluid-value="true"<% end %>>
      <canvas class="card__canvas" width="<%= art[:width] %>" height="<%= art[:height] %>" aria-hidden="true" data-card-art-target="canvas"></canvas>
      <span class="card__missing">
        <%= helpers.pixel_icon("picture", class: "card__missing-icon") %>
        <span class="card__missing-text"><%= t("cards.face.image_missing") %></span>
      </span>
    </span>
    <span class="card__line">
      <% if genre %>
        <span class="card__genre"><%= genre %></span>
      <% end %>
      <span class="card__year"><%= card.year %></span>
    </span>
    <span class="card__line card__line--rarity">
      <%= rarity_icon %>
      <span class="card__rarity"><%= rarity_name %></span>
      <% if card.number %>
        <span class="card__number"><%= number_label %></span>
      <% end %>
    </span>
  </span>
  <% if owned %>
    <span class="card__effects" aria-hidden="true">
      <span class="card__reflection card__reflection--ceiling"></span>
      <% if iridescent? %>
        <span class="card__reflection card__reflection--iridescence"></span>
      <% end %>
      <span class="card__reflection card__reflection--strips"></span>
      <% if iridescent? %>
        <span class="card__glitter" data-tilt-target="glitter" data-glitter-seed="<%= glitter_seed %>"></span>
      <% end %>
    </span>
  <% else %>
    <span class="card__lock"><%= helpers.pixel_icon("lock") %></span>
  <% end %>
</span>
