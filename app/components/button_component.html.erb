<% if @href && @method %><%= button_to @href, method: @method, params: @params, class: classes, form_class: "button-form", form: form_options do %><%= content %><% end %><% elsif @href %><%= link_to content, @href, class: classes %><% else %><%= tag.button content, type: @type, class: classes %><% end %>
