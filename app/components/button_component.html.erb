<% if @disabled %><%= tag.button label, type: :button, class: classes, disabled: true %><% elsif @href && @method %><%= button_to @href, method: @method, params: @params, class: classes, form_class: "button-form", form: form_options do %><%= label %><% end %><% elsif @href %><%= link_to label, @href, class: classes, **form_options %><% elsif @opens %><%= tag.button label, type: :button, class: classes, **opener_options %><% else %><%= tag.button label, type: @type, class: classes %><% end %>
