# Every environment variable gameble reads. None is needed in development: the
# defaults match compose.yaml, so each line below is commented out. Copy a line
# you need to your shell or to the Kamal destination files; never commit a real
# value, a key or a password.

# --- Database ---
# PostgreSQL host, port, user and password in development and test.
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=postgres
# One URL replacing the four above, for a throwaway database (parallel test runs).
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/gameble_test_example
# Template for a database URL in config/database.yml; unused unless you uncomment its block.
# MY_APP_DATABASE_URL=postgres://user:password@localhost:5432/app
# Production database password, passed as a Kamal secret.
# GAMEBLE_DATABASE_PASSWORD=change-me

# --- Web and jobs ---
# Port Rails listens on.
# PORT=3000
# Threads per Puma process; also sizes the database connection pool.
# RAILS_MAX_THREADS=5
# Puma worker processes.
# WEB_CONCURRENCY=2
# Job worker processes of bin/jobs.
# JOB_CONCURRENCY=1
# Run the job queue inside Puma (single-server deployments).
# SOLID_QUEUE_IN_PUMA=true
# Queue configuration file other than config/queue.yml.
# SOLID_QUEUE_CONFIG=config/queue.yml
# Recurring jobs schedule file other than the default.
# SOLID_QUEUE_RECURRING_SCHEDULE=config/recurring.yml
# Do not start the recurring jobs in this process.
# SOLID_QUEUE_SKIP_RECURRING=true
# Path of the Puma pid file.
# PIDFILE=tmp/pids/server.pid
# Log level: debug, info, warn, error.
# RAILS_LOG_LEVEL=info
# Path of the Gemfile bundler loads; set by tooling, rarely by hand.
# BUNDLE_GEMFILE=Gemfile

# --- Public site ---
# Public base of shared links: https://host, no path. Required in production.
# PUBLIC_URL=http://localhost:3000
# Set to "on" to let search engines index the site; unset keeps it out of their results.
# SEARCH_INDEXING=on
# Name of the release shown in the page footer and sent to Sentry; set by Kamal.
# GAMEBLE_VERSION=dev
# KAMAL_VERSION=0000000

# --- Legal notice (required in production, defaulted elsewhere) ---
# LEGAL_CONTACT_EMAIL=contact@example.test
# LEGAL_HOST_NAME=Example Hosting
# LEGAL_HOST_ADDRESS=1 rue de l'Exemple, 75000 Paris

# --- Steam ---
# Steam Web API key for the catalog import. Outside production, config/steam_api.key works too.
# STEAM_API_KEY=your-steam-api-key

# --- Error reporting ---
# Sentry starts only when this is set.
# SENTRY_DSN=https://public@sentry.example.test/1
# Environment name Sentry shows; defaults to the Rails environment.
# SENTRY_ENVIRONMENT=staging

# --- Build ---
# Lets assets:precompile run without a real secret key; the Docker build sets it.
# SECRET_KEY_BASE_DUMMY=1
