<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gameble" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/steam_bar</item>
        <item name="colorSurface">@color/steam_bar</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>

    <!-- A sheet wears the web panel's colour and square corners. -->
    <style name="ThemeOverlay.Gameble.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:colorBackground">@color/panel</item>
        <item name="colorSurface">@color/panel</item>
        <item name="bottomSheetStyle">@style/Widget.Gameble.Sheet</item>
    </style>

    <style name="Widget.Gameble.Sheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/panel</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Gameble.Square</item>
    </style>

    <style name="ShapeAppearance.Gameble.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="TextAppearance.Gameble.TopBarBack" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="TextAppearance.Gameble.TopBarCount" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TextAppearance.Gameble.TopBarBadge" parent="">
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/on_alert</item>
        <item name="android:background">@color/alert</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">17dp</item>
        <item name="android:paddingHorizontal">3dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TextAppearance.Gameble.Tab" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:fontFamily">@font/jetbrains_mono_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
