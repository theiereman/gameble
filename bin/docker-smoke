#!/usr/bin/env bash
# Builds the production image without pushing it, boots a container from it and
# waits for /up to answer 200. Used by the docker-image CI job; runs locally too:
#   bin/docker-smoke
#
# The container gets throw-away values only, never a real secret: SECRET_KEY_BASE
# replaces RAILS_MASTER_KEY, PUBLIC_URL is required to boot in production. No
# database is needed: /up does not query one, and the entrypoint prepares the
# database only for `./bin/rails server` as its last two arguments, which the
# command below avoids.
set -euo pipefail
cd "$(dirname "$0")/.."

image="${IMAGE:-gameble-smoke}"
name="gameble-smoke-$$"
port="${PORT:-3000}"
timeout="${TIMEOUT:-60}"

docker build --tag "$image" .

cleanup() { docker rm --force "$name" > /dev/null 2>&1 || true; }
trap cleanup EXIT

docker run --detach --name "$name" --publish "127.0.0.1:$port:$port" \
  --env SECRET_KEY_BASE="$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')" \
  --env PUBLIC_URL=https://gameble.example \
  "$image" ./bin/rails server --binding 0.0.0.0 --port "$port" > /dev/null

for _ in $(seq "$timeout"); do
  status="$(curl --silent --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$port/up" || true)"
  if [ "$status" = "200" ]; then
    echo "/up answered 200"
    exit 0
  fi
  if [ "$(docker inspect --format '{{.State.Running}}' "$name")" != "true" ]; then
    break
  fi
  sleep 1
done

echo "/up did not answer 200 (last status: ${status:-none}); container logs:" >&2
docker logs "$name" >&2
exit 1
