# Secrets of the staging destination (bin/kamal deploy -d staging), read from
# the deploying machine's config/*.key files, never committed. This file
# holds no secret itself and is safe for git.

# A token allowed to read and write packages on ghcr.io, shared with production.
KAMAL_REGISTRY_PASSWORD=$(cat config/registry_password.key)

# The credentials file is shared with production; the secret that signs sessions
# and cookies is staging's own (bin/rails secret > config/secret_key_base.staging.key).
RAILS_MASTER_KEY=$(cat config/master.key)
SECRET_KEY_BASE=$(cat config/secret_key_base.staging.key)

# Sentry's DSN, shared with production: SENTRY_ENVIRONMENT tells their events apart.
SENTRY_DSN=$(cat config/sentry_dsn.key)

# Staging's own PostgreSQL password. The accessory's superuser and the app share it.
GAMEBLE_DATABASE_PASSWORD=$(cat config/database_password.staging.key)
POSTGRES_PASSWORD=$(cat config/database_password.staging.key)

# Steam Web API key of the import, shared with production (one daily quota for both).
STEAM_API_KEY=$(cat config/steam_api.key)

# Clerk secret key of this destination's instance (staging: development, production: production).
CLERK_SECRET_KEY=$(cat config/clerk_secret.key)
