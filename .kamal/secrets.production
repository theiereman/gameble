# Secrets of the production destination (bin/kamal deploy -d production), read
# from the deploying machine's config/*.key files, never committed. This file
# holds no secret itself and is safe for git.

# A token allowed to read and write packages on ghcr.io, shared with staging.
KAMAL_REGISTRY_PASSWORD=$(cat config/registry_password.key)

# The credentials file is shared with staging; the secret that signs sessions
# and cookies is production's own (bin/rails secret > config/secret_key_base.production.key).
RAILS_MASTER_KEY=$(cat config/master.key)
SECRET_KEY_BASE=$(cat config/secret_key_base.production.key)

# Sentry's DSN, shared with staging: SENTRY_ENVIRONMENT tells their events apart.
SENTRY_DSN=$(cat config/sentry_dsn.key)

# Production's own PostgreSQL password. The accessory's superuser and the app share it.
GAMEBLE_DATABASE_PASSWORD=$(cat config/database_password.production.key)
POSTGRES_PASSWORD=$(cat config/database_password.production.key)

# Steam Web API key of the import, shared with staging (one daily quota for both).
STEAM_API_KEY=$(cat config/steam_api.key)

# Clerk secret key of this destination's instance (staging: development, production: production).
CLERK_SECRET_KEY=$(cat config/clerk_secret.key)
